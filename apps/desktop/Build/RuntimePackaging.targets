<Project>
  <PropertyGroup>
    <KynxaOffline Condition="'$(KynxaOffline)' == ''">false</KynxaOffline>
    <KynxaRuntimeProfile Condition="'$(KynxaRuntimeProfile)' == ''">Full</KynxaRuntimeProfile>
    <_KynxaDownloadSourcesFullPath Condition="'$(KynxaDownloadSourcesPath)' != ''">$([System.IO.Path]::GetFullPath('$(KynxaDownloadSourcesPath)'))</_KynxaDownloadSourcesFullPath>
    <_KynxaResourcePackFullPath Condition="'$(KynxaResourcePackRoot)' != ''">$([System.IO.Path]::GetFullPath('$(KynxaResourcePackRoot)'))</_KynxaResourcePackFullPath>
    <_KynxaRuntimeOptions>-Profile &quot;$(KynxaRuntimeProfile)&quot;</_KynxaRuntimeOptions>
    <_KynxaRuntimeOptions Condition="'$(KynxaOffline)' == 'true'">$(_KynxaRuntimeOptions) -Offline</_KynxaRuntimeOptions>
    <_KynxaRuntimeOptions Condition="'$(KynxaDownloadSourcesPath)' != ''">$(_KynxaRuntimeOptions) -DownloadSourcesPath &quot;$(_KynxaDownloadSourcesFullPath)&quot;</_KynxaRuntimeOptions>
    <_KynxaRuntimeOptions Condition="'$(KynxaResourcePackRoot)' != ''">$(_KynxaRuntimeOptions) -ResourcePackRoot &quot;$(_KynxaResourcePackFullPath)&quot;</_KynxaRuntimeOptions>
    <_KynxaVisualCppOptions Condition="'$(KynxaOffline)' == 'true'">-Offline</_KynxaVisualCppOptions>
    <_KynxaVisualCppOptions Condition="'$(KynxaDownloadSourcesPath)' != ''">$(_KynxaVisualCppOptions) -DownloadSourcesPath &quot;$(_KynxaDownloadSourcesFullPath)&quot;</_KynxaVisualCppOptions>
    <_KynxaVisualCppOptions Condition="'$(KynxaResourcePackRoot)' != ''">$(_KynxaVisualCppOptions) -ResourcePackRoot &quot;$(_KynxaResourcePackFullPath)&quot;</_KynxaVisualCppOptions>
    <_KynxaToolHostTargets>Restore;Build</_KynxaToolHostTargets>
    <_KynxaUsageMonitorTargets>Restore;Publish</_KynxaUsageMonitorTargets>
    <!-- Offline builds consume an existing NuGet restore; they do not contact configured feeds.
         离线构建使用已有 NuGet 还原结果，不在 ToolHost 子构建中重新访问源。 -->
    <_KynxaToolHostTargets Condition="'$(KynxaOffline)' == 'true' or '$(KynxaDependenciesPrepared)' == 'true'">Build</_KynxaToolHostTargets>
    <_KynxaUsageMonitorTargets Condition="'$(KynxaOffline)' == 'true' or '$(KynxaDependenciesPrepared)' == 'true'">Publish</_KynxaUsageMonitorTargets>
    <_KynxaRuntimeOptions Condition="'$(KynxaRebuildNative)' == 'true'">$(_KynxaRuntimeOptions) -Rebuild</_KynxaRuntimeOptions>
  </PropertyGroup>
  <!-- VS deployment uses LayoutDir from the recipe; keep nested MCP paths below MAX_PATH.
       VS 按部署清单中的 LayoutDir 复制文件；缩短根目录，避免嵌套 MCP 路径超出限制。 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <_KynxaDefaultDeploymentDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\artifacts\development\appx\$(Platform)\$(Configuration)'))</_KynxaDefaultDeploymentDirectory>
    <_KynxaDefaultLayoutDirectory>$([MSBuild]::EnsureTrailingSlash('$(_KynxaDefaultDeploymentDirectory)'))</_KynxaDefaultLayoutDirectory>
    <!-- Match the SDK deployment path form; the CLI copy path separately needs a trailing separator.
         保持 SDK 部署目录形式；CLI 复制目录单独补齐末尾分隔符。 -->
    <LayoutDir Condition="'$(LayoutDir)' == ''">$(_KynxaDefaultDeploymentDirectory)</LayoutDir>
    <WinAppLooseLayoutPath Condition="'$(WinAppLooseLayoutPath)' == ''">$([MSBuild]::EnsureTrailingSlash('$(LayoutDir)'))</WinAppLooseLayoutPath>
  </PropertyGroup>
  <!-- Prepare pinned native files using PowerShell and Cargo on the build machine only.
       仅在构建机准备原生文件及固定 MCP 依赖；用户无需安装开发工具或系统 Node。 -->
  <Target Name="IncludeNativeGatewayRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_KynxaNativeCacheDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\artifacts\runtime\native-desktop\win-x64'))</_KynxaNativeCacheDirectory>
    </PropertyGroup>
    <!-- VS may send a BOM on redirected stdin; preparation scripts accept no pipeline input.
         VS 可能在重定向标准输入中发送 BOM；准备脚本不接收管道输入。 -->
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-native-runtime.ps1&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -Configuration &quot;$(Configuration)&quot; $(_KynxaRuntimeOptions) &lt; NUL" />
    <ReadLinesFromFile File="$(_KynxaNativeCacheDirectory)\bundle-files.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaNativeRuntimeFiles" />
    </ReadLinesFromFile>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.." Condition="'$(LayoutDir)' != ''"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\check-deployment-paths.ps1&quot; -LayoutDirectory &quot;$(LayoutDir)\.&quot; -PayloadRoot &quot;$(_KynxaNativeCacheDirectory)\.&quot; -FileList &quot;$(_KynxaNativeCacheDirectory)\bundle-files.txt&quot;" />
    <ItemGroup>
      <Content Include="@(_KynxaNativeRuntimeFiles)"
               Link="$([MSBuild]::MakeRelative('$(_KynxaNativeCacheDirectory)', '%(_KynxaNativeRuntimeFiles.Identity)'))"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeGatewayVisualCppRuntime" BeforeTargets="AssignTargetPaths" DependsOnTargets="IncludeNativeGatewayRuntime" Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_KynxaVisualCppCacheDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\artifacts\runtime\vc\win-x64'))</_KynxaVisualCppCacheDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-vc-runtime.ps1&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -CacheDirectory &quot;$(_KynxaVisualCppCacheDirectory)&quot; $(_KynxaVisualCppOptions)" />
    <ReadLinesFromFile File="$(_KynxaVisualCppCacheDirectory)\runtime-files.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaVisualCppFiles" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_KynxaVisualCppCacheDirectory)\runtime-notices.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaVisualCppNotices" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(_KynxaVisualCppFiles)" Link="runtime\native\%(_KynxaVisualCppFiles.Filename)%(_KynxaVisualCppFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(_KynxaVisualCppNotices)" Link="runtime\native\licenses\vc\%(_KynxaVisualCppNotices.Filename)%(_KynxaVisualCppNotices.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Design-time evaluation must not restore or build executable payloads.
       设计时求值不能还原或构建可执行载荷，避免阻塞 IDE 的项目元数据采集。 -->
  <Target Name="IncludeToolHostRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\tool-host\KYNXA.ToolHost.csproj" Targets="$(_KynxaToolHostTargets)" RemoveProperties="OutDir"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);Platform=AnyCPU;SelfContained=true" />
    <PropertyGroup>
      <_KynxaToolHostNoticesDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)toolhost-notices\$(RuntimeIdentifier)'))))</_KynxaToolHostNoticesDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-toolhost-notices.ps1&quot; -AssetsPath &quot;$(MSBuildProjectDirectory)\..\tool-host\obj\project.assets.json&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -OutputDirectory &quot;$(_KynxaToolHostNoticesDirectory)&quot;" />
    <ItemGroup>
      <_KynxaToolHostFiles Include="..\tool-host\bin\$(Configuration)\net10.0-windows10.0.19041.0\$(RuntimeIdentifier)\**\*"
          Exclude="..\tool-host\bin\$(Configuration)\net10.0-windows10.0.19041.0\$(RuntimeIdentifier)\**\*.pdb;..\tool-host\bin\$(Configuration)\net10.0-windows10.0.19041.0\$(RuntimeIdentifier)\**\*.tmp" />
      <Content Include="@(_KynxaToolHostFiles)"
               Link="ToolHost\%(_KynxaToolHostFiles.RecursiveDir)%(_KynxaToolHostFiles.Filename)%(_KynxaToolHostFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <_KynxaToolHostNotices Include="$(_KynxaToolHostNoticesDirectory)\**\*" />
      <Content Include="@(_KynxaToolHostNotices)"
               Link="ToolHost\licenses\%(_KynxaToolHostNotices.RecursiveDir)%(_KynxaToolHostNotices.Filename)%(_KynxaToolHostNotices.Extension)"
               CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeUsageMonitorRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_KynxaUsageMonitorPublishDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)usage-monitor-payload\$(Configuration)\$(RuntimeIdentifier)'))))</_KynxaUsageMonitorPublishDirectory>
    </PropertyGroup>
    <!-- The optional card is self-contained and shares the owner's usage projection; offline/prepared builds skip restore.
         可选悬浮卡以自包含方式随包提供并共享宿主统计；离线或依赖已准备的构建不重复还原。 -->
    <MSBuild Projects="..\usage-monitor\KYNXA.UsageMonitor.csproj" Targets="$(_KynxaUsageMonitorTargets)" RemoveProperties="OutDir"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);Platform=AnyCPU;SelfContained=true;PublishReadyToRun=false;PublishTrimmed=false;PublishDir=$(_KynxaUsageMonitorPublishDirectory)" />
    <ItemGroup>
      <_KynxaUsageMonitorFiles Include="$(_KynxaUsageMonitorPublishDirectory)\**\*"
                               Exclude="$(_KynxaUsageMonitorPublishDirectory)\**\*.pdb;$(_KynxaUsageMonitorPublishDirectory)\**\*.tmp" />
      <Content Include="@(_KynxaUsageMonitorFiles)"
               Link="UsageMonitor\%(_KynxaUsageMonitorFiles.RecursiveDir)%(_KynxaUsageMonitorFiles.Filename)%(_KynxaUsageMonitorFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeToolHostLibrariesFromWinUiPri" BeforeTargets="_GeneratePrisForPortableLibraries">
    <ItemGroup Condition="'@(_LibrariesUnfiltered)' == '' and '@(CreatedResWFiles)' == '' and '$(NetCoreGeneratePrisForPortableLibraries)' != 'true'">
      <_LibrariesUnfiltered Include="@(PackagingOutputs)" Exclude="@(_KynxaToolHostFiles);@(_KynxaToolHostFiles->'%(FullPath)')" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <ItemGroup>
      <_LibrariesUnfiltered Remove="@(_KynxaToolHostFiles);@(_KynxaToolHostFiles->'%(FullPath)')" />
      <!-- Native Rust/ONNX DLLs are not WinUI assemblies and must not be parsed by PRI.
           Rust/ONNX 原生运行库不是 WinUI 程序集，不能参与 PRI 可移植资源程序集提取。
      -->
      <_LibrariesUnfiltered Remove="@(_KynxaNativeRuntimeFiles);@(_KynxaNativeRuntimeFiles->'%(FullPath)')" />
      <_LibrariesUnfiltered Remove="@(_KynxaVisualCppFiles);@(_KynxaVisualCppFiles->'%(FullPath)')" />
      <_LibrariesUnfiltered Remove="@(_KynxaUsageMonitorFiles);@(_KynxaUsageMonitorFiles->'%(FullPath)')" />
    </ItemGroup>
  </Target>
  <Target Name="KeepExecutableRuntimePayloadsOutsideWinUiPri"
          AfterTargets="_GenerateProjectPriConfigurationFiles"
          BeforeTargets="_GenerateProjectPriFileCore"
          Condition="Exists('$(_FilteredLayoutResfilesPath)')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\filter-runtime-pri-layout.ps1&quot; -LayoutPath &quot;$(_FilteredLayoutResfilesPath)&quot; -ExcludedLayoutPath &quot;$(_ExcludedLayoutResfilesPath)&quot;" />
  </Target>
  <!-- WinUI copies compiled pages to bin, but its copy-local items do not enter the .NET publish list.
       Publish this build's generated pages and project PRI explicitly, retaining their resource paths.
       WinUI 将编译页面复制到 bin，但复制项不会自动进入 .NET 发布清单。
       显式发布本轮生成的页面和项目 PRI，保留资源相对路径，不从历史输出拼装。 -->
  <Target Name="IncludeUnpackagedWinUiPublishResources"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="Prep_ComputeProcessXamlFiles;_GenerateProjectPriFile"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(WindowsPackageType)' == 'None'">
    <AssignTargetPath Files="@(GeneratedXamlSrc->'%(FullPath)')" RootFolder="$(XamlGeneratedOutputPath)">
      <Output TaskParameter="AssignedFiles" ItemName="_KynxaPublishedXaml" />
    </AssignTargetPath>
    <Error Condition="'$(ProjectPriFullPath)' == '' or !Exists('$(ProjectPriFullPath)')"
           Text="The unpackaged desktop publish is missing its generated project PRI: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_KynxaPublishedXaml)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(_KynxaPublishedXaml.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="RemoveObsoleteBackendPayload" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)KYNXA.Desktop.dll')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\remove-obsolete-backend-payload.ps1&quot; -BundleRoot &quot;$(TargetDir).&quot;" />
  </Target>
  <!-- Run again after package layout steps that can recreate a stale immediate AppX payload.
       包布局阶段可能再次复制旧 AppX 载荷；构建结束后仅复查同一受控输出的精确旧文件。 -->
  <Target Name="RemoveObsoletePackagedBackendPayload" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)KYNXA.Desktop.dll')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\remove-obsolete-backend-payload.ps1&quot; -BundleRoot &quot;$(TargetDir).&quot;" />
  </Target>
  <Target Name="RemoveObsoleteLooseLayoutBackendPayload" AfterTargets="_WinAppCopyContentToLooseLayout" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)KYNXA.Desktop.dll')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\remove-obsolete-backend-payload.ps1&quot; -BundleRoot &quot;$(TargetDir).&quot;" />
  </Target>
  <!-- Copy/extraction inherits the destination ACL; prepare sandbox RX again in the actual executable layout.
       复制或解压会继承目标 ACL；在实际可执行布局中再次补齐浏览器沙箱的只读执行权限。 -->
  <Target Name="PrepareBrowserSandboxOutput" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(TargetDir)KYNXA.Desktop.dll')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-browser-sandbox.ps1&quot; -BundleRoot &quot;$(TargetDir).&quot;" />
  </Target>
  <Target Name="PrepareBrowserSandboxLooseLayout" AfterTargets="_WinAppCopyContentToLooseLayout" Condition="'$(DesignTimeBuild)' != 'true' and '$(WinAppLooseLayoutPath)' != '' and Exists('$(WinAppLooseLayoutPath)KYNXA.Desktop.dll')">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-browser-sandbox.ps1&quot; -BundleRoot &quot;$(WinAppLooseLayoutPath).&quot;" />
  </Target>
  <!-- Recheck only our default layout; explicit external layouts retain their ownership.
       仅复查默认受控布局；显式指定的外部布局不进入清理范围。 -->
  <Target Name="RemoveObsoleteDefaultDeploymentPayload" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_KynxaDefaultLayoutDirectory)' != '' and ('$(LayoutDir)' == '$(_KynxaDefaultDeploymentDirectory)' or '$(WinAppLooseLayoutPath)' == '$(_KynxaDefaultLayoutDirectory)') and Exists('$(_KynxaDefaultLayoutDirectory)KYNXA.Desktop.dll') and Exists('$(_KynxaDefaultLayoutDirectory)runtime\agent\kynxa-gateway.exe')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\remove-obsolete-backend-payload.ps1&quot; -BundleRoot &quot;$(_KynxaDefaultLayoutDirectory).&quot;" />
  </Target>
  <!-- A separate target runs after CLI copying even when Build already performed cleanup.
       CLI 复制后使用独立目标复查，避免同一次构建中目标只运行一次而漏掉后续载荷。 -->
  <Target Name="RemoveObsoleteDefaultLooseLayoutPayload" AfterTargets="_WinAppCopyContentToLooseLayout"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(_KynxaDefaultLayoutDirectory)' != '' and ('$(LayoutDir)' == '$(_KynxaDefaultDeploymentDirectory)' or '$(WinAppLooseLayoutPath)' == '$(_KynxaDefaultLayoutDirectory)') and Exists('$(_KynxaDefaultLayoutDirectory)KYNXA.Desktop.dll') and Exists('$(_KynxaDefaultLayoutDirectory)runtime\agent\kynxa-gateway.exe')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\remove-obsolete-backend-payload.ps1&quot; -BundleRoot &quot;$(_KynxaDefaultLayoutDirectory).&quot;" />
  </Target>
</Project>
