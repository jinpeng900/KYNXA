<Project>
  <Target Name="EnsureGatewayDependencies" BeforeTargets="PrepareForBuild"
          Inputs="..\model-gateway\package-lock.json" Outputs="..\model-gateway\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\model-gateway" Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="IncludeResourceServiceRuntime" BeforeTargets="AssignTargetPaths" DependsOnTargets="IncludeGatewayNodeRuntime">
    <!-- Package the prepared Rust executable and original notices only; developer toolchains never enter the payload.
         仅打包已准备的 Rust 可执行文件和许可证原文，开发工具链不进入用户安装包。 -->
    <PropertyGroup>
      <_KynxaResourceCacheDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\artifacts\runtime\resources\$(RuntimeIdentifier)'))</_KynxaResourceCacheDirectory>
      <_KynxaRequireResourceRuntime Condition="'$(Configuration)' == 'Release'">--required</_KynxaRequireResourceRuntime>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
          Command="&quot;$(_KynxaNodeRuntimeDirectory)\node.exe&quot; tools/development/prepare-resource-runtime.mjs --runtime &quot;$(RuntimeIdentifier)&quot; --cache &quot;$(_KynxaResourceCacheDirectory)&quot; $(_KynxaRequireResourceRuntime)" />
    <ReadLinesFromFile File="$(_KynxaResourceCacheDirectory)\bundle-files.txt" Condition="Exists('$(_KynxaResourceCacheDirectory)\bundle-files.txt')">
      <Output TaskParameter="Lines" ItemName="_KynxaResourceBundleFiles" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(_KynxaResourceBundleFiles->'$(_KynxaResourceCacheDirectory)\%(Identity)')"
               Link="runtime\resource\%(_KynxaResourceBundleFiles.Identity)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeGatewayNodeRuntime" BeforeTargets="AssignTargetPaths">
    <!-- Compose first, then normalize with the single-argument API shared by both MSBuild hosts.
         先组合路径，再用两种 MSBuild 宿主都支持的单参数 API 规范化。 -->
    <PropertyGroup>
      <_KynxaNodeCacheDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)node-runtime\$(RuntimeIdentifier)'))))</_KynxaNodeCacheDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-node-runtime.ps1&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -CacheDirectory &quot;$(_KynxaNodeCacheDirectory)&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\Build\node-runtime.json&quot;" />
    <ReadLinesFromFile File="$(_KynxaNodeCacheDirectory)\runtime-path.txt">
      <Output TaskParameter="Lines" PropertyName="_KynxaNodeRuntimeDirectory" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_KynxaNodeRuntimeFiles Include="$(_KynxaNodeRuntimeDirectory)\**\*" />
      <Content Include="@(_KynxaNodeRuntimeFiles)"
               Link="runtime\%(_KynxaNodeRuntimeFiles.RecursiveDir)%(_KynxaNodeRuntimeFiles.Filename)%(_KynxaNodeRuntimeFiles.Extension)"
               CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
  <!-- Dependencies may not exist during initial project evaluation on a clean
       checkout. Populate content after npm restore, with qualified metadata to
       avoid batching against unrelated Content items.
       干净克隆的项目在首次求值时可能尚无依赖；npm 还原后再填充内容，并使用限定元数据，避免与无关 Content 项一起批处理。
  -->
  <Target Name="IncludeGatewayRuntimeDependencies" BeforeTargets="AssignTargetPaths" DependsOnTargets="EnsureGatewayDependencies">
    <ItemGroup>
      <_KynxaGatewayDependencyFiles Include="..\model-gateway\node_modules\**\*"
          Exclude="..\model-gateway\node_modules\**\*.map;..\model-gateway\node_modules\.package-lock.json;..\model-gateway\node_modules\**\src\**\*;..\model-gateway\node_modules\**\tests\**\*;..\model-gateway\node_modules\**\test\**\*;..\model-gateway\node_modules\onnxruntime-node\bin\napi-v3\darwin\**\*;..\model-gateway\node_modules\onnxruntime-node\bin\napi-v3\linux\**\*" />
      <_KynxaGatewayDependencyFiles Remove="..\model-gateway\node_modules\onnxruntime-node\bin\napi-v3\win32\arm64\**\*" Condition="'$(RuntimeIdentifier)' == 'win-x64'" />
      <_KynxaGatewayDependencyFiles Remove="..\model-gateway\node_modules\onnxruntime-node\bin\napi-v3\win32\x64\**\*" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
      <Content Include="@(_KynxaGatewayDependencyFiles)"
          Link="model-gateway\node_modules\%(_KynxaGatewayDependencyFiles.RecursiveDir)%(_KynxaGatewayDependencyFiles.Filename)%(_KynxaGatewayDependencyFiles.Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Model weights are restored only by build tooling, then shipped read-only.
       First-use inference never needs Python, Docker, a download, or an API key.
       权重仅由构建工具还原，作为只读资产随包提供；首次推理无需 Python、Docker、下载或 API 密钥。
  -->
  <Target Name="IncludeBundledEmbeddingModel" BeforeTargets="AssignTargetPaths" DependsOnTargets="EnsureGatewayDependencies">
    <PropertyGroup>
      <_KynxaEmbeddingCacheDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..\..\artifacts\runtime\embedding\builtin-multilingual'))))</_KynxaEmbeddingCacheDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\model-gateway"
          Command="node models/retrieval/prepare-embedding-model.mjs --model-root &quot;$(_KynxaEmbeddingCacheDirectory)&quot;" />
    <ReadLinesFromFile File="$(_KynxaEmbeddingCacheDirectory)\bundle-files.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaEmbeddingModelFiles" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(_KynxaEmbeddingModelFiles)"
               Link="runtime\embedding\builtin-multilingual\$([MSBuild]::MakeRelative('$(_KynxaEmbeddingCacheDirectory)', '%(_KynxaEmbeddingModelFiles.Identity)'))"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Optional reranking shares the Node/ONNX runtime and stays unloaded for ordinary chat.
       可选重排复用 Node/ONNX 运行时，普通聊天不加载；公开权重与许可证按校验白名单随包提供。
  -->
  <Target Name="IncludeBundledRerankerModel" BeforeTargets="AssignTargetPaths" DependsOnTargets="EnsureGatewayDependencies">
    <PropertyGroup>
      <_KynxaRerankerCacheDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..\..\artifacts\runtime\rerank\builtin-multilingual-reranker'))))</_KynxaRerankerCacheDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\..\model-gateway"
          Command="node models/retrieval/prepare-reranker-model.mjs --model-root &quot;$(_KynxaRerankerCacheDirectory)&quot;" />
    <ReadLinesFromFile File="$(_KynxaRerankerCacheDirectory)\bundle-files.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaRerankerModelFiles" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(_KynxaRerankerModelFiles)"
               Link="runtime\rerank\builtin-multilingual-reranker\$([MSBuild]::MakeRelative('$(_KynxaRerankerCacheDirectory)', '%(_KynxaRerankerModelFiles.Identity)'))"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeGatewayVisualCppRuntime" BeforeTargets="AssignTargetPaths" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_KynxaVisualCppCacheDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..\..\artifacts\runtime\vc\$(RuntimeIdentifier)'))))</_KynxaVisualCppCacheDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-vc-runtime.ps1&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -CacheDirectory &quot;$(_KynxaVisualCppCacheDirectory)&quot;" />
    <ReadLinesFromFile File="$(_KynxaVisualCppCacheDirectory)\runtime-path.txt">
      <Output TaskParameter="Lines" PropertyName="_KynxaVisualCppRuntimeDirectory" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_KynxaVisualCppCacheDirectory)\runtime-files.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaVisualCppFiles" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(_KynxaVisualCppCacheDirectory)\runtime-notices.txt">
      <Output TaskParameter="Lines" ItemName="_KynxaVisualCppNotices" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Content Include="@(_KynxaVisualCppFiles)"
               Link="runtime\%(_KynxaVisualCppFiles.Filename)%(_KynxaVisualCppFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(_KynxaVisualCppFiles)"
               Link="model-gateway\node_modules\onnxruntime-node\bin\napi-v3\win32\x64\%(_KynxaVisualCppFiles.Filename)%(_KynxaVisualCppFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(_KynxaVisualCppNotices)"
               Link="runtime\licenses\vc\%(_KynxaVisualCppNotices.Filename)%(_KynxaVisualCppNotices.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeToolHostRuntime" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\tool-host\KYNXA.ToolHost.csproj" Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);Platform=AnyCPU;SelfContained=true" />
    <PropertyGroup>
      <_KynxaToolHostNoticesDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)toolhost-notices\$(RuntimeIdentifier)'))))</_KynxaToolHostNoticesDirectory>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\prepare-toolhost-notices.ps1&quot; -AssetsPath &quot;$(MSBuildProjectDirectory)\..\tool-host\obj\project.assets.json&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot; -OutputDirectory &quot;$(_KynxaToolHostNoticesDirectory)&quot;" />
    <ItemGroup>
      <_KynxaToolHostFiles Include="..\tool-host\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\**\*"
          Exclude="..\tool-host\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\**\*.pdb;..\tool-host\bin\$(Configuration)\net10.0-windows\$(RuntimeIdentifier)\**\*.tmp" />
      <Content Include="@(_KynxaToolHostFiles)"
               Link="ToolHost\%(_KynxaToolHostFiles.RecursiveDir)%(_KynxaToolHostFiles.Filename)%(_KynxaToolHostFiles.Extension)"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <_KynxaToolHostNotices Include="$(_KynxaToolHostNoticesDirectory)\**\*" />
      <Content Include="@(_KynxaToolHostNotices)"
               Link="ToolHost\licenses\%(_KynxaToolHostNotices.RecursiveDir)%(_KynxaToolHostNotices.Filename)%(_KynxaToolHostNotices.Extension)"
               CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
  <!-- The SDK extracts WinUI portable-library resources from PackagingOutputs.
       ToolHost is a separate self-contained WPF process: keep its DLLs in the
       payload while excluding them only from that PRI extraction step.
       SDK 从 PackagingOutputs 提取 WinUI 可移植库资源；ToolHost 是独立自包含的 WPF 进程，DLL 仍随包提供，仅从这一 PRI 提取步骤中排除。
  -->
  <Target Name="ExcludeToolHostLibrariesFromWinUiPri" BeforeTargets="_GeneratePrisForPortableLibraries">
    <ItemGroup Condition="'@(_LibrariesUnfiltered)' == '' and '@(CreatedResWFiles)' == '' and '$(NetCoreGeneratePrisForPortableLibraries)' != 'true'">
      <_LibrariesUnfiltered Include="@(PackagingOutputs)" Exclude="@(_KynxaToolHostFiles);@(_KynxaToolHostFiles->'%(FullPath)')" Condition="'%(Extension)' == '.dll'" />
    </ItemGroup>
    <ItemGroup>
      <_LibrariesUnfiltered Remove="@(_KynxaToolHostFiles);@(_KynxaToolHostFiles->'%(FullPath)')" />
      <!-- Native Node addons are not WinUI assemblies and must not be parsed by PRI.
           Node 原生运行库不是 WinUI 程序集，不能参与 PRI 可移植资源程序集提取。
      -->
      <_LibrariesUnfiltered Remove="@(_KynxaGatewayDependencyFiles);@(_KynxaGatewayDependencyFiles->'%(FullPath)')" />
      <_LibrariesUnfiltered Remove="@(_KynxaVisualCppFiles);@(_KynxaVisualCppFiles->'%(FullPath)')" />
    </ItemGroup>
  </Target>
  <!-- PRI's layout indexer also parses arbitrary content filenames as resource
       qualifiers. Preserve these separate runtimes as unindexed main payloads,
       without suppressing validation of the actual desktop UI resources.
       PRI 布局索引器也会将普通内容文件名解析为资源限定符；独立运行时保持为不参与索引的主包负载，不关闭桌面界面资源的实际验证。
  -->
  <Target Name="KeepExecutableRuntimePayloadsOutsideWinUiPri"
          AfterTargets="_GenerateProjectPriConfigurationFiles"
          BeforeTargets="_GenerateProjectPriFileCore"
          Condition="Exists('$(_FilteredLayoutResfilesPath)')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build\filter-runtime-pri-layout.ps1&quot; -LayoutPath &quot;$(_FilteredLayoutResfilesPath)&quot; -ExcludedLayoutPath &quot;$(_ExcludedLayoutResfilesPath)&quot;" />
  </Target>
</Project>
