<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="KYNXA_Desktop.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:KYNXA_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:KYNXA_Desktop.ViewModels"
    x:Name="PageRoot"
    Background="{StaticResource KynxaMainBrush}"
    Loaded="PageRoot_Loaded"
    mc:Ignorable="d">

    <Grid x:Name="ShellGrid" SizeChanged="ShellGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="176" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar slot -->
        <Grid Grid.Column="0" Background="{StaticResource KynxaSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid x:Name="GlobalSidebarHeader" Grid.Row="0" Margin="15,0,11,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Button
                    Click="SidebarToggle_Click"
                    Style="{StaticResource KynxaIconButtonStyle}"
                    ToolTipService.ToolTip="收起或展开侧边栏">
                    <Image Width="20" Height="20" Source="{StaticResource IconSidebarToggle}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource KynxaIconButtonStyle}"
                    ToolTipService.ToolTip="搜索">
                    <Image Width="20" Height="20" Source="{StaticResource IconSearch}" />
                </Button>
            </Grid>

            <StackPanel x:Name="GlobalNavigationArea" Grid.Row="1" HorizontalAlignment="Stretch">
                <Button Click="NewPrimaryAction_Click" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="20" Height="20" HorizontalAlignment="Left" Source="{StaticResource IconAdd}" /><TextBlock x:Name="NewPrimaryActionLabel" Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="新对话" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconKnowledge}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="知识库" /></Grid>
                </Button>
                <Grid PointerEntered="WorkRow_PointerEntered" PointerExited="WorkRow_PointerExited">
                    <Button x:Name="WorkNavigationButton" Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid x:Name="WorkNavigationContent" Margin="0,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconWork}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="工作" /></Grid>
                    </Button>
                    <Button
                        x:Name="WorkAddButton"
                        Width="26"
                        Height="26"
                        Margin="0,0,11,0"
                        Padding="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="新建工作"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Opacity="0">
                        <Button.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.14" />
                        </Button.OpacityTransition>
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonForeground" Color="#7D899D" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111827" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111827" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#120A1123" />
                        </Button.Resources>
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconConnect}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="连接" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconScheduledTask}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="定时任务" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconSkills}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="技能" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconModelManagement}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="模型管理" /></Grid>
                </Button>
            </StackPanel>

            <Border x:Name="GlobalNavigationDivider" Grid.Row="2" Margin="20,0,12,0" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="0,1,0,0" />

            <Grid x:Name="RecentArea" Grid.Row="3" Margin="10,14,10,6">
                <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="最近对话" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl HorizontalContentAlignment="Stretch" ItemsSource="{x:Bind ViewModel.RecentConversations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentConversation">
                                <Grid
                                    PointerEntered="ConversationRow_PointerEntered"
                                    PointerExited="ConversationRow_PointerExited">
                                    <Button x:Name="ConversationOpenButton" Style="{StaticResource KynxaConversationButtonStyle}">
                                        <Grid Margin="0,0,30,0">
                                            <Grid.RowDefinitions><RowDefinition Height="23" /><RowDefinition Height="17" /></Grid.RowDefinitions>
                                            <TextBlock FontSize="13" FontWeight="Medium" Foreground="{StaticResource KynxaTextBrush}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1" FontSize="10" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="{x:Bind RelativeTime}" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        x:Name="ConversationMoreButton"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,4,0"
                                        Padding="5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="更多对话操作"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="7"
                                        IsHitTestVisible="False"
                                        Opacity="0">
                                        <Button.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.14" />
                                        </Button.OpacityTransition>
                                        <Button.Resources>
                                            <SolidColorBrush x:Key="ButtonForeground" Color="#7D899D" />
                                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111827" />
                                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111827" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#120A1123" />
                                        </Button.Resources>
                                        <FontIcon FontSize="15" Glyph="&#xE712;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Contextual navigation shown after a work is opened. -->
            <Grid
                x:Name="WorkDetailSidebarHost"
                Grid.Row="0"
                Grid.RowSpan="4"
                Background="{StaticResource KynxaSidebarBrush}"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button
                    Width="32"
                    Height="32"
                    Margin="15,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="WorkDetailBackButton_Click"
                    Style="{StaticResource KynxaIconButtonStyle}"
                    ToolTipService.ToolTip="返回聊天">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>

                <StackPanel Grid.Row="1" Margin="20,2,14,14" Spacing="4">
                    <TextBlock x:Name="WorkDetailNameText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KynxaTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="当前工作" />
                </StackPanel>

                <StackPanel Grid.Row="2" HorizontalAlignment="Stretch">
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="19" Height="19" HorizontalAlignment="Left" Source="{StaticResource IconAdd}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="新建工作对话" /></Grid>
                    </Button>
                    <Grid>
                        <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                            <Grid Margin="0,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconWork}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="子工作" /></Grid>
                        </Button>
                        <Button Width="26" Height="26" Margin="0,0,11,0" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="6" ToolTipService.ToolTip="创建子工作">
                            <FontIcon FontSize="13" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconSkills}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="工作任务" /></Grid>
                    </Button>
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconKnowledge}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="工作知识库" /></Grid>
                    </Button>
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconConnect}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="连接" /></Grid>
                    </Button>
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconScheduledTask}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="定时任务" /></Grid>
                    </Button>
                    <Button Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconModelManagement}" /><TextBlock Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" FontSize="14" Text="模型配置" /></Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="20,0,12,0" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="0,1,0,0" />

                <StackPanel Grid.Row="4" Margin="10,10,10,6">
                    <Button Click="WorkChatsToggle_Click" Style="{StaticResource KynxaNavigationButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="工作中的聊天" />
                            <FontIcon x:Name="WorkChatsChevron" Grid.Column="1" FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="WorkChatsList" Visibility="Collapsed">
                        <Button Content="需求梳理" Style="{StaticResource KynxaConversationButtonStyle}" />
                        <Button Content="执行记录" Style="{StaticResource KynxaConversationButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="14,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource KynxaIconButtonStyle}" ToolTipService.ToolTip="设置"><Image Width="20" Height="20" Source="{StaticResource IconSettings}" /></Button>
                <Grid Grid.Column="2" ToolTipService.ToolTip="设备在线">
                    <Image Width="20" Height="20" Source="{StaticResource IconDeviceStatus}" />
                    <Ellipse Width="8" Height="8" Margin="0,0,0,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource KynxaOnlineBrush}" Stroke="{StaticResource KynxaSidebarBrush}" StrokeThickness="1.5" />
                </Grid>
            </Grid>
        </Grid>

        <controls:ResizeGrip
            x:Name="SidebarGrip"
            Grid.Column="1"
            Axis="Horizontal"
            CancelRequested="SidebarGrip_CancelRequested"
            DragCompleted="LayoutGrip_DragCompleted"
            DragDelta="SidebarGrip_DragDelta"
            DragStarted="SidebarGrip_DragStarted"
            ResetRequested="SidebarGrip_ResetRequested" />

        <!-- Stable main slots: top workspace, primary content and optional preview. -->
        <Grid x:Name="MainRegion" Grid.Column="2" Background="{StaticResource KynxaMainBrush}" SizeChanged="MainRegion_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopWorkspaceRow" Height="96" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="TopContextSlot" />
                <Border
                    x:Name="ChatWorkSwitcher"
                    Width="220"
                    Height="38"
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{StaticResource KynxaSegmentIdleBrush}"
                    CornerRadius="11"
                    Translation="0,0,16">
                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border
                            x:Name="PrimaryModeSelectionPill"
                            Grid.ColumnSpan="2"
                            Width="116"
                            HorizontalAlignment="Left"
                            Background="White"
                            CornerRadius="11"
                            Translation="0,0,8">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Border.TranslationTransition>
                                <Vector3Transition Duration="0:0:0.2" />
                            </Border.TranslationTransition>
                        </Border>
                        <Button x:Name="ChatModeButton" Background="Transparent" Click="ChatModeButton_Click" Content="聊天" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            </Button.Resources>
                        </Button>
                        <Button x:Name="WorkModeButton" Grid.Column="1" Background="Transparent" Click="WorkModeButton_Click" Content="工作" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
                <Grid x:Name="TopToolbarSlot" HorizontalAlignment="Right" />
            </Grid>

            <controls:ResizeGrip
                x:Name="TopWorkspaceGrip"
                Grid.Row="1"
                Axis="Vertical"
                CancelRequested="TopWorkspaceGrip_CancelRequested"
                DragCompleted="LayoutGrip_DragCompleted"
                DragDelta="TopWorkspaceGrip_DragDelta"
                DragStarted="TopWorkspaceGrip_DragStarted"
                ResetRequested="TopWorkspaceGrip_ResetRequested" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewGripColumn" Width="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PrimaryContentSlot" SizeChanged="PrimaryContentSlot_SizeChanged">
                    <Grid x:Name="ChatAmbientLayer" IsHitTestVisible="False" Opacity="0.5">
                        <Ellipse x:Name="AmbientLargeWave" Width="870" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveBrush}" StrokeThickness="50" />
                        <Ellipse x:Name="AmbientSoftWave" Width="720" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveSoftBrush}" StrokeThickness="34" />
                    </Grid>

                    <!-- Reserved for the durable work history surface. -->
                    <Grid
                        x:Name="WorkHistoryHost"
                        MaxWidth="960"
                        Margin="48,38,48,40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Height="34" Orientation="Horizontal" Spacing="22">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Microsoft YaHei UI"
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource KynxaTextBrush}"
                                LineHeight="34"
                                LineStackingStrategy="BlockLineHeight"
                                Text="工作" />
                            <Grid
                                Width="320"
                                Height="34"
                                VerticalAlignment="Center"
                                Background="{StaticResource KynxaComposerActionBrush}"
                                CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Width="15" Height="15" Source="{StaticResource IconSearch}" />
                                <TextBox
                                    x:Name="WorkSearchBox"
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    Padding="0,1,0,0"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Microsoft YaHei UI"
                                    FontSize="14"
                                    PlaceholderText="搜索工作"
                                    Translation="0,6,0"
                                    TextChanged="WorkSearchBox_TextChanged">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>
                            </Grid>
                        </StackPanel>

                        <Border
                            Grid.Row="2"
                            Width="234"
                            Height="36"
                            HorizontalAlignment="Left"
                            Background="{StaticResource KynxaSegmentIdleBrush}"
                            CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Border
                                    x:Name="WorkFilterSelectionPill"
                                    Grid.ColumnSpan="3"
                                    Width="82"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    CornerRadius="10"
                                    Translation="0,0,8">
                                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                                    <Border.TranslationTransition>
                                        <Vector3Transition Duration="0:0:0.2" />
                                    </Border.TranslationTransition>
                                </Border>
                                <Button x:Name="AllWorksFilterButton" Background="Transparent" Click="AllWorksFilterButton_Click" Content="全部" CornerRadius="10" FontSize="13" BorderThickness="0">
                                    <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" /></Button.Resources>
                                </Button>
                                <Button x:Name="PersonalWorksFilterButton" Grid.Column="1" Background="Transparent" Click="PersonalWorksFilterButton_Click" Content="个人" CornerRadius="10" FontSize="13" BorderThickness="0">
                                    <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" /></Button.Resources>
                                </Button>
                                <Button x:Name="SharedWorksFilterButton" Grid.Column="2" Background="Transparent" Click="SharedWorksFilterButton_Click" Content="共享" CornerRadius="10" FontSize="13" BorderThickness="0">
                                    <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" /></Button.Resources>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4" Height="32" Margin="12,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="工作名称" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="创建时间" />
                        </Grid>

                        <ListView
                            x:Name="WorkList"
                            Grid.Row="5"
                            IsItemClickEnabled="True"
                            ItemClick="WorkList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.VisibleWorks}"
                            SelectionMode="Single"
                            DoubleTapped="WorkList_DoubleTapped">
                            <ListView.Resources>
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E8ECF4" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#DFE5F0" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#D9E0EC" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#D4DCE8" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="56" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="CornerRadius" Value="9" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:WorkSummary">
                                    <Grid Height="54" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="38" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="20" Height="20" HorizontalAlignment="Left" Source="{StaticResource IconWork}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KynxaTextBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="{x:Bind CreatedAt}" />
                                        <Button Grid.Column="3" Width="30" Height="30" Padding="5" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" CornerRadius="7" AutomationProperties.Name="工作操作">
                                            <Button.Resources>
                                                <SolidColorBrush x:Key="ButtonForeground" Color="#7D899D" />
                                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111827" />
                                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111827" />
                                            </Button.Resources>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Click="OpenWorkMenuItem_Click" CommandParameter="{Binding}" Style="{StaticResource KynxaWorkMenuItemStyle}" Text="打开" />
                                                    <MenuFlyoutSubItem Style="{StaticResource KynxaWorkSubMenuItemStyle}" Text="添加已有内容">
                                                        <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="普通聊天" />
                                                        <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="其他工作" />
                                                        <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="其他工作中的聊天" />
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="重命名" />
                                                    <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="分享" />
                                                    <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="归档" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Style="{StaticResource KynxaWorkMenuItemStyle}" Text="删除" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon FontSize="15" Glyph="&#xE712;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <Grid
                        x:Name="WorkDetailHost"
                        MaxWidth="760"
                        Margin="48,38,48,40"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <Border Width="64" Height="64" Background="{StaticResource KynxaComposerActionBrush}" CornerRadius="18">
                                <Image Width="28" Height="28" Source="{StaticResource IconWork}" />
                            </Border>
                            <TextBlock x:Name="WorkDetailTitleText" HorizontalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KynxaTextBrush}" />
                            <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="从左侧选择一项，开始组织这个工作" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="MainContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
                        <Grid x:Name="LogoHost" Width="176" Height="132" HorizontalAlignment="Center">
                            <Image
                                x:Name="KynxaLogo"
                                Width="353"
                                Height="235"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{StaticResource KynxaLogoImage}"
                                Stretch="Uniform" />
                        </Grid>

                        <Border
                            x:Name="ComposerHost"
                            Width="824"
                            Height="110"
                            Background="{StaticResource KynxaSurfaceBrush}"
                            BorderBrush="{StaticResource KynxaComposerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Translation="0,0,24">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
                                <TextBox
                                    x:Name="PromptTextBox"
                                    Margin="46,8,10,0"
                                    Padding="6,2,24,2"
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Foreground="{StaticResource KynxaTextBrush}"
                                    PlaceholderText="向 KYNXA 提问任何问题..."
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}"
                                    TextChanged="PromptTextBox_TextChanged"
                                    TextWrapping="Wrap">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                    </TextBox.Resources>
                                </TextBox>

                                <Button
                                    x:Name="ComposerExpandButton"
                                    Width="28"
                                    Height="28"
                                    Margin="12,8,0,0"
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="ComposerExpandButton_Click"
                                    CornerRadius="7"
                                    ToolTipService.ToolTip="展开输入区">
                                    <FontIcon x:Name="ComposerExpandIcon" FontSize="14" Glyph="&#xE740;" />
                                </Button>

                                <Grid Grid.Row="1" Margin="12,0,12,6">
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                                        <Button Width="38" Height="38" Padding="8" Background="{StaticResource KynxaComposerActionBrush}" BorderThickness="0" CornerRadius="19" ToolTipService.ToolTip="添加"><Image Width="20" Height="20" Source="{StaticResource IconAdd}" /></Button>
                                        <Button Style="{StaticResource KynxaComposerIconButtonStyle}" ToolTipService.ToolTip="引用或添加附件"><Image Width="18" Height="18" Source="{StaticResource IconAttachment}" /></Button>
                                        <ToggleButton
                                            x:Name="WebSearchToggleButton"
                                            Width="32"
                                            Height="32"
                                            Padding="7"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Checked="WebSearchToggleButton_StateChanged"
                                            CornerRadius="8"
                                            IsChecked="True"
                                            ToolTipService.ToolTip="联网搜索：已开启"
                                            Unchecked="WebSearchToggleButton_StateChanged">
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#E3E8F2" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#D9E0EC" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#DCE9FF" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D3E3FC" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#C8DCF8" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                            </ToggleButton.Resources>
                                            <Image Width="18" Height="18" Source="{StaticResource IconWebSearch}" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                                        <Button
                                            x:Name="ExecutionModeButton"
                                            Height="32"
                                            Padding="8,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            ToolTipService.ToolTip="执行模式：标准">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Click="ExecutionModeMenuItem_Click" Style="{StaticResource KynxaWorkMenuItemStyle}" Tag="quick" Text="快速" />
                                                    <MenuFlyoutItem Click="ExecutionModeMenuItem_Click" Style="{StaticResource KynxaWorkMenuItemStyle}" Tag="standard" Text="标准" />
                                                    <MenuFlyoutItem Click="ExecutionModeMenuItem_Click" Style="{StaticResource KynxaWorkMenuItemStyle}" Tag="deep" Text="深度" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Image Width="16" Height="16" Source="{StaticResource IconQuickMode}" />
                                                <TextBlock x:Name="ExecutionModeLabel" VerticalAlignment="Center" FontSize="12" Text="标准" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource KynxaComposerIconButtonStyle}" ToolTipService.ToolTip="选择模型"><Image Width="18" Height="18" Source="{StaticResource IconModelSelect}" /></Button>
                                        <Button Width="40" Height="40" Padding="9" Background="{StaticResource KynxaSendBrush}" BorderThickness="0" Click="SendButton_Click" CornerRadius="20" ToolTipService.ToolTip="发送">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="KynxaSendHoverBrush" />
                                                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="KynxaSendPressedBrush" />
                                            </Button.Resources>
                                            <Image Width="20" Height="20" Source="{StaticResource IconSend}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <controls:ResizeGrip
                                    x:Name="ComposerLeftGrip"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Left"
                                    Axis="Horizontal"
                                    CancelRequested="ComposerWidthGrip_CancelRequested"
                                    DragCompleted="LayoutGrip_DragCompleted"
                                    DragDelta="ComposerLeftGrip_DragDelta"
                                    DragStarted="ComposerWidthGrip_DragStarted"
                                    ResetRequested="ComposerWidthGrip_ResetRequested" />
                                <controls:ResizeGrip
                                    x:Name="ComposerRightGrip"
                                    Grid.RowSpan="2"
                                    HorizontalAlignment="Right"
                                    Axis="Horizontal"
                                    CancelRequested="ComposerWidthGrip_CancelRequested"
                                    DragCompleted="LayoutGrip_DragCompleted"
                                    DragDelta="ComposerRightGrip_DragDelta"
                                    DragStarted="ComposerWidthGrip_DragStarted"
                                    ResetRequested="ComposerWidthGrip_ResetRequested" />
                                <controls:ResizeGrip
                                    x:Name="ComposerTopGrip"
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Top"
                                    Axis="Vertical"
                                    CancelRequested="ComposerHeightGrip_CancelRequested"
                                    DragCompleted="LayoutGrip_DragCompleted"
                                    DragDelta="ComposerTopGrip_DragDelta"
                                    DragStarted="ComposerHeightGrip_DragStarted"
                                    ResetRequested="ComposerHeightGrip_ResetRequested" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
