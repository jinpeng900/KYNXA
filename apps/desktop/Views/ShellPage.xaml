<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KYNXA_Desktop.Views.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:KYNXA_Desktop.Services" xmlns:controls="using:KYNXA_Desktop.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="using:KYNXA_Desktop.ViewModels" x:Name="PageRoot" Language="zh-CN" FontFamily="{StaticResource KynxaUIFont}" FontSize="14" Foreground="{StaticResource KynxaTextBrush}" Background="{StaticResource KynxaMainBrush}" Loaded="PageRoot_Loaded" mc:Ignorable="d">

    <Page.Resources>
        <!-- Keep the dismissal surface transparent in every Button state.
             关闭命中面始终透明，内容仅由侧栏绘制。 -->
        <Style x:Key="ShellTransparentScrimStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button"><Border Background="Transparent" /></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="ShellGrid" Background="{StaticResource KynxaSidebarBrush}" SizeChanged="ShellGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition x:Name="SidebarGripColumn" Width="4" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button x:Name="SidebarScrim" Grid.ColumnSpan="3" Canvas.ZIndex="15" Visibility="Collapsed"
                Style="{StaticResource ShellTransparentScrimStyle}"
                Click="SidebarScrim_Click" services:UiLocalization.AutomationName="收起侧栏" />
        <Grid x:Name="SidebarPane" Grid.Column="0" Canvas.ZIndex="20" Background="{StaticResource KynxaSidebarBrush}"
              SizeChanged="SidebarPane_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid x:Name="GlobalSidebarHeader" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CompactSidebarButton" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="SidebarToggle_Click"
                        services:UiLocalization.AutomationName="展开侧栏" services:UiLocalization.ToolTip="展开侧栏">
                    <FontIcon Glyph="&#xE700;" FontSize="17" />
                </Button>
                <!-- Equal segments: 36 high, 2 inset, 32-high content.
                     等宽分段：总高 36、内缩 2、内容高 32。
                -->
                <Border x:Name="ChatWorkSwitcher" Height="36" Padding="2"
                        Background="{StaticResource KynxaSegmentIdleBrush}" CornerRadius="10">
                    <Grid x:Name="ModeSwitchTrack" SizeChanged="ModeSwitchTrack_SizeChanged">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="PrimaryModeSelectionPill" Grid.ColumnSpan="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{StaticResource KynxaSelectionBrush}" CornerRadius="8"
                                IsHitTestVisible="False">
                            <Border.TranslationTransition>
                                <Vector3Transition Duration="0:0:0.18" />
                            </Border.TranslationTransition>
                        </Border>
                        <Button x:Name="WorkModeButton" Click="WorkModeButton_Click"
                                Padding="6,0" services:UiLocalization.AutomationName="工作模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                                <TextBlock services:UiLocalization.Text="工作" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChatModeButton" Grid.Column="1" Click="ChatModeButton_Click"
                                Padding="6,0" services:UiLocalization.AutomationName="聊天模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                <TextBlock services:UiLocalization.Text="聊天" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Button x:Name="CollapseSidebarButton" Grid.Column="1" Margin="4,0,0,0"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="SidebarToggle_Click"
                        services:UiLocalization.AutomationName="收起侧栏" services:UiLocalization.ToolTip="收起侧栏">
                    <controls:ThemeIcon Width="20" Height="20" IconKey="IconSidebarToggle" />
                </Button>
            </Grid>

            <StackPanel x:Name="GlobalNavigationArea" Grid.Row="1" HorizontalAlignment="Stretch">

                <Button Click="KnowledgeNavigation_Click" services:UiLocalization.AutomationName="知识库" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:ThemeIcon Width="18" Height="18" HorizontalAlignment="Left" IconKey="IconKnowledge" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="知识库" /></Grid>
                </Button>

                <Button Click="ConnectionsNavigation_Click" services:UiLocalization.AutomationName="连接" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:ThemeIcon Width="18" Height="18" HorizontalAlignment="Left" IconKey="IconConnect" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="连接" /></Grid>
                </Button>
                <Button Click="ScheduleNavigation_Click" services:UiLocalization.AutomationName="定时任务" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:ThemeIcon Width="18" Height="18" HorizontalAlignment="Left" IconKey="IconScheduledTask" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="定时任务" /></Grid>
                </Button>
                <Button Click="SkillsNavigation_Click" services:UiLocalization.AutomationName="技能" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:ThemeIcon Width="18" Height="18" HorizontalAlignment="Left" IconKey="IconSkills" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="技能" /></Grid>
                </Button>
                <Button Click="ModelManagementButton_Click" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><controls:ThemeIcon Width="18" Height="18" HorizontalAlignment="Left" IconKey="IconModelManagement" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="模型管理" /></Grid>
                </Button>
            </StackPanel>



            <Grid x:Name="RecentArea" Grid.Row="3" Margin="8,8,8,6">
                <Grid.Resources>
                    <Style x:Key="SidebarPinIndicatorStyle" TargetType="Border">
                        <Setter Property="Width" Value="20" />
                        <Setter Property="Height" Value="20" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                    <Thickness x:Key="TreeViewItemPresenterPadding">0,0,16,0</Thickness>
                    <Thickness x:Key="TreeViewItemBorderThemeThickness">0</Thickness>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundDisabled" Color="Transparent" />
                    <!-- One opaque surface spans the chevron and content; active and hover never compound.
                         一层不透明背景同时覆盖展开箭头与内容，选中和悬停反馈不叠加。
                    -->
                    <Style x:Key="WorkProjectTreeItemStyle" TargetType="TreeViewItem">
                        <Setter Property="Height" Value="{StaticResource KynxaSidebarRowHeight}" />
                        <Setter Property="MinHeight" Value="{StaticResource KynxaSidebarRowHeight}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="{StaticResource KynxaSidebarItemMargin}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="GlyphBrush" Value="{StaticResource KynxaSecondaryTextBrush}" />
                        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid x:Name="ContentPresenterGrid" Background="{TemplateBinding Background}"
                                          CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="PointerRowBackground.Visibility" Value="Visible" />
                                                        <Setter Target="PointerRowBackground.Background" Value="{StaticResource KynxaControlPressedBrush}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected" />
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                                <VisualState x:Name="SelectedDisabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border x:Name="PointerRowBackground" Background="{StaticResource KynxaControlHoverBrush}"
                                                Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                                CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <Border x:Name="ActiveRowBackground" Background="{StaticResource KynxaSelectionBrush}"
                                                Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                                CornerRadius="{TemplateBinding CornerRadius}" Visibility="{Binding ActiveVisibility}"
                                                IsHitTestVisible="False" />
                                        <!-- Native names/settings keep expansion, keyboard navigation and indentation intact.
                                             保留原生名称和设置，确保展开、键盘导航与缩进行为不变。
                                        -->
                                        <Grid x:Name="MultiSelectGrid"
                                              Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="MultiSelectCheckBox" Width="32" MinWidth="32" Visibility="Collapsed"
                                                      IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                                            <Grid x:Name="ExpandCollapseChevron" Grid.Column="1" Padding="14,0" Background="Transparent"
                                                  Opacity="{TemplateBinding GlyphOpacity}">
                                                <TextBlock x:Name="CollapsedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="12" Height="12"
                                                           Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                                           FontSize="{TemplateBinding GlyphSize}" Text="{TemplateBinding CollapsedGlyph}"
                                                           FontFamily="{ThemeResource SymbolThemeFontFamily}" Padding="2" VerticalAlignment="Center"
                                                           AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False" />
                                                <TextBlock x:Name="ExpandedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="12" Height="12"
                                                           Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                                           FontSize="{TemplateBinding GlyphSize}" Text="{TemplateBinding ExpandedGlyph}"
                                                           FontFamily="{ThemeResource SymbolThemeFontFamily}" Padding="2" VerticalAlignment="Center"
                                                           AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False" />
                                            </Grid>
                                            <ContentPresenter x:Name="ContentPresenter" Grid.Column="2" Margin="0,0,16,0"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="WorkChatListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource KynxaSidebarListItemStyle}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                    <DataTemplate x:Key="WorkChatRowTemplate" x:DataType="viewModels:ProjectTreeEntry">
                        <Grid x:Name="WorkChatRowRoot" Height="{StaticResource KynxaSidebarRowHeight}" Tag="{x:Bind}" Background="Transparent" Unloaded="ProjectRow_Unloaded"
                              PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                              GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                            <Border x:Name="WorkChatActiveBackground" CornerRadius="{StaticResource KynxaControlRadius}"
                                    Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                    Background="{StaticResource KynxaSelectionBrush}" IsHitTestVisible="False"
                                    Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            <Grid Margin="8,0,16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="SidebarPinIndicator" Style="{StaticResource SidebarPinIndicatorStyle}"
                                        Visibility="{x:Bind PinnedVisibility, Mode=OneWay}" services:UiLocalization.ToolTip="已置顶">
                                    <controls:ThemeIcon IconKey="IconPinnedRecent" Foreground="{StaticResource KynxaAccentTextBrush}" />
                                </Border>
                                <TextBlock x:Name="ProjectRowTitle" Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                                           FontFamily="{StaticResource KynxaUIFont}" FontSize="14" FontWeight="Normal"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ContextTitle, Mode=OneWay}" />
                                <Ellipse Grid.Column="2" Width="5" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{StaticResource KynxaSecondaryTextBrush}" Visibility="{x:Bind ReplyingVisibility, Mode=OneWay}"
                                         services:UiLocalization.ToolTip="正在回复" services:UiLocalization.AutomationName="正在回复" />
                                <StackPanel x:Name="ProjectRowActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                    <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                    <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="ProjectMore_Click"
                                            services:UiLocalization.AutomationName="聊天操作" AutomationProperties.AutomationId="{x:Bind MoreId}"
                                            services:UiLocalization.ToolTip="聊天操作">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </Grid.Resources>
                <ScrollViewer x:Name="WorkSidebarViewport" VerticalAlignment="Top" VerticalContentAlignment="Top"
                              HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled"
                              AutomationProperties.AutomationId="WorkSidebarViewport" services:UiLocalization.AutomationName="工作">
                <Grid x:Name="WorkSidebarContent" SizeChanged="WorkSidebarContent_SizeChanged" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="WorkNavigationRow" Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="WorkNavigationPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" /><RowDefinition x:Name="WorkRecentRow" Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="40" /><RowDefinition x:Name="WorkProjectsRow" Height="Auto" />
                        </Grid.RowDefinitions>
                    <!-- Inline search replaces the title while leaving the leading collapse target accessible.
                         标题内搜索替换文字区域，前侧折叠操作保留独立命中范围。 -->
                    <Grid x:Name="WorkRecentHeader" Height="32" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <Button x:Name="WorkRecentToggle" Grid.ColumnSpan="2"
                                Style="{StaticResource KynxaSidebarHeaderButtonStyle}" Click="WorkRecentToggle_Click"
                                AutomationProperties.AutomationId="WorkRecentToggle"
                                AutomationProperties.Name="{services:UiText Key='展开最近的工作聊天'}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon x:Name="WorkRecentChevron" Glyph="&#xE76C;" FontSize="10" HorizontalAlignment="Center" />
                                <StackPanel x:Name="WorkRecentTitleHost" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock services:UiLocalization.Text="最近" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    <TextBlock x:Name="WorkRecentCount" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <controls:SidebarSearchBox x:Name="WorkRecentSearchBox" AutomationProperties.AutomationId="WorkRecentSearchBox" Tag="recent" Grid.Column="1" Height="32" FontSize="13"
                                 Style="{StaticResource KynxaPopupSearchBoxStyle}" Padding="8,4" MinWidth="0" Visibility="Collapsed"
                                 services:UiLocalization.PlaceholderText="搜索工作任务" services:UiLocalization.AutomationName="请输入工作任务名称"
                                 TextChanged="SidebarSearch_TextChanged" KeyDown="SidebarSearch_KeyDown" KeyUp="SidebarSearch_KeyUp"
                                 TextCompositionStarted="SidebarSearch_CompositionStarted" TextCompositionEnded="SidebarSearch_CompositionEnded" />
                        <Button x:Name="WorkRecentSearchButton" AutomationProperties.AutomationId="WorkRecentSearchButton" Grid.Column="2" Tag="recent" Click="SidebarSearch_Click"
                                Style="{StaticResource KynxaProjectActionButtonStyle}" Width="28" Height="28"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                services:UiLocalization.AutomationName="搜索工作任务" services:UiLocalization.ToolTip="搜索工作任务">
                            <FontIcon x:Name="WorkRecentSearchGlyph" Glyph="&#xE721;" FontSize="14" />
                        </Button>
                    </Grid>
                    <ListView x:Name="WorkRecentHistory" KeyDown="SidebarSearchResults_KeyDown" ContainerContentChanging="SidebarRow_ContainerContentChanging" Grid.Row="1" ItemsSource="{x:Bind VisibleWorkRecentEntries}" Visibility="Collapsed"
                              Padding="0" BorderThickness="0" MinHeight="0" VerticalAlignment="Top"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="WorkChatHistory_ItemClick"
                              ItemTemplate="{StaticResource WorkChatRowTemplate}"
                              ItemContainerStyle="{StaticResource WorkChatListItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              services:UiLocalization.AutomationName="所有工作中的最近聊天" />
                    <TextBlock x:Name="WorkRecentSearchEmpty" Grid.Row="1" Height="32" FontSize="13" Margin="8,0,16,0"
                               Foreground="{StaticResource KynxaSecondaryTextBrush}" services:UiLocalization.Text="没有匹配结果"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                    <controls:ResizeGrip x:Name="WorkRecentDivider" Grid.Row="2" Axis="Vertical" Tag="0" Margin="8,0,12,0"
                                         Visibility="Collapsed" AutomationProperties.AutomationId="WorkRecentDivider"
                                         services:UiLocalization.AutomationName="调整最近和项目区域高度"
                                         services:UiLocalization.ToolTip="拖动调整区域高度，双击恢复默认四行"
                                         DragStarted="WorkSidebarDivider_DragStarted" DragDelta="WorkSidebarDivider_DragDelta"
                                         DragCompleted="WorkSidebarDivider_DragCompleted" CancelRequested="WorkSidebarDivider_CancelRequested"
                                         ResetRequested="WorkSidebarDivider_ResetRequested" />
                    <Grid x:Name="ProjectsHeader" Grid.Row="3" Margin="0,8,0,0" Height="32" Background="Transparent" PointerEntered="ProjectsHeader_PointerEntered"
                          PointerExited="ProjectsHeader_PointerExited" GotFocus="ProjectsHeader_GotFocus" LostFocus="ProjectsHeader_LostFocus">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <Button x:Name="ProjectsToggle" Grid.ColumnSpan="2" Click="ProjectsToggle_Click" Style="{StaticResource KynxaSidebarHeaderButtonStyle}"
                                services:UiLocalization.AutomationName="展开或收起项目"
                                AutomationProperties.AutomationId="ProjectsToggle">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon x:Name="ProjectsChevron" Glyph="&#xE70D;" FontSize="10" HorizontalAlignment="Center" />
                                <StackPanel x:Name="ProjectTitleHost" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock services:UiLocalization.Text="项目" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    <TextBlock x:Name="WorkProjectCount" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <controls:SidebarSearchBox x:Name="ProjectSearchBox" AutomationProperties.AutomationId="ProjectSearchBox" Tag="projects" Grid.Column="1" Height="32" FontSize="13"
                                 Style="{StaticResource KynxaPopupSearchBoxStyle}" Padding="8,4" MinWidth="0" Visibility="Collapsed"
                                 services:UiLocalization.PlaceholderText="搜索项目" services:UiLocalization.AutomationName="请输入项目名称"
                                 TextChanged="SidebarSearch_TextChanged" KeyDown="SidebarSearch_KeyDown" KeyUp="SidebarSearch_KeyUp"
                                 TextCompositionStarted="SidebarSearch_CompositionStarted" TextCompositionEnded="SidebarSearch_CompositionEnded" />
                        <Button x:Name="ProjectSearchButton" AutomationProperties.AutomationId="ProjectSearchButton" Grid.Column="2" Tag="projects" Click="SidebarSearch_Click"
                                Style="{StaticResource KynxaProjectActionButtonStyle}" Width="28" Height="28"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                services:UiLocalization.AutomationName="搜索项目" services:UiLocalization.ToolTip="搜索项目">
                            <FontIcon x:Name="ProjectSearchGlyph" Glyph="&#xE721;" FontSize="14" />
                        </Button>
                        <Button x:Name="AddProjectButton" Grid.Column="3" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False"
                                services:UiLocalization.AutomationName="添加项目" services:UiLocalization.ToolTip="添加项目">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <controls:ThemeIcon Width="18" Height="18" IconKey="IconFolderAdd" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="AddProjectMenu_Opened" Closed="AddProjectMenu_Closed"
                                            MenuFlyoutPresenterStyle="{StaticResource KynxaProjectMenuPresenterStyle}">
                                    <MenuFlyoutItem services:UiLocalization.Text="新建空白项目" Click="NewBlankProject_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem services:UiLocalization.Text="使用现有文件夹" Click="UseExistingProjectFolder_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TreeView x:Name="ProjectTree" KeyDown="SidebarSearchResults_KeyDown" Grid.Row="4" SelectionMode="None" ItemsSource="{x:Bind VisibleProjectEntries}"
                              Padding="0" BorderThickness="0" MinHeight="0" VerticalAlignment="Top"
                              ItemContainerStyle="{StaticResource WorkProjectTreeItemStyle}"
                              CanDragItems="False" CanReorderItems="False" ItemInvoked="ProjectTree_ItemInvoked"
                              Collapsed="ProjectTree_Collapsed" Expanding="ProjectTree_Expanding"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              services:UiLocalization.AutomationName="项目及项目内聊天">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProjectTreeEntry">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
