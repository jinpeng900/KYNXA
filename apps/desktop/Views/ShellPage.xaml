<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KYNXA_Desktop.Views.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:KYNXA_Desktop.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="using:KYNXA_Desktop.ViewModels" xmlns:services="using:KYNXA_Desktop.Services" x:Name="PageRoot" Language="zh-CN" FontFamily="{StaticResource KynxaUIFont}" FontSize="14" Foreground="{StaticResource KynxaTextBrush}" Background="{StaticResource KynxaMainBrush}" Loaded="PageRoot_Loaded" mc:Ignorable="d">

    <Grid x:Name="ShellGrid" SizeChanged="ShellGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar slot -->
        <Grid x:Name="SidebarSurface" Grid.Column="0" Background="{StaticResource KynxaSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid x:Name="GlobalSidebarHeader" Margin="8,0">
                <Button x:Name="CompactSidebarButton" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="SidebarToggle_Click"
                        AutomationProperties.Name="展开侧栏" ToolTipService.ToolTip="展开侧栏">
                    <Image Width="20" Height="20" Source="{StaticResource IconSidebarToggle}" />
                </Button>
                <!-- Kimi medium segmented control: 36 high, 2 inset, equal 32-high halves. -->
                <Border x:Name="ChatWorkSwitcher" Height="36" Padding="2"
                        Background="{StaticResource KynxaSegmentIdleBrush}" CornerRadius="10">
                    <Grid x:Name="ModeSwitchTrack" SizeChanged="ModeSwitchTrack_SizeChanged">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="PrimaryModeSelectionPill" Grid.ColumnSpan="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{StaticResource KynxaSurfaceBrush}" CornerRadius="8"
                                IsHitTestVisible="False">
                            <Border.TranslationTransition>
                                <Vector3Transition Duration="0:0:0.18" />
                            </Border.TranslationTransition>
                        </Border>
                        <Button x:Name="WorkModeButton" Click="WorkModeButton_Click"
                                AutomationProperties.Name="工作模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                                <TextBlock Text="工作" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChatModeButton" Grid.Column="1" Click="ChatModeButton_Click"
                                AutomationProperties.Name="聊天模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                <TextBlock Text="聊天" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SidebarNavigationScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="GlobalNavigationArea" HorizontalAlignment="Stretch">

                <Button Style="{StaticResource KynxaNavigationButtonStyle}" Tag="知识库" Click="PlannedModule_Click" ToolTipService.ToolTip="知识库 · 规划中">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconKnowledge}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" Text="知识库" /></Grid>
                </Button>

                <Button Style="{StaticResource KynxaNavigationButtonStyle}" Tag="连接" Click="PlannedModule_Click" ToolTipService.ToolTip="连接 · 规划中">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconConnect}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" Text="连接" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}" Tag="定时任务" Click="PlannedModule_Click" ToolTipService.ToolTip="定时任务 · 规划中">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconScheduledTask}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" Text="定时任务" /></Grid>
                </Button>
                <Button Style="{StaticResource KynxaNavigationButtonStyle}" Tag="技能" Click="PlannedModule_Click" ToolTipService.ToolTip="技能 · 规划中">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconSkills}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" Text="技能" /></Grid>
                </Button>
                <Button Click="ModelManagementButton_Click" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconModelManagement}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" Text="模型管理" /></Grid>
                </Button>
            </StackPanel>
            </ScrollViewer>



            <Grid x:Name="RecentArea" Grid.Row="3" Margin="8,16,8,6">
                <Grid.Resources>
                    <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                    <Thickness x:Key="TreeViewItemPresenterPadding">0,0,16,0</Thickness>
                    <Thickness x:Key="TreeViewItemBorderThemeThickness">0</Thickness>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundDisabled" Color="Transparent" />
                </Grid.Resources>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="HistorySearchBox" PlaceholderText="搜索标题和内容" FontSize="12" Height="34"
                             CornerRadius="8" Padding="8,4" MaxLength="200" BorderBrush="{StaticResource KynxaDividerBrush}"
                             Background="{StaticResource KynxaSurfaceBrush}" TextChanged="HistorySearchBox_TextChanged"
                             AutomationProperties.Name="搜索项目和聊天" ToolTipService.ToolTip="搜索当前模式的标题和消息 · Ctrl+F" />
                </Grid>
                <ScrollViewer x:Name="WorkSidebarScrollViewer" Grid.Row="1" SizeChanged="WorkSidebarContent_SizeChanged"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="WorkSidebarContent" MinHeight="72">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="ProjectsHeader" Background="Transparent" PointerEntered="ProjectsHeader_PointerEntered"
                          PointerExited="ProjectsHeader_PointerExited" GotFocus="ProjectsHeader_GotFocus" LostFocus="ProjectsHeader_LostFocus">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <Button x:Name="ProjectsToggle" Click="ProjectsToggle_Click" Background="Transparent"
                                BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" AutomationProperties.Name="展开或收起项目">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="项目" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                <FontIcon x:Name="ProjectsChevron" Glyph="&#xE70D;" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddProjectButton" Grid.Column="1" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False"
                                AutomationProperties.Name="添加项目" ToolTipService.ToolTip="添加项目">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <Image Width="18" Height="18" Source="{StaticResource IconFolderAdd}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="AddProjectMenu_Opened" Closed="AddProjectMenu_Closed"
                                            MenuFlyoutPresenterStyle="{StaticResource KynxaProjectMenuPresenterStyle}">
                                    <MenuFlyoutItem Text="新建空白项目" Click="NewBlankProject_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="使用现有文件夹" Click="UseExistingProjectFolder_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="WorkHistoryEmpty" Grid.Row="1" Margin="8,10" FontSize="12" TextWrapping="Wrap"
                               Text="暂无关联项目，点击右上角 + 添加。" Foreground="{StaticResource KynxaSecondaryTextBrush}" Visibility="Collapsed" />
                    <TreeView x:Name="ProjectTree" Grid.Row="1" MaxHeight="320" SelectionMode="Single" ItemsSource="{x:Bind ProjectEntries}"
                              CanDragItems="False" CanReorderItems="False" ItemInvoked="ProjectTree_ItemInvoked"
                              Collapsed="ProjectTree_Collapsed" Expanding="ProjectTree_Expanding"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutomationProperties.Name="项目及项目内聊天">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProjectTreeEntry">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Title}">
                                    <Grid Height="40" Tag="{x:Bind}" Background="Transparent"
                                          Loaded="ProjectRow_OrderLoaded" Unloaded="ProjectRow_OrderUnloaded" PointerPressed="ProjectRow_OrderPressed"
                                          PointerReleased="ProjectRow_OrderReleased" PointerCanceled="ProjectRow_OrderCancelled"
                                          PointerCaptureLost="ProjectRow_OrderCancelled"
                                          PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                          GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Width="16" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ProjectOnlyVisibility}" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                        <TextBlock x:Name="ProjectRowTitle" Grid.Column="1" Text="{x:Bind Title}"
                                                   FontFamily="{StaticResource KynxaUIFont}" FontSize="14" FontWeight="Normal" LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <StackPanel x:Name="ProjectRowActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False"
                                                    VerticalAlignment="Center" Background="Transparent">
                                            <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Click="ProjectMore_Click" AutomationProperties.Name="{x:Bind MoreLabel}"
                                                    AutomationProperties.AutomationId="{x:Bind MoreId}" ToolTipService.ToolTip="{x:Bind MoreLabel}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Visibility="{x:Bind ProjectOnlyVisibility}"
                                                    Click="ProjectAddChat_Click" AutomationProperties.Name="在此项目中添加聊天"
                                                    AutomationProperties.AutomationId="{x:Bind AddChatId}" ToolTipService.ToolTip="添加聊天">
                                                <Image Width="18" Height="18" Source="{StaticResource IconChatAdd}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Height" Value="40" />
                                <Setter Property="MinHeight" Value="40" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                    <StackPanel x:Name="TasksSection" Grid.Row="2" Margin="8,16,8,12" Spacing="12">
                        <TextBlock Text="任务" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        <TextBlock x:Name="WorkTasksPlaceholder" Text="任务会显示在这里" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        <ListView x:Name="WorkTaskHistory" ItemsSource="{x:Bind WorkTaskEntries}" Visibility="Collapsed"
                                  MaxHeight="160" Margin="-8,0,-8,0" SelectionMode="Single" IsItemClickEnabled="True"
                                  ItemClick="WorkTaskHistory_ItemClick" ItemContainerStyle="{StaticResource KynxaSidebarListItemStyle}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="未关联文件夹的工作任务">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:ProjectTreeEntry">
                                    <Grid Height="40" Tag="{x:Bind}" Background="Transparent"
                                          PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                          GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                        <TextBlock x:Name="ProjectRowTitle" Text="{x:Bind Title}" FontSize="14" LineHeight="20"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                        <StackPanel x:Name="ProjectRowActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="ProjectMore_Click"
                                                    AutomationProperties.Name="任务操作" AutomationProperties.AutomationId="{x:Bind MoreId}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
                <Grid x:Name="ChatSidebarContent" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="ChatHeader" PointerEntered="ChatHeader_PointerEntered" PointerExited="ChatHeader_PointerExited"
                          GotFocus="ChatHeader_GotFocus" LostFocus="ChatHeader_LostFocus" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Margin="8,4" Text="聊天" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        <Button x:Name="NewChatButton" Grid.Column="1" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False" Click="NewStandaloneChat_Click"
                                AutomationProperties.Name="新建聊天" ToolTipService.ToolTip="新建聊天">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <Image Width="18" Height="18" Source="{StaticResource IconChatAdd}" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ChatHistoryEmpty" Grid.Row="1" Margin="8,10" FontSize="12" TextWrapping="Wrap"
                               Text="还没有聊天记录，从一条消息开始。" Foreground="{StaticResource KynxaSecondaryTextBrush}" Visibility="Collapsed" />
                    <ListView x:Name="ChatHistoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentConversations}"
                              ItemContainerStyle="{StaticResource KynxaSidebarListItemStyle}" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ChatHistoryList_ItemClick"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="聊天历史">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentConversation">
                                <Grid Height="40" Tag="{x:Bind}" Background="Transparent"
                                      PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                      GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                    <TextBlock x:Name="ProjectRowTitle" Text="{x:Bind Title}" FontFamily="{StaticResource KynxaUIFont}"
                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <StackPanel x:Name="ProjectRowActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                        <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="StandaloneChatMore_Click"
                                                AutomationProperties.Name="聊天操作" AutomationProperties.AutomationId="{x:Bind MoreId}" ToolTipService.ToolTip="聊天操作">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>


            <Grid Grid.Row="4" Margin="14,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SidebarStatusColumn" Width="32" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource KynxaIconButtonStyle}" Click="StorageSettings_Click" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><Image Width="20" Height="20" Source="{StaticResource IconSettings}" /></Button>
                <Grid x:Name="GatewayStatusHost" Grid.Column="2" ToolTipService.ToolTip="正在连接模型服务">
                    <Image Width="20" Height="20" Source="{StaticResource IconDeviceStatus}" />
                    <Ellipse x:Name="GatewayStatusDot" Width="8" Height="8" Margin="0,0,0,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource KynxaSecondaryTextBrush}" Stroke="{StaticResource KynxaSidebarBrush}" StrokeThickness="1.5" />
                </Grid>
            </Grid>
        </Grid>

        <Button x:Name="SidebarDismissLayer" Grid.ColumnSpan="3" Visibility="Collapsed" Canvas.ZIndex="19"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Background="#18000000" BorderThickness="0" Click="DismissSidebar_Click" AutomationProperties.Name="收起侧栏" />
        <controls:ResizeGrip x:Name="SidebarGrip" Grid.Column="1" Axis="Horizontal" CancelRequested="SidebarGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="SidebarGrip_DragDelta" DragStarted="SidebarGrip_DragStarted" ResetRequested="SidebarGrip_ResetRequested" />

        <!-- Stable main slots: top workspace, primary content and optional preview. -->
        <Grid x:Name="MainRegion" Grid.Column="2" Background="{StaticResource KynxaMainBrush}" SizeChanged="MainRegion_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopWorkspaceRow" Height="96" />
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="TopContextSlot" />

                <Grid x:Name="TopToolbarSlot" HorizontalAlignment="Right" />
            </Grid>

            <controls:ResizeGrip x:Name="TopWorkspaceGrip" Grid.Row="1" Axis="Vertical" CancelRequested="TopWorkspaceGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="TopWorkspaceGrip_DragDelta" DragStarted="TopWorkspaceGrip_DragStarted" ResetRequested="TopWorkspaceGrip_ResetRequested" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewGripColumn" Width="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PrimaryContentSlot" SizeChanged="PrimaryContentSlot_SizeChanged">
                    <InfoBar x:Name="ProjectNotice" IsOpen="False" IsClosable="True" Severity="Informational"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,12" MaxWidth="420"
                             Canvas.ZIndex="10">
                        <InfoBar.ActionButton>
                            <Button Content="撤销" Click="UndoSidebarChange_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock x:Name="ConversationTitle" Margin="24,16" VerticalAlignment="Top"
                               FontSize="14" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <Button x:Name="OpenWorkPanelButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,12,0" Canvas.ZIndex="2"
                            Style="{StaticResource KynxaCompactIconButtonStyle}" Click="OpenWorkPanelButton_Click"
                            AutomationProperties.Name="展开工作详情" ToolTipService.ToolTip="展开工作详情">
                        <Image Width="18" Height="18" Source="{StaticResource IconSidebarToggle}" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                        </Image>
                    </Button>
                    <Button x:Name="ConversationActionsButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,48,0" Canvas.ZIndex="2" Style="{StaticResource KynxaCompactIconButtonStyle}"
                            Click="ConversationActions_Click" AutomationProperties.Name="会话操作" ToolTipService.ToolTip="复制或导出会话">
                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                    </Button>
                    <ListView x:Name="ConversationMessages" ItemsSource="{x:Bind ActiveMessages}" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="False" Background="Transparent"
                              HorizontalAlignment="Center" Padding="4,16,16,30" Loaded="ConversationMessages_Loaded" Unloaded="ConversationMessages_Unloaded" SizeChanged="ConversationMessages_SizeChanged"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <!-- Keep text alive while selecting across offscreen messages. -->
                            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.Resources>
                            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,8" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ConversationMessageViewModel">
                                <Grid>
                                    <Grid Visibility="{x:Bind UserVisibility}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="4*" /></Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Padding="12,10" CornerRadius="12" Background="{StaticResource KynxaSegmentIdleBrush}"
                                                HorizontalAlignment="Right" AutomationProperties.Name="用户消息">
                                            <controls:MarkdownReply IsPlainText="True" FontSize="16" Text="{x:Bind Content}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnSpacing="10" Visibility="{x:Bind AssistantVisibility}" AutomationProperties.Name="助手回复">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource KynxaSegmentIdleBrush}" VerticalAlignment="Top">
                                            <Image Width="28" Height="28" Stretch="Uniform" Source="{StaticResource KynxaLogoImage}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,5,0,0" Spacing="8">
                                            <controls:MarkdownReply Text="{x:Bind Content}" Visibility="{x:Bind ReplyVisibility}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind WaitingVisibility}">
                                                <ProgressRing Width="14" Height="14" MinWidth="14" MinHeight="14" IsActive="{x:Bind IsWaiting}"
                                                              Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                <TextBlock Text="正在回复…" FontSize="14" LineHeight="22.4" VerticalAlignment="Center"
                                                           Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                <Button Content="停止" Tag="{x:Bind ConversationId}" Click="StopReply_Click"
                                                        Style="{StaticResource KynxaInlineActionStyle}" ToolTipService.ToolTip="停止等待这次回复" />
                                            </StackPanel>
                                            <Button Content="复制回复" Tag="{x:Bind Content}" Click="CopyMessage_Click" HorizontalAlignment="Left"
                                                    Style="{StaticResource KynxaInlineActionStyle}" Visibility="{x:Bind ReplyVisibility}" />
                                            <StackPanel Spacing="8" Visibility="{x:Bind ErrorVisibility}">
                                                <TextBlock Text="{x:Bind ErrorText}" FontSize="14" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                <Button Content="重试" Tag="{x:Bind ConversationId}" Click="RetryReply_Click" HorizontalAlignment="Left"
                                                        Height="28" Padding="10,0" FontSize="13" Background="{StaticResource KynxaSegmentIdleBrush}" BorderThickness="0" CornerRadius="6" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid x:Name="ChatAmbientLayer" IsHitTestVisible="False" Opacity="0.2">
                        <Ellipse x:Name="AmbientLargeWave" Width="870" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveBrush}" StrokeThickness="50" />
                        <Ellipse x:Name="AmbientSoftWave" Width="720" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveSoftBrush}" StrokeThickness="34" />
                    </Grid>

                    <Button x:Name="JumpToLatestButton" Visibility="Collapsed" Content="回到最新 ↓" Canvas.ZIndex="3"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="{StaticResource KynxaSurfaceBrush}"
                            Style="{StaticResource KynxaOutlineButtonStyle}" Click="JumpToLatest_Click"
                            AutomationProperties.Name="回到最新消息" ToolTipService.ToolTip="回到最新消息" />




                    <StackPanel x:Name="MainContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="32">
                        <Grid x:Name="LogoHost" Width="176" Height="132" HorizontalAlignment="Center">
                            <Image x:Name="KynxaLogo" Width="353" Height="235" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource KynxaLogoImage}" Stretch="Uniform" />
                        </Grid>

                        <StackPanel x:Name="HomeIntro" Spacing="10" HorizontalAlignment="Center">
                            <TextBlock x:Name="HomeTitle" Text="从一个想法开始" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="HomeDescription" Text="选择模型，描述需求，让工作有条理地开始。" FontSize="13"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <StackPanel x:Name="HomeActions" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <Button Content="开始聊天" Click="StartChat_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                                <Button Content="选择工作" Click="StartWork_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <controls:ComposerSurface x:Name="ComposerHost" AutomationProperties.Name="对话输入区">
                            <controls:ComposerSurface.Body>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
                                    <TextBox x:Name="PromptTextBox" Margin="46,8,10,0" Padding="6,2,24,2" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="{StaticResource KynxaEditorFontSize}" Foreground="{StaticResource KynxaTextBrush}" PlaceholderText="向 KYNXA 提问任何问题..." ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}" TextChanged="PromptTextBox_TextChanged" TextCompositionStarted="PromptTextBox_TextCompositionStarted" TextCompositionEnded="PromptTextBox_TextCompositionEnded" TextWrapping="Wrap">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <Button x:Name="ComposerExpandButton" Style="{StaticResource KynxaCompactIconButtonStyle}" Margin="12,8,0,0" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ComposerExpandButton_Click" CornerRadius="7" ToolTipService.ToolTip="展开输入区">
                                        <FontIcon x:Name="ComposerExpandIcon" FontSize="14" Glyph="" />
                                    </Button>

                                    <Grid Grid.Row="1" Margin="12,0,12,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                                            <Button Style="{StaticResource KynxaComposerAddButtonStyle}" Click="AttachmentInfo_Click" ToolTipService.ToolTip="附件 · 规划中" AutomationProperties.Name="附件功能说明"><Image Width="20" Height="20" Source="{StaticResource IconAdd}" /></Button>
                                            <Button x:Name="PermissionPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    Click="PermissionPickerButton_Click" AutomationProperties.Name="当前能力：文本对话">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Image x:Name="SelectedPermissionIcon" Width="16" Height="16" Source="{StaticResource IconPermissionAsk}" />
                                                    <TextBlock x:Name="SelectedPermissionLabel" Text="文本对话" FontSize="14"
                                                               VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Margin="12,0,0,0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button x:Name="ModelPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    Click="ModelPickerButton_Click" AutomationProperties.Name="模型选择" ToolTipService.ToolTip="模型选择">
                                                <Grid ColumnSpacing="6" MaxWidth="220" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedModelLabel" VerticalAlignment="Center" FontFamily="{StaticResource KynxaUIFont}"
                                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                               Text="模型选择" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                                                              Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource KynxaComposerSendButtonStyle}" x:Name="SendButton" AutomationProperties.Name="发送" Click="SendButton_Click" ToolTipService.ToolTip="发送">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="KynxaSendHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="KynxaSendPressedBrush" />
                                                </Button.Resources>
                                                <Image Width="20" Height="20" Source="{StaticResource IconSend}" />
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <controls:ResizeGrip x:Name="ComposerLeftGrip" Grid.RowSpan="2" HorizontalAlignment="Left" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerLeftGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerRightGrip" Grid.RowSpan="2" HorizontalAlignment="Right" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerRightGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerTopGrip" Grid.RowSpan="2" VerticalAlignment="Top" Axis="Vertical" CancelRequested="ComposerHeightGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerTopGrip_DragDelta" DragStarted="ComposerHeightGrip_DragStarted" ResetRequested="ComposerHeightGrip_ResetRequested" />
                                </Grid>
                            </controls:ComposerSurface.Body>
                            <controls:ComposerSurface.Footer>
                                <Button x:Name="WorkspacePickerButton" Visibility="Collapsed" MaxWidth="240"
                                        Style="{StaticResource KynxaWorkspacePickerButtonStyle}"
                                        Click="WorkspacePickerButton_Click" AutomationProperties.Name="选择工作区" ToolTipService.ToolTip="选择工作区">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /></Grid.ColumnDefinitions>
                                        <Image Width="16" Height="16" Source="{StaticResource IconWork}" />
                                        <TextBlock x:Name="WorkspacePickerLabel" Grid.Column="1" Text="选择项目" FontSize="14"
                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    </Grid>
                                </Button>
                            </controls:ComposerSurface.Footer>
                        </controls:ComposerSurface>
                        <Grid x:Name="ModelStatusBar" ColumnSpacing="8" Margin="4,0" SizeChanged="PrimaryContentSlot_SizeChanged" AutomationProperties.LiveSetting="Polite">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ModelStatusText" Text="正在连接模型服务…" FontSize="12" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <Button x:Name="ModelRetryButton" Grid.Column="1" Content="重试" Visibility="Collapsed" Click="ModelRetry_Click" Style="{StaticResource KynxaInlineActionStyle}" />
                            <Button x:Name="ModelSetupButton" Grid.Column="2" Content="配置模型" Click="ModelSetup_Click" Style="{StaticResource KynxaInlineActionStyle}" />
                        </Grid>
                        <StackPanel x:Name="HomeExamples" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <Button Content="解释一段代码" Tag="请解释下面这段代码的用途和执行过程：" Click="ExamplePrompt_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                            <Button Content="制定任务计划" Tag="请根据下面的目标，帮我拆分任务步骤和验收标准：" Click="ExamplePrompt_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <controls:ResizeGrip x:Name="WorkPanelGrip" Grid.Column="1" Axis="Horizontal" Width="10" Visibility="Collapsed"
                                     HorizontalAlignment="Center" Canvas.ZIndex="5" AlwaysShowIndicator="True"
                                     IndicatorBrush="{StaticResource KynxaWorkPanelDividerBrush}"
                                     AutomationProperties.Name="调整右侧栏宽度" ToolTipService.ToolTip="拖动调整宽度，双击恢复默认"
                                     DragStarted="WorkPanelGrip_DragStarted" DragDelta="WorkPanelGrip_DragDelta"
                                     DragCompleted="LayoutGrip_DragCompleted" CancelRequested="WorkPanelGrip_CancelRequested"
                                     ResetRequested="WorkPanelGrip_ResetRequested" />
                <Border x:Name="WorkContextPanel" Grid.Column="2" Visibility="Collapsed" Canvas.ZIndex="8"
                        BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1,0,0,0"
                        Background="{StaticResource KynxaSurfaceBrush}" AutomationProperties.Name="工作详情">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="工作详情" Margin="20,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button x:Name="CloseWorkPanelButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,7,7,0"
                                Style="{StaticResource KynxaCompactIconButtonStyle}" Click="CloseWorkPanelButton_Click"
                                AutomationProperties.Name="关闭工作详情" ToolTipService.ToolTip="关闭工作详情">
                            <Image Width="18" Height="18" Source="{StaticResource IconSidebarToggle}" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                            </Image>
                        </Button>
                        <Grid Grid.Row="1" Margin="12,0,12,12" ColumnSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="WorkTasksTab" Content="任务" Tag="tasks" Click="WorkDetailTab_Click" Style="{StaticResource KynxaDetailTabStyle}" />
                            <Button x:Name="WorkFilesTab" Grid.Column="1" Content="文件" Tag="files" Click="WorkDetailTab_Click" Style="{StaticResource KynxaDetailTabStyle}" />
                            <Button x:Name="WorkResultsTab" Grid.Column="2" Content="结果" Tag="results" Click="WorkDetailTab_Click" Style="{StaticResource KynxaDetailTabStyle}" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" Padding="20,0,20,20" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="WorkDetailTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WorkDetailSubtitle" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="WorkTasksContent" Spacing="14">
                                    <Border Background="{StaticResource KynxaSegmentIdleBrush}" Padding="14" CornerRadius="8">
                                        <StackPanel Spacing="6"><TextBlock Text="当前状态" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" /><TextBlock x:Name="WorkRequestStatus" Text="等待输入" FontSize="14" TextWrapping="Wrap" /></StackPanel>
                                    </Border>
                                    <TextBlock x:Name="WorkRequestSummary" TextWrapping="Wrap" FontSize="13" />
                                    <TextBlock Text="工具执行暂未开放。你可以先在对话中梳理需求和任务步骤。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="WorkFilesContent" Visibility="Collapsed" Spacing="12">
                                    <TextBlock Text="关联文件夹" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    <TextBlock x:Name="WorkFolderPath" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="CopyWorkPathButton" Content="复制路径" Click="CopyWorkPath_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                                        <Button x:Name="RefreshWorkFilesButton" Content="刷新文件" Click="RefreshWorkFiles_Click" Style="{StaticResource KynxaOutlineButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="WorkFilesStatus" Text="点击刷新，查看文件夹中的一级文件。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <ListView x:Name="WorkFilesList" ItemsSource="{x:Bind WorkFiles}" SelectionMode="None"
                                              IsItemClickEnabled="True" ItemClick="WorkFilesList_ItemClick" HorizontalContentAlignment="Stretch"
                                              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="关联文件夹中的文件">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="services:WorkspaceFileEntry">
                                                <StackPanel Spacing="4" Padding="2,6">
                                                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock Text="点击小型文本文件可只读预览；目录和其他文件只显示信息，不会执行或自动发送给模型。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="WorkResultsContent" Visibility="Collapsed" Spacing="12">
                                    <TextBlock x:Name="WorkResultStatus" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WorkResultPreview" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Button x:Name="CopyWorkResultButton" Content="复制最近回复" Click="CopyWorkResult_Click" HorizontalAlignment="Left" Style="{StaticResource KynxaOutlineButtonStyle}" />
                                    <Button Content="导出会话" Click="ExportConversation_Click" HorizontalAlignment="Left" Style="{StaticResource KynxaOutlineButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
