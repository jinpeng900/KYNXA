                                              services:UiLocalization.AutomationHelp="{x:Bind PinStatusKey, Mode=OneWay}">
                                    <Grid Height="40" Tag="{x:Bind}" Background="Transparent"
                                          Loaded="ProjectRow_OrderLoaded" Unloaded="ProjectRow_OrderUnloaded" PointerPressed="ProjectRow_OrderPressed"
                                          PointerReleased="ProjectRow_OrderReleased" PointerCanceled="ProjectRow_OrderCancelled"
                                          PointerCaptureLost="ProjectRow_OrderCancelled"
                                          PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                          GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Visibility="{x:Bind UnpinnedProjectVisibility, Mode=OneWay}" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                        <Border x:Name="SidebarPinIndicator" Style="{StaticResource SidebarPinIndicatorStyle}"
                                                Visibility="{x:Bind PinnedVisibility, Mode=OneWay}" services:UiLocalization.ToolTip="已置顶">
                                            <controls:ThemeIcon IconKey="{x:Bind PinIconKey}" Foreground="{StaticResource KynxaAccentTextBrush}" />
                                        </Border>
                                        <TextBlock x:Name="ProjectRowTitle" Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                                                   FontFamily="{StaticResource KynxaUIFont}" FontSize="14" FontWeight="Normal" LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <StackPanel Spacing="6" MaxWidth="320">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind MountedFolderVisibility, Mode=OneWay}"
                                                                    AutomationProperties.HelpText="{x:Bind MountedFolderTooltip, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                            <TextBlock Text="{x:Bind MountedFolderName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind MountedFolderTooltip, Mode=OneWay}" TextWrapping="Wrap"
                                                                   Visibility="{x:Bind MountedFolderVisibility, Mode=OneWay}"
                                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>
                                        <StackPanel x:Name="ProjectRowActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False"
                                                    VerticalAlignment="Center" Background="Transparent">
                                            <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Click="ProjectMore_Click" AutomationProperties.Name="{x:Bind MoreLabel, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind MoreId}" ToolTipService.ToolTip="{x:Bind MoreLabel, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Visibility="{x:Bind ProjectOnlyVisibility}"
                                                    Click="ProjectAddChat_Click" services:UiLocalization.AutomationName="在此项目中添加聊天"
                                                    AutomationProperties.AutomationId="{x:Bind AddChatId}" services:UiLocalization.ToolTip="添加聊天">
                                                <controls:ThemeIcon Width="18" Height="18" IconKey="IconChatAdd" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock x:Name="ProjectSearchEmpty" Grid.Row="4" Height="32" FontSize="13" Margin="8,0,16,0"
                               Foreground="{StaticResource KynxaSecondaryTextBrush}" services:UiLocalization.Text="没有匹配结果"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <controls:ResizeGrip x:Name="WorkProjectsDivider" Grid.Row="1" Axis="Vertical" Tag="1" Margin="8,0,12,0"
                                         Visibility="Collapsed" AutomationProperties.AutomationId="WorkProjectsDivider"
                                         services:UiLocalization.AutomationName="调整项目和任务区域高度"
                                         services:UiLocalization.ToolTip="拖动调整区域高度，双击恢复默认四行"
                                         DragStarted="WorkSidebarDivider_DragStarted" DragDelta="WorkSidebarDivider_DragDelta"
                                         DragCompleted="WorkSidebarDivider_DragCompleted" CancelRequested="WorkSidebarDivider_CancelRequested"
                                         ResetRequested="WorkSidebarDivider_ResetRequested" />
                    <Grid x:Name="TasksSection" Grid.Row="2" Margin="0,4,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid x:Name="WorkTaskHeader" Background="Transparent"
                              PointerEntered="WorkTaskHeader_PointerEntered" PointerExited="WorkTaskHeader_PointerExited"
                              GotFocus="WorkTaskHeader_FocusChanged" LostFocus="WorkTaskHeader_FocusChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                            <Button x:Name="WorkTaskToggle" Grid.ColumnSpan="2" Click="WorkTaskToggle_Click" Style="{StaticResource KynxaSidebarHeaderButtonStyle}"
                                    services:UiLocalization.AutomationName="展开或收起任务" AutomationProperties.AutomationId="WorkTaskToggle">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <FontIcon x:Name="WorkTaskChevron" Glyph="&#xE70D;" FontSize="10" HorizontalAlignment="Center" />
                                    <Grid x:Name="WorkTaskTitleHost" Grid.Column="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <TextBlock services:UiLocalization.Text="任务" VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                        <TextBlock x:Name="WorkTaskCount" Grid.Column="1" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                        <TextBlock x:Name="WorkTaskProjectLabel" Grid.Column="2" VerticalAlignment="Center"
                                                   Visibility="Collapsed" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    </Grid>
                                </Grid>
                            </Button>
                            <controls:SidebarSearchBox x:Name="WorkTaskSearchBox" AutomationProperties.AutomationId="WorkTaskSearchBox" Tag="tasks" Grid.Column="1" Height="32" FontSize="13"
                                     Style="{StaticResource KynxaPopupSearchBoxStyle}" Padding="8,4" MinWidth="0" Visibility="Collapsed"
                                     services:UiLocalization.PlaceholderText="搜索当前任务" services:UiLocalization.AutomationName="请输入当前项目任务名称"
                                     TextChanged="SidebarSearch_TextChanged" KeyDown="SidebarSearch_KeyDown" KeyUp="SidebarSearch_KeyUp"
                                     TextCompositionStarted="SidebarSearch_CompositionStarted" TextCompositionEnded="SidebarSearch_CompositionEnded" />
                            <Button x:Name="WorkTaskSearchButton" AutomationProperties.AutomationId="WorkTaskSearchButton" Grid.Column="2" Tag="tasks" Click="SidebarSearch_Click"
                                    Style="{StaticResource KynxaProjectActionButtonStyle}" Width="28" Height="28"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    services:UiLocalization.AutomationName="搜索当前项目任务" services:UiLocalization.ToolTip="搜索当前项目任务">
                                <FontIcon x:Name="WorkTaskSearchGlyph" Glyph="&#xE721;" FontSize="14" />
                            </Button>
                            <Button x:Name="WorkTaskAddChatButton" Grid.Column="3" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsEnabled="False" Opacity="0" IsHitTestVisible="False"
                                    Click="WorkTaskAddChat_Click" AutomationProperties.Name="{services:UiText Key='在当前项目中添加聊天'}"
                                    services:UiLocalization.ToolTip="添加聊天">
                                <controls:ThemeIcon Width="18" Height="18" IconKey="IconChatAdd" />
                            </Button>
                        </Grid>
                        <ListView x:Name="WorkTaskHistory" KeyDown="SidebarSearchResults_KeyDown" ContainerContentChanging="SidebarRow_ContainerContentChanging" Grid.Row="1" ItemsSource="{x:Bind VisibleWorkTaskEntries}"
                                  Padding="0" BorderThickness="0" MinHeight="0" VerticalAlignment="Top"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="WorkChatHistory_ItemClick"
                                  ItemTemplate="{StaticResource WorkChatRowTemplate}"
                                  ItemContainerStyle="{StaticResource WorkChatListItemStyle}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{services:UiText Key='当前项目的聊天'}" />
                        <TextBlock x:Name="WorkTaskSearchEmpty" Grid.Row="1" Height="32" FontSize="13" Margin="8,0,16,0"
                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" services:UiLocalization.Text="没有匹配结果"
                                   Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
                </ScrollViewer>
                <Grid x:Name="ChatSidebarContent" Visibility="Collapsed" VerticalAlignment="Top"
                      SizeChanged="ChatSidebarContent_SizeChanged">
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid x:Name="ChatHeader" PointerEntered="ChatHeader_PointerEntered" PointerExited="ChatHeader_PointerExited"
                          GotFocus="ChatHeader_GotFocus" LostFocus="ChatHeader_LostFocus" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /><ColumnDefinition Width="28" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <Button x:Name="ChatHistoryToggle" Grid.ColumnSpan="2" Click="ChatHistoryToggle_Click" Style="{StaticResource KynxaSidebarHeaderButtonStyle}"
                                services:UiLocalization.AutomationName="展开或收起聊天" AutomationProperties.AutomationId="ChatHistoryToggle">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <FontIcon x:Name="ChatHistoryChevron" Glyph="&#xE70D;" FontSize="10" HorizontalAlignment="Center" />
                                <StackPanel x:Name="ChatTitleHost" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock services:UiLocalization.Text="聊天" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    <TextBlock x:Name="ChatHistoryCount" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource KynxaSecondaryTextBrush}" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <controls:SidebarSearchBox x:Name="ChatSearchBox" AutomationProperties.AutomationId="ChatSearchBox" Tag="chat" Grid.Column="1" Height="32" FontSize="13"
                                 Style="{StaticResource KynxaPopupSearchBoxStyle}" Padding="8,4" MinWidth="0" Visibility="Collapsed"
                                 services:UiLocalization.PlaceholderText="搜索聊天" services:UiLocalization.AutomationName="请输入聊天名称"
                                 TextChanged="SidebarSearch_TextChanged" KeyDown="SidebarSearch_KeyDown" KeyUp="SidebarSearch_KeyUp"
                                 TextCompositionStarted="SidebarSearch_CompositionStarted" TextCompositionEnded="SidebarSearch_CompositionEnded" />
                        <Button x:Name="ChatSearchButton" AutomationProperties.AutomationId="ChatSearchButton" Grid.Column="2" Tag="chat" Click="SidebarSearch_Click"
                                Style="{StaticResource KynxaProjectActionButtonStyle}" Width="28" Height="28"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                services:UiLocalization.AutomationName="搜索聊天" services:UiLocalization.ToolTip="搜索聊天">
                            <FontIcon x:Name="ChatSearchGlyph" Glyph="&#xE721;" FontSize="14" />
                        </Button>
                        <Button x:Name="NewChatButton" Grid.Column="3" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False" Click="NewStandaloneChat_Click"
                                services:UiLocalization.AutomationName="新建聊天" services:UiLocalization.ToolTip="新建聊天">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <controls:ThemeIcon Width="18" Height="18" IconKey="IconChatAdd" />
                        </Button>
                    </Grid>
                    <ListView x:Name="ChatHistoryList" KeyDown="SidebarSearchResults_KeyDown" ContainerContentChanging="SidebarRow_ContainerContentChanging" Grid.Row="1"
                              Padding="0" BorderThickness="0" MinHeight="0" VerticalAlignment="Top"
                              ItemContainerStyle="{StaticResource KynxaSidebarListItemStyle}" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ChatHistoryList_ItemClick"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              services:UiLocalization.AutomationName="聊天历史">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentConversation">
                                <Grid Height="{StaticResource KynxaSidebarRowHeight}" Tag="{x:Bind}" Background="Transparent" Unloaded="ProjectRow_Unloaded"
                                      services:UiLocalization.AutomationHelp="{x:Bind PinStatusKey}"
                                      PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                      GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Border x:Name="SidebarPinIndicator" Style="{StaticResource SidebarPinIndicatorStyle}"
                                            Visibility="{x:Bind PinnedVisibility}" services:UiLocalization.ToolTip="已置顶">
                                        <controls:ThemeIcon IconKey="IconPinnedChat" Foreground="{StaticResource KynxaAccentTextBrush}" />
                                    </Border>
                                    <TextBlock x:Name="ProjectRowTitle" Grid.Column="1" Text="{x:Bind Title}" FontFamily="{StaticResource KynxaUIFont}"
                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <StackPanel x:Name="ProjectRowActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                        <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="StandaloneChatMore_Click"
                                                services:UiLocalization.AutomationName="聊天操作" AutomationProperties.AutomationId="{x:Bind MoreId}" services:UiLocalization.ToolTip="聊天操作">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ChatSearchEmpty" Grid.Row="1" Height="32" FontSize="13" Margin="8,0,16,0"
                               Foreground="{StaticResource KynxaSecondaryTextBrush}" services:UiLocalization.Text="没有匹配结果"
                               Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>


            <Grid x:Name="SidebarFooter" Grid.Row="4" Margin="14,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource KynxaIconButtonStyle}" Click="StorageSettings_Click" services:UiLocalization.AutomationName="设置" services:UiLocalization.ToolTip="设置"><controls:ThemeIcon Width="20" Height="20" IconKey="IconSettings" /></Button>
                <Button x:Name="ModelStatusButton" Grid.Column="2" Style="{StaticResource KynxaIconButtonStyle}" Click="ModelStatusButton_Click">
                    <Grid>
                    <controls:ThemeIcon Width="20" Height="20" IconKey="IconDeviceStatus" />
                    <Ellipse x:Name="ModelStatusDot" Width="8" Height="8" Margin="0,0,0,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource KynxaMutedTextBrush}" Stroke="{StaticResource KynxaSidebarBrush}" StrokeThickness="1.5" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <controls:ResizeGrip x:Name="SidebarGrip" Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="238,0,0,0" Canvas.ZIndex="21"
                             Axis="Horizontal" IndicatorBrush="Transparent" CancelRequested="SidebarGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="SidebarGrip_DragDelta" DragStarted="SidebarGrip_DragStarted" ResetRequested="SidebarGrip_ResetRequested" />

        <Grid x:Name="MainRegion" Grid.Column="2" Background="{StaticResource KynxaMainBrush}" SizeChanged="MainRegion_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopWorkspaceRow" Height="0" />
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="TopContextSlot" />

                <Grid x:Name="TopToolbarSlot" HorizontalAlignment="Right" />
            </Grid>

            <controls:ResizeGrip x:Name="TopWorkspaceGrip" Grid.Row="1" Visibility="Collapsed" Axis="Vertical" CancelRequested="TopWorkspaceGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="TopWorkspaceGrip_DragDelta" DragStarted="TopWorkspaceGrip_DragStarted" ResetRequested="TopWorkspaceGrip_ResetRequested" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewGripColumn" Width="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PrimaryContentSlot" SizeChanged="PrimaryContentSlot_SizeChanged">
                    <!-- Stack independent feedback without covering a still-available Undo action.
                         独立提示纵向排列，避免遮盖仍可使用的撤销操作。 -->
                    <StackPanel VerticalAlignment="Top" Margin="16,54,16,0" Spacing="8" Canvas.ZIndex="12">
                        <controls:CompactInfoBar x:Name="ProjectNotice" IsOpen="False" IsClosable="True" Severity="Informational"
                                 Style="{StaticResource KynxaCompactInfoBarStyle}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,2,8,0" MaxWidth="480"
                                 Closed="ProjectNotice_Closed" AutomationProperties.AutomationId="ProjectNotice"
                                 Canvas.ZIndex="10">
                            <InfoBar.ActionButton>
                                <Button x:Name="ProjectNoticeUndoButton" Visibility="Collapsed" IsEnabled="False"
                                        Style="{StaticResource KynxaInfoBarActionButtonStyle}"
                                        services:UiLocalization.Content="撤销" services:UiLocalization.AutomationName="撤销"
                                        AutomationProperties.AutomationId="ProjectNoticeUndoButton" Click="UndoSidebarChange_Click" />
                            </InfoBar.ActionButton>
                        </controls:CompactInfoBar>
                        <Border x:Name="ActionFeedbackHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Padding="16,12" CornerRadius="{StaticResource KynxaMenuRadius}"
                                MaxWidth="480" Canvas.ZIndex="12" Background="{StaticResource KynxaSurfaceBrush}"
                                BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1" IsHitTestVisible="False">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" FontSize="18" Margin="0,1,0,0" VerticalAlignment="Top"
                                          Foreground="{StaticResource KynxaSecondaryTextBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="ActionFeedbackText" Grid.Column="1" FontSize="{StaticResource KynxaBodyFontSize}"
                                           LineHeight="{StaticResource KynxaBodyLineHeight}" Foreground="{StaticResource KynxaTextBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="ConversationTitle" Margin="24,16" VerticalAlignment="Top"
                               FontSize="14" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <Button x:Name="ConversationActionsButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,48,0" Style="{StaticResource KynxaCompactIconButtonStyle}" Click="ConversationActions_Click"
                            services:UiLocalization.AutomationName="会话操作" services:UiLocalization.ToolTip="会话操作">
                        <FontIcon Glyph="&#xE712;" FontSize="15" />
                    </Button>
                    <Button x:Name="OpenWorkPanelButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,12,0" Canvas.ZIndex="2"
                            Style="{StaticResource KynxaCompactIconButtonStyle}" Click="OpenWorkPanelButton_Click"
                            services:UiLocalization.AutomationName="展开右侧栏" services:UiLocalization.ToolTip="展开右侧栏">
                        <controls:ThemeIcon Width="18" Height="18" IconKey="IconSidebarToggle" RenderTransformOrigin="0.5,0.5">
                            <controls:ThemeIcon.RenderTransform><ScaleTransform ScaleX="-1" /></controls:ThemeIcon.RenderTransform>
                        </controls:ThemeIcon>
                    </Button>
                    <controls:ConversationTranscript x:Name="ConversationMessages" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                    <Grid x:Name="ChatAmbientLayer" IsHitTestVisible="False" Opacity="0.32">
                        <Ellipse x:Name="AmbientLargeWave" Width="870" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveBrush}" StrokeThickness="50" />
                        <Ellipse x:Name="AmbientSoftWave" Width="720" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveSoftBrush}" StrokeThickness="34" />
                    </Grid>

                    <!-- Reserved for the durable work history surface.
                         预留给可持久保存的工作历史视图。
                    -->




                    <StackPanel x:Name="MainContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Grid x:Name="LogoHost" Width="176" Height="132" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Image x:Name="KynxaLogo" Width="353" Height="235" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource KynxaLogoImage}" Stretch="Uniform" />
                        </Grid>

                        <controls:ConversationPromptQueue x:Name="PromptQueue" Margin="16,0,16,0" HorizontalAlignment="Stretch" />
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel x:Name="InlineApprovalHost" Visibility="Collapsed" Margin="16,0,16,8"
                                        HorizontalAlignment="Stretch" SizeChanged="InlineApprovalHost_SizeChanged" />
                        <controls:ComposerSurface x:Name="ComposerHost" Grid.Row="1" IsFooterVisible="True" services:UiLocalization.AutomationName="对话输入区">
                            <controls:ComposerSurface.Body>
                                <Grid>
                                    <!-- Size the action row from its controls and margin so the circular Send button is never clipped.
                                         操作行按控件和留白的实际高度布局，避免圆形发送按钮被裁切。 -->
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <controls:ConversationAttachmentDrafts x:Name="ComposerAttachments" />
                                    <TextBox x:Name="PromptTextBox" Grid.Row="1" MinWidth="0" MinHeight="0" Margin="46,8,10,4" Padding="6,2,24,2" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="{StaticResource KynxaEditorFontSize}" Foreground="{StaticResource KynxaTextBrush}" PlaceholderText="{services:UiText Key='描述你想完成的工作...'}" AutomationProperties.Name="{Binding PlaceholderText, ElementName=PromptTextBox}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}" TextChanged="PromptTextBox_TextChanged" TextCompositionStarted="PromptTextBox_TextCompositionStarted" TextCompositionEnded="PromptTextBox_TextCompositionEnded" TextWrapping="Wrap">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <Button x:Name="ComposerExpandButton" Grid.Row="1" Style="{StaticResource KynxaCompactIconButtonStyle}" Margin="12,8,0,0" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ComposerExpandButton_Click" CornerRadius="8" services:UiLocalization.AutomationName="展开输入区" ToolTipService.ToolTip="{services:UiText Key='展开输入区'}">
                                        <FontIcon x:Name="ComposerExpandIcon" FontSize="14" Glyph="" />
                                    </Button>

                                    <Grid x:Name="ComposerToolbar" Grid.Row="2" Margin="12,0,12,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="ComposerToolbarLeft" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                                            <Button x:Name="ComposerAddButton" Style="{StaticResource KynxaComposerAddButtonStyle}"
                                                    Click="ComposerAddButton_Click" services:UiLocalization.AutomationName="添加附件" services:UiLocalization.ToolTip="添加附件">
                                                <controls:ThemeIcon Width="20" Height="20" IconKey="IconAdd" />
                                            </Button>
                                            <Button x:Name="PermissionPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    Click="PermissionPickerButton_Click" AutomationProperties.Name="{services:UiText Key='权限：请求批准'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <controls:ThemeIcon x:Name="SelectedPermissionIcon" Width="16" Height="16" IconKey="IconPermissionAsk" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                    <TextBlock x:Name="SelectedPermissionLabel" Text="{services:UiText Key='请求批准'}" FontSize="14"
                                                               VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid x:Name="ComposerModelArea" Grid.Column="1" Margin="12,0,0,0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button x:Name="ModelPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    HorizontalAlignment="Right" HorizontalContentAlignment="Stretch"
                                                    Click="ModelPickerButton_Click" AutomationProperties.Name="{services:UiText Key='模型选择'}" ToolTipService.ToolTip="{services:UiText Key='模型选择'}">
                                                <Grid ColumnSpacing="6" MaxWidth="220" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedModelLabel" VerticalAlignment="Center" FontFamily="{StaticResource KynxaUIFont}"
                                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                               Text="{services:UiText Key='模型选择'}" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                                                              Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource KynxaComposerSendButtonStyle}" x:Name="SendButton" IsEnabled="False" AutomationProperties.Name="{services:UiText Key='发送'}" Click="SendButton_Click" ToolTipService.ToolTip="{services:UiText Key='发送'}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="KynxaSendHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="KynxaSendPressedBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="KynxaSendDisabledBrush" />
                                                </Button.Resources>
                                                <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Scale the original 24-unit SVG geometry into the existing 20 DIP slot.
                                                         将原 24 单位 SVG 几何缩放到现有 20 DIP 空间。 -->
                                                    <Path x:Name="SendArrow" Width="20" Height="20" Stretch="None"
                                                          Data="M10,16.666667 V3.333333 M5,8.333333 L10,3.333333 L15,8.333333"
                                                          Stroke="{StaticResource KynxaDisabledTextBrush}" StrokeThickness="1.666667"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                    <FontIcon x:Name="StopReplyIcon" Glyph="&#xE71A;" FontSize="14" Foreground="{StaticResource KynxaOnAccentBrush}" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <controls:ResizeGrip x:Name="ComposerLeftGrip" Grid.RowSpan="3" HorizontalAlignment="Left" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerLeftGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerRightGrip" Grid.RowSpan="3" HorizontalAlignment="Right" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerRightGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerTopGrip" Grid.RowSpan="3" VerticalAlignment="Top" Axis="Vertical" IndicatorBrush="Transparent" CancelRequested="ComposerHeightGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerTopGrip_DragDelta" DragStarted="ComposerHeightGrip_DragStarted" ResetRequested="ComposerHeightGrip_ResetRequested" />
                                </Grid>
                            </controls:ComposerSurface.Body>
                            <controls:ComposerSurface.Footer>
                                <Button x:Name="WorkspacePickerButton" IsEnabled="False" MaxWidth="240"
                                        Style="{StaticResource KynxaWorkspacePickerButtonStyle}"
                                        Click="WorkspacePickerButton_Click" AutomationProperties.Name="{services:UiText Key='选择工作区'}" services:UiLocalization.ToolTip="选择工作区">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /></Grid.ColumnDefinitions>
                                        <controls:ThemeIcon Width="16" Height="16" IconKey="IconWork" />
                                        <TextBlock x:Name="WorkspacePickerLabel" Grid.Column="1" Text="{services:UiText Key='选择项目'}" FontSize="14"
                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    </Grid>
                                </Button>
                            </controls:ComposerSurface.Footer>
                        </controls:ComposerSurface>
                        </Grid>
                        <TextBlock services:UiLocalization.Text="Enter 发送 · Shift+Enter 换行" FontSize="11"
                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" HorizontalAlignment="Center" />
                        <controls:ConversationUsageSummary x:Name="UsageSummary" Margin="16,0,16,0"
                                                           Visibility="Collapsed" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
                <Button x:Name="WorkPanelScrim" Grid.ColumnSpan="3" Canvas.ZIndex="12" Visibility="Collapsed"
                        Style="{StaticResource ShellTransparentScrimStyle}" Click="WorkPanelScrim_Click"
                        services:UiLocalization.AutomationName="收起右侧栏" />
                <controls:ResizeGrip x:Name="WorkPanelGrip" Grid.Column="1" Axis="Horizontal" Width="10" Visibility="Collapsed"
                                     HorizontalAlignment="Center" Canvas.ZIndex="5" AlwaysShowIndicator="True"
                                     IndicatorBrush="{StaticResource KynxaWorkPanelDividerBrush}"
                                     services:UiLocalization.AutomationName="调整右侧栏宽度" services:UiLocalization.ToolTip="拖动调整宽度，双击恢复默认"
                                     DragStarted="WorkPanelGrip_DragStarted" DragDelta="WorkPanelGrip_DragDelta"
                                     DragCompleted="LayoutGrip_DragCompleted" CancelRequested="WorkPanelGrip_CancelRequested"
                                     ResetRequested="WorkPanelGrip_ResetRequested" />
                <Border x:Name="WorkContextPanel" Grid.Column="2" Canvas.ZIndex="14" Visibility="Collapsed"
                        Background="{StaticResource KynxaSurfaceBrush}" BorderBrush="{StaticResource KynxaDividerBrush}"
                        BorderThickness="1" CornerRadius="16" Margin="0,0,6,6"
                        services:UiLocalization.AutomationName="工作右侧栏">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <controls:MountedWorkspaceHeader x:Name="MountedWorkspace" Margin="8,6,124,6" />
                        <Button Content="工作台" Click="ExpansionWorkbench_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,42,0" Padding="10,5" FontSize="12" Height="32" MinWidth="0" MinHeight="0" CornerRadius="10"
                                Background="{StaticResource KynxaSelectionBrush}" Foreground="{StaticResource KynxaAccentTextBrush}"
                                Style="{StaticResource KynxaQuietButtonStyle}"
                                services:UiLocalization.AutomationName="打开工作台" services:UiLocalization.ToolTip="打开工作台" />
                        <Grid x:Name="WorkContextModulesHost" Grid.Row="1" Margin="10,2,10,10" SizeChanged="WorkContextModulesHost_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="WorkTaskRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="WorkFileTabsRow" Height="Auto" MinHeight="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:ConversationTaskPanel x:Name="TaskPanel" Visibility="Collapsed" />
                            <controls:ResizeGrip x:Name="TaskRegionGrip" Grid.Row="1" Axis="Vertical" Visibility="Collapsed"
                                                 services:UiLocalization.AutomationName="调整任务区高度"
                                                 services:UiLocalization.ToolTip="拖动调整高度，双击恢复默认"
                                                 DragStarted="TaskRegionGrip_DragStarted" DragDelta="TaskRegionGrip_DragDelta"
                                                 DragCompleted="LayoutGrip_DragCompleted" CancelRequested="TaskRegionGrip_CancelRequested"
                                                 ResetRequested="TaskRegionGrip_ResetRequested" />
                            <controls:ConversationWorkTabs x:Name="WorkTabs" Grid.Row="2" Margin="0,4,0,4" />
                            <Grid Grid.Row="3" CornerRadius="14" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1"
                                  Background="{StaticResource KynxaMainBrush}">
                                <controls:ConversationScreenshotsPanel x:Name="ScreenshotPanel" />
                                <controls:ConversationDocumentPanel x:Name="DocumentPanel" Visibility="Collapsed" />
                                <controls:ConversationWorkspaceTerminal x:Name="WorkspaceTerminal" Visibility="Collapsed" />
                                <controls:ConversationWorkspaceHome x:Name="WorkspaceHome" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <Button x:Name="CloseWorkPanelButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,8,0" Width="30" Height="30" CornerRadius="10"
                                Style="{StaticResource KynxaCompactIconButtonStyle}" Click="CloseWorkPanelButton_Click"
                                services:UiLocalization.AutomationName="收起右侧栏" services:UiLocalization.ToolTip="收起右侧栏">
                            <controls:ThemeIcon Width="18" Height="18" IconKey="IconSidebarToggle" RenderTransformOrigin="0.5,0.5">
                                <controls:ThemeIcon.RenderTransform><ScaleTransform ScaleX="-1" /></controls:ThemeIcon.RenderTransform>
                            </controls:ThemeIcon>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
