<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KYNXA_Desktop.Views.ShellPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:KYNXA_Desktop.Services" xmlns:controls="using:KYNXA_Desktop.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModels="using:KYNXA_Desktop.ViewModels" x:Name="PageRoot" Language="zh-CN" FontFamily="{StaticResource KynxaUIFont}" FontSize="14" Foreground="{StaticResource KynxaTextBrush}" Background="{StaticResource KynxaMainBrush}" Loaded="PageRoot_Loaded" mc:Ignorable="d">

    <Grid x:Name="ShellGrid" Background="{StaticResource KynxaSidebarBrush}" SizeChanged="ShellGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar slot
             侧栏区域。
        -->
        <Button x:Name="SidebarScrim" Grid.ColumnSpan="3" Canvas.ZIndex="15" Visibility="Collapsed"
                Background="#22000000" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Click="SidebarScrim_Click" services:UiLocalization.AutomationName="收起侧栏" />
        <Grid x:Name="SidebarPane" Grid.Column="0" Canvas.ZIndex="20" Background="{StaticResource KynxaSidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid x:Name="GlobalSidebarHeader" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CompactSidebarButton" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="SidebarToggle_Click"
                        services:UiLocalization.AutomationName="展开侧栏" services:UiLocalization.ToolTip="展开侧栏">
                    <FontIcon Glyph="&#xE700;" FontSize="17" />
                </Button>
                <!-- Kimi medium segmented control: 36 high, 2 inset, equal 32-high halves.
                     采用 Kimi 风格中号分段控件：总高 36、内缩 2，两半等宽且各高 32。
                -->
                <Border x:Name="ChatWorkSwitcher" Height="36" Padding="2"
                        Background="{StaticResource KynxaSegmentIdleBrush}" CornerRadius="10">
                    <Grid x:Name="ModeSwitchTrack" SizeChanged="ModeSwitchTrack_SizeChanged">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                        </Grid.Resources>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="PrimaryModeSelectionPill" Grid.ColumnSpan="2"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{StaticResource KynxaSelectionBrush}" CornerRadius="8"
                                IsHitTestVisible="False">
                            <Border.TranslationTransition>
                                <Vector3Transition Duration="0:0:0.18" />
                            </Border.TranslationTransition>
                        </Border>
                        <Button x:Name="WorkModeButton" Click="WorkModeButton_Click"
                                Padding="6,0" services:UiLocalization.AutomationName="工作模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                                <TextBlock services:UiLocalization.Text="工作" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ChatModeButton" Grid.Column="1" Click="ChatModeButton_Click"
                                Padding="6,0" services:UiLocalization.AutomationName="聊天模式" Style="{StaticResource KynxaSegmentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                                <TextBlock services:UiLocalization.Text="聊天" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Button x:Name="CollapseSidebarButton" Grid.Column="1" Margin="4,0,0,0"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="SidebarToggle_Click"
                        services:UiLocalization.AutomationName="收起侧栏" services:UiLocalization.ToolTip="收起侧栏">
                    <FontIcon Glyph="&#xE76B;" FontSize="16" />
                </Button>
            </Grid>

            <StackPanel x:Name="GlobalNavigationArea" Grid.Row="1" HorizontalAlignment="Stretch">

                <Button Click="KnowledgeNavigation_Click" services:UiLocalization.AutomationName="知识库" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconKnowledge}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="知识库" /></Grid>
                </Button>

                <Button Click="ConnectionsNavigation_Click" services:UiLocalization.AutomationName="连接" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconConnect}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="连接" /></Grid>
                </Button>
                <Button Click="ScheduleNavigation_Click" services:UiLocalization.AutomationName="定时任务" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconScheduledTask}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="定时任务" /></Grid>
                </Button>
                <Button Click="SkillsNavigation_Click" services:UiLocalization.AutomationName="技能" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconSkills}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="技能" /></Grid>
                </Button>
                <Button Click="ModelManagementButton_Click" Style="{StaticResource KynxaNavigationButtonStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Width="18" Height="18" HorizontalAlignment="Left" Source="{StaticResource IconModelManagement}" /><TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="14" services:UiLocalization.Text="模型管理" /></Grid>
                </Button>
            </StackPanel>



            <Grid x:Name="RecentArea" Grid.Row="3" Margin="8,16,8,6">
                <Grid.Resources>
                    <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                    <Thickness x:Key="TreeViewItemPresenterPadding">0,0,16,0</Thickness>
                    <Thickness x:Key="TreeViewItemBorderThemeThickness">0</Thickness>
                    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForegroundDisabled" Color="Transparent" />
                    <!-- One opaque surface spans the chevron and content; active and hover never compound.
                         一层不透明背景同时覆盖展开箭头与内容，选中和悬停反馈不叠加。
                    -->
                    <Style x:Key="WorkProjectTreeItemStyle" TargetType="TreeViewItem">
                        <Setter Property="Height" Value="40" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="{StaticResource KynxaSidebarItemMargin}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="GlyphBrush" Value="{StaticResource KynxaSecondaryTextBrush}" />
                        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid x:Name="ContentPresenterGrid" Background="{TemplateBinding Background}"
                                          CornerRadius="{TemplateBinding CornerRadius}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected" />
                                                <VisualState x:Name="PointerOverSelected">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="PressedSelected">
                                                    <VisualState.Setters><Setter Target="PointerRowBackground.Visibility" Value="Visible" /></VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Disabled" />
                                                <VisualState x:Name="SelectedDisabled" />
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border x:Name="PointerRowBackground" Background="{StaticResource KynxaSelectionBrush}"
                                                Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                                CornerRadius="{TemplateBinding CornerRadius}" Visibility="Collapsed" IsHitTestVisible="False" />
                                        <Border x:Name="ActiveRowBackground" Background="{StaticResource KynxaSelectionBrush}"
                                                Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                                CornerRadius="{TemplateBinding CornerRadius}" Visibility="{Binding ActiveVisibility}"
                                                IsHitTestVisible="False" />
                                        <!-- Native names/settings keep expansion, keyboard navigation and indentation intact.
                                             保留原生名称和设置，确保展开、键盘导航与缩进行为不变。
                                        -->
                                        <Grid x:Name="MultiSelectGrid"
                                              Padding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.Indentation}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="MultiSelectCheckBox" Width="32" MinWidth="32" Visibility="Collapsed"
                                                      IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
                                            <Grid x:Name="ExpandCollapseChevron" Grid.Column="1" Padding="14,0" Background="Transparent"
                                                  Opacity="{TemplateBinding GlyphOpacity}">
                                                <TextBlock x:Name="CollapsedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="12" Height="12"
                                                           Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.CollapsedGlyphVisibility}"
                                                           FontSize="{TemplateBinding GlyphSize}" Text="{TemplateBinding CollapsedGlyph}"
                                                           FontFamily="{ThemeResource SymbolThemeFontFamily}" Padding="2" VerticalAlignment="Center"
                                                           AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False" />
                                                <TextBlock x:Name="ExpandedGlyph" Foreground="{TemplateBinding GlyphBrush}" Width="12" Height="12"
                                                           Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TreeViewItemTemplateSettings.ExpandedGlyphVisibility}"
                                                           FontSize="{TemplateBinding GlyphSize}" Text="{TemplateBinding ExpandedGlyph}"
                                                           FontFamily="{ThemeResource SymbolThemeFontFamily}" Padding="2" VerticalAlignment="Center"
                                                           AutomationProperties.AccessibilityView="Raw" IsTextScaleFactorEnabled="False" IsHitTestVisible="False" />
                                            </Grid>
                                            <ContentPresenter x:Name="ContentPresenter" Grid.Column="2" Margin="0,0,16,0"
                                                              ContentTransitions="{TemplateBinding ContentTransitions}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="WorkChatListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource KynxaSidebarListItemStyle}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                    <DataTemplate x:Key="WorkChatRowTemplate" x:DataType="viewModels:ProjectTreeEntry">
                        <Grid x:Name="WorkChatRowRoot" Height="40" Tag="{x:Bind}" Background="Transparent" Unloaded="ProjectRow_Unloaded"
                              PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                              GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                            <Border x:Name="WorkChatActiveBackground" CornerRadius="{StaticResource KynxaControlRadius}"
                                    Margin="{StaticResource KynxaSidebarSurfaceInset}"
                                    Background="{StaticResource KynxaSelectionBrush}" IsHitTestVisible="False"
                                    Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
                            <Grid Margin="8,0,16,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProjectRowTitle" Text="{x:Bind Title, Mode=OneWay}"
                                           FontFamily="{StaticResource KynxaUIFont}" FontSize="14" FontWeight="Normal"
                                           LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ContextTitle, Mode=OneWay}" />
                                <Ellipse Grid.Column="1" Width="5" Height="5" Margin="8,0,0,0" VerticalAlignment="Center"
                                         Fill="{StaticResource KynxaSecondaryTextBrush}" Visibility="{x:Bind ReplyingVisibility, Mode=OneWay}"
                                         services:UiLocalization.ToolTip="正在回复" services:UiLocalization.AutomationName="正在回复" />
                                <StackPanel x:Name="ProjectRowActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                    <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                    <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="ProjectMore_Click"
                                            services:UiLocalization.AutomationName="聊天操作" AutomationProperties.AutomationId="{x:Bind MoreId}"
                                            services:UiLocalization.ToolTip="聊天操作">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </Grid.Resources>
                <Grid x:Name="WorkSidebarContent" SizeChanged="WorkSidebarContent_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="WorkNavigationRow" Height="Auto" />
                        <RowDefinition x:Name="WorkNavigationGripRow" Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="WorkNavigationPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" /><RowDefinition x:Name="WorkRecentRow" Height="Auto" />
                            <RowDefinition x:Name="WorkRecentGripRow" Height="0" />
                            <RowDefinition Height="40" /><RowDefinition x:Name="WorkProjectsRow" Height="*" />
                        </Grid.RowDefinitions>
                    <Button x:Name="WorkRecentToggle" Height="32" Padding="8,4"
                            Style="{StaticResource KynxaQuietButtonStyle}" Click="WorkRecentToggle_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="{services:UiText Key='展开最近的工作聊天'}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock services:UiLocalization.Text="最近" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <FontIcon x:Name="WorkRecentChevron" Glyph="&#xE76C;" FontSize="10" />
                            <TextBlock x:Name="WorkRecentCount" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                                       VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <ListView x:Name="WorkRecentHistory" Grid.Row="1" ItemsSource="{x:Bind WorkRecentEntries}" Visibility="Collapsed"
                              SelectionMode="None" IsItemClickEnabled="True" ItemClick="WorkChatHistory_ItemClick"
                              ItemTemplate="{StaticResource WorkChatRowTemplate}"
                              ItemContainerStyle="{StaticResource WorkChatListItemStyle}"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              services:UiLocalization.AutomationName="所有工作中的最近聊天" />
                    <controls:ResizeGrip x:Name="WorkRecentGrip" Grid.Row="2" Axis="Vertical" Margin="8,0,16,0"
                                         Visibility="Collapsed" IndicatorBrush="#E4E4E4"
                                         DragStarted="WorkRecentGrip_DragStarted" DragDelta="WorkRecentGrip_DragDelta"
                                         DragCompleted="LayoutGrip_DragCompleted" CancelRequested="WorkRecentGrip_CancelRequested"
                                         ResetRequested="WorkRecentGrip_ResetRequested"
                                         services:UiLocalization.AutomationName="调整最近与项目区域高度"
                                         services:UiLocalization.ToolTip="上下拖动调整区域，双击恢复默认" />
                    <Grid x:Name="ProjectsHeader" Grid.Row="3" Margin="0,8,0,0" Height="32" Background="Transparent" PointerEntered="ProjectsHeader_PointerEntered"
                          PointerExited="ProjectsHeader_PointerExited" GotFocus="ProjectsHeader_GotFocus" LostFocus="ProjectsHeader_LostFocus">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <Button x:Name="ProjectsToggle" Click="ProjectsToggle_Click" Style="{StaticResource KynxaQuietButtonStyle}" Background="Transparent"
                                BorderThickness="0" Padding="8,4" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left" services:UiLocalization.AutomationName="展开或收起项目">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock services:UiLocalization.Text="项目" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                <FontIcon x:Name="ProjectsChevron" Glyph="&#xE70D;" FontSize="10" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddProjectButton" Grid.Column="1" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False"
                                services:UiLocalization.AutomationName="添加项目" services:UiLocalization.ToolTip="添加项目">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <Image Width="18" Height="18" Source="{StaticResource IconFolderAdd}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="AddProjectMenu_Opened" Closed="AddProjectMenu_Closed"
                                            MenuFlyoutPresenterStyle="{StaticResource KynxaProjectMenuPresenterStyle}">
                                    <MenuFlyoutItem services:UiLocalization.Text="新建空白项目" Click="NewBlankProject_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem services:UiLocalization.Text="使用现有文件夹" Click="UseExistingProjectFolder_Click" Style="{StaticResource KynxaWorkMenuItemStyle}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TreeView x:Name="ProjectTree" Grid.Row="4" SelectionMode="None" ItemsSource="{x:Bind ProjectEntries}"
                              ItemContainerStyle="{StaticResource WorkProjectTreeItemStyle}"
                              CanDragItems="False" CanReorderItems="False" ItemInvoked="ProjectTree_ItemInvoked"
                              Collapsed="ProjectTree_Collapsed" Expanding="ProjectTree_Expanding"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollMode="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              services:UiLocalization.AutomationName="项目及项目内聊天">
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ProjectTreeEntry">
                                <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
                                    <Grid Height="40" Tag="{x:Bind}" Background="Transparent"
                                          Loaded="ProjectRow_OrderLoaded" Unloaded="ProjectRow_OrderUnloaded" PointerPressed="ProjectRow_OrderPressed"
                                          PointerReleased="ProjectRow_OrderReleased" PointerCanceled="ProjectRow_OrderCancelled"
                                          PointerCaptureLost="ProjectRow_OrderCancelled"
                                          PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                          GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Width="16" Height="20" Margin="0,0,6,0" VerticalAlignment="Center"
                                                  Visibility="{x:Bind ProjectOnlyVisibility}" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                        <TextBlock x:Name="ProjectRowTitle" Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                                                   FontFamily="{StaticResource KynxaUIFont}" FontSize="14" FontWeight="Normal" LineHeight="20"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <ToolTipService.ToolTip>
                                                <ToolTip>
                                                    <StackPanel Spacing="6" MaxWidth="320">
                                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" Spacing="7" Visibility="{x:Bind MountedFolderVisibility, Mode=OneWay}"
                                                                    AutomationProperties.HelpText="{x:Bind MountedFolderTooltip, Mode=OneWay}">
                                                            <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                            <TextBlock Text="{x:Bind MountedFolderName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{x:Bind MountedFolderTooltip, Mode=OneWay}" TextWrapping="Wrap"
                                                                   Visibility="{x:Bind MountedFolderVisibility, Mode=OneWay}"
                                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </ToolTip>
                                            </ToolTipService.ToolTip>
                                        </TextBlock>
                                        <StackPanel x:Name="ProjectRowActions" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False"
                                                    VerticalAlignment="Center" Background="Transparent">
                                            <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Click="ProjectMore_Click" AutomationProperties.Name="{x:Bind MoreLabel, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="{x:Bind MoreId}" ToolTipService.ToolTip="{x:Bind MoreLabel, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}"
                                                    Visibility="{x:Bind ProjectOnlyVisibility}"
                                                    Click="ProjectAddChat_Click" services:UiLocalization.AutomationName="在此项目中添加聊天"
                                                    AutomationProperties.AutomationId="{x:Bind AddChatId}" services:UiLocalization.ToolTip="添加聊天">
                                                <Image Width="18" Height="18" Source="{StaticResource IconChatAdd}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    </Grid>
                    <controls:ResizeGrip x:Name="WorkNavigationGrip" Grid.Row="1" Axis="Vertical" Margin="8,0,16,0"
                                         IndicatorBrush="#E4E4E4"
                                         DragStarted="WorkNavigationGrip_DragStarted" DragDelta="WorkNavigationGrip_DragDelta"
                                         DragCompleted="LayoutGrip_DragCompleted" CancelRequested="WorkNavigationGrip_CancelRequested"
                                         ResetRequested="WorkNavigationGrip_ResetRequested"
                                         services:UiLocalization.AutomationName="调整项目与任务区域高度"
                                         services:UiLocalization.ToolTip="上下拖动调整区域，双击恢复默认" />
                    <Grid x:Name="TasksSection" Grid.Row="2" Margin="0,4,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="WorkTaskHeader" Margin="8,0,16,0" Background="Transparent"
                              PointerEntered="WorkTaskHeader_PointerEntered" PointerExited="WorkTaskHeader_PointerExited"
                              GotFocus="WorkTaskHeader_FocusChanged" LostFocus="WorkTaskHeader_FocusChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock services:UiLocalization.Text="任务" VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <TextBlock x:Name="WorkTaskProjectLabel" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="Collapsed" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <Button x:Name="WorkTaskAddChatButton" Grid.Column="2" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                    VerticalAlignment="Center" Visibility="Collapsed" IsEnabled="False" Opacity="0" IsHitTestVisible="False"
                                    Click="WorkTaskAddChat_Click" AutomationProperties.Name="{services:UiText Key='在当前项目中添加聊天'}"
                                    services:UiLocalization.ToolTip="添加聊天">
                                <Image Width="18" Height="18" Source="{StaticResource IconChatAdd}" />
                            </Button>
                        </Grid>
                        <ListView x:Name="WorkTaskHistory" Grid.Row="1" ItemsSource="{x:Bind WorkTaskEntries}"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="WorkChatHistory_ItemClick"
                                  ItemTemplate="{StaticResource WorkChatRowTemplate}"
                                  ItemContainerStyle="{StaticResource WorkChatListItemStyle}"
                                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{services:UiText Key='当前项目的聊天'}" />
                    </Grid>
                </Grid>
                <Grid x:Name="ChatSidebarContent" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="ChatHeader" PointerEntered="ChatHeader_PointerEntered" PointerExited="ChatHeader_PointerExited"
                          GotFocus="ChatHeader_GotFocus" LostFocus="ChatHeader_LostFocus" Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                        <TextBlock Margin="8,4" services:UiLocalization.Text="聊天" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        <Button x:Name="NewChatButton" Grid.Column="1" Style="{StaticResource KynxaProjectActionButtonStyle}"
                                Opacity="0" IsHitTestVisible="False" Click="NewStandaloneChat_Click"
                                services:UiLocalization.AutomationName="新建聊天" services:UiLocalization.ToolTip="新建聊天">
                            <Button.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></Button.OpacityTransition>
                            <Image Width="18" Height="18" Source="{StaticResource IconChatAdd}" />
                        </Button>
                    </Grid>
                    <ListView x:Name="ChatHistoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.RecentConversations}"
                              ItemContainerStyle="{StaticResource KynxaSidebarListItemStyle}" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="ChatHistoryList_ItemClick"
                              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              services:UiLocalization.AutomationName="聊天历史">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:RecentConversation">
                                <Grid Height="40" Tag="{x:Bind}" Background="Transparent" Unloaded="ProjectRow_Unloaded"
                                      PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
                                      GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus">
                                    <TextBlock x:Name="ProjectRowTitle" Text="{x:Bind Title}" FontFamily="{StaticResource KynxaUIFont}"
                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                    <StackPanel x:Name="ProjectRowActions" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Background="Transparent">
                                        <StackPanel.OpacityTransition><ScalarTransition Duration="0:0:0.12" /></StackPanel.OpacityTransition>
                                        <Button Style="{StaticResource KynxaProjectActionButtonStyle}" Tag="{x:Bind}" Click="StandaloneChatMore_Click"
                                                services:UiLocalization.AutomationName="聊天操作" AutomationProperties.AutomationId="{x:Bind MoreId}" services:UiLocalization.ToolTip="聊天操作">
                                            <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>


            <Grid x:Name="SidebarFooter" Grid.Row="4" Margin="14,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource KynxaIconButtonStyle}" Click="StorageSettings_Click" services:UiLocalization.AutomationName="设置" services:UiLocalization.ToolTip="设置"><Image Width="20" Height="20" Source="{StaticResource IconSettings}" /></Button>
                <Button x:Name="HistorySearchButton" Grid.Column="1" HorizontalAlignment="Center"
                        Style="{StaticResource KynxaIconButtonStyle}" Click="HistorySearch_Click"
                        services:UiLocalization.AutomationName="搜索会话" services:UiLocalization.ToolTip="搜索会话 Ctrl+F">
                    <FontIcon Glyph="&#xE721;" FontSize="17" />
                </Button>
                <Button x:Name="ModelStatusButton" Grid.Column="2" Style="{StaticResource KynxaIconButtonStyle}" Click="ModelStatusButton_Click">
                    <Grid>
                    <Image Width="20" Height="20" Source="{StaticResource IconDeviceStatus}" />
                    <Ellipse x:Name="ModelStatusDot" Width="8" Height="8" Margin="0,0,0,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#999999" Stroke="{StaticResource KynxaSidebarBrush}" StrokeThickness="1.5" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <controls:ResizeGrip x:Name="SidebarGrip" Grid.Column="1" Axis="Horizontal" IndicatorBrush="Transparent" CancelRequested="SidebarGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="SidebarGrip_DragDelta" DragStarted="SidebarGrip_DragStarted" ResetRequested="SidebarGrip_ResetRequested" />

        <!-- Stable main slots: top workspace, primary content and optional preview.
             主体固定为顶部工作区、主要内容以及可选预览区域。
        -->
        <Grid x:Name="MainRegion" Grid.Column="2" Background="{StaticResource KynxaMainBrush}" SizeChanged="MainRegion_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TopWorkspaceRow" Height="0" />
                <RowDefinition Height="0" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid x:Name="TopContextSlot" />

                <Grid x:Name="TopToolbarSlot" HorizontalAlignment="Right" />
            </Grid>

            <controls:ResizeGrip x:Name="TopWorkspaceGrip" Grid.Row="1" Visibility="Collapsed" Axis="Vertical" CancelRequested="TopWorkspaceGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="TopWorkspaceGrip_DragDelta" DragStarted="TopWorkspaceGrip_DragStarted" ResetRequested="TopWorkspaceGrip_ResetRequested" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="PreviewGripColumn" Width="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="PrimaryContentSlot" SizeChanged="PrimaryContentSlot_SizeChanged">
                    <InfoBar x:Name="ProjectNotice" IsOpen="False" IsClosable="True" Severity="Informational"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24,12" MaxWidth="420"
                             Canvas.ZIndex="10">
                        <InfoBar.ActionButton>
                            <Button services:UiLocalization.Content="撤销" Click="UndoSidebarChange_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <TextBlock x:Name="ConversationTitle" Margin="24,16" VerticalAlignment="Top"
                               FontSize="14" Foreground="{StaticResource KynxaSecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <Button x:Name="ConversationActionsButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,48,0" Style="{StaticResource KynxaCompactIconButtonStyle}" Click="ConversationActions_Click"
                            services:UiLocalization.AutomationName="会话操作" services:UiLocalization.ToolTip="会话操作">
                        <FontIcon Glyph="&#xE712;" FontSize="15" />
                    </Button>
                    <Border x:Name="ActionFeedbackHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="16,54,16,0" Padding="12,8" CornerRadius="8" MaxWidth="420" Canvas.ZIndex="12"
                            Background="{StaticResource KynxaSurfaceBrush}" IsHitTestVisible="False">
                        <TextBlock x:Name="ActionFeedbackText" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Button x:Name="OpenWorkPanelButton" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,12,0" Canvas.ZIndex="2"
                            Style="{StaticResource KynxaCompactIconButtonStyle}" Click="OpenWorkPanelButton_Click"
                            services:UiLocalization.AutomationName="展开右侧栏" services:UiLocalization.ToolTip="展开右侧栏">
                        <Image Width="18" Height="18" Source="{StaticResource IconSidebarToggle}" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                        </Image>
                    </Button>
                    <controls:ConversationTranscript x:Name="ConversationMessages" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                    <Grid x:Name="ChatAmbientLayer" IsHitTestVisible="False" Opacity="0.32">
                        <Ellipse x:Name="AmbientLargeWave" Width="870" Height="310" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveBrush}" StrokeThickness="50" />
                        <Ellipse x:Name="AmbientSoftWave" Width="720" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{StaticResource KynxaAmbientWaveSoftBrush}" StrokeThickness="34" />
                    </Grid>

                    <!-- Reserved for the durable work history surface.
                         预留给可持久保存的工作历史视图。
                    -->




                    <StackPanel x:Name="MainContentHost" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <Grid x:Name="LogoHost" Width="176" Height="132" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Image x:Name="KynxaLogo" Width="353" Height="235" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{StaticResource KynxaLogoImage}" Stretch="Uniform" />
                        </Grid>

                        <controls:ComposerSurface x:Name="ComposerHost" IsFooterVisible="True" services:UiLocalization.AutomationName="对话输入区">
                            <controls:ComposerSurface.Body>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="46" /></Grid.RowDefinitions>
                                    <TextBox x:Name="PromptTextBox" Margin="46,8,10,0" Padding="6,2,24,2" AcceptsReturn="True" Background="Transparent" BorderThickness="0" FontSize="{StaticResource KynxaEditorFontSize}" Foreground="{StaticResource KynxaTextBrush}" PlaceholderText="{services:UiText Key='描述你想完成的工作...'}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay}" TextChanged="PromptTextBox_TextChanged" TextCompositionStarted="PromptTextBox_TextCompositionStarted" TextCompositionEnded="PromptTextBox_TextCompositionEnded" TextWrapping="Wrap">
                                        <TextBox.Resources>
                                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                        </TextBox.Resources>
                                    </TextBox>

                                    <Button x:Name="ComposerExpandButton" Style="{StaticResource KynxaCompactIconButtonStyle}" Margin="12,8,0,0" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ComposerExpandButton_Click" CornerRadius="7" ToolTipService.ToolTip="{services:UiText Key='展开输入区'}">
                                        <FontIcon x:Name="ComposerExpandIcon" FontSize="14" Glyph="" />
                                    </Button>

                                    <Grid x:Name="ComposerToolbar" Grid.Row="1" Margin="12,0,12,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel x:Name="ComposerToolbarLeft" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="4">
                                            <Border Background="Transparent" services:UiLocalization.ToolTip="附件上传尚未开放，可直接粘贴文本或在项目菜单关联文件夹。">
                                                <Button x:Name="ComposerAddButton" IsEnabled="False" Style="{StaticResource KynxaComposerAddButtonStyle}"
                                                        services:UiLocalization.AutomationName="附件上传尚未开放">
                                                    <Image Width="20" Height="20" Source="{StaticResource IconAdd}" Opacity="0.55" />
                                                </Button>
                                            </Border>
                                            <Button x:Name="PermissionPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    Click="PermissionPickerButton_Click" AutomationProperties.Name="{services:UiText Key='权限：请求批准'}">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Image x:Name="SelectedPermissionIcon" Width="16" Height="16" Source="{StaticResource IconPermissionAsk}" />
                                                    <TextBlock x:Name="SelectedPermissionLabel" Text="{services:UiText Key='请求批准'}" FontSize="14"
                                                               VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Grid x:Name="ComposerModelArea" Grid.Column="1" Margin="12,0,0,0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Button x:Name="ModelPickerButton" Style="{StaticResource KynxaPickerButtonStyle}"
                                                    HorizontalAlignment="Right"
                                                    Click="ModelPickerButton_Click" AutomationProperties.Name="{services:UiText Key='模型选择'}" ToolTipService.ToolTip="{services:UiText Key='模型选择'}">
                                                <Grid ColumnSpacing="6" MaxWidth="220" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SelectedModelLabel" VerticalAlignment="Center" FontFamily="{StaticResource KynxaUIFont}"
                                                               FontSize="14" FontWeight="Normal" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                               Text="{services:UiText Key='模型选择'}" TextTrimming="CharacterEllipsis" />
                                                    <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center"
                                                              Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource KynxaComposerSendButtonStyle}" x:Name="SendButton" IsEnabled="False" AutomationProperties.Name="{services:UiText Key='发送'}" Click="SendButton_Click" ToolTipService.ToolTip="{services:UiText Key='发送'}">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="KynxaSendHoverBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="KynxaSendPressedBrush" />
                                                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="KynxaSendDisabledBrush" />
                                                </Button.Resources>
                                                <Grid>
                                                    <Image x:Name="SendArrow" Width="20" Height="20" Source="{StaticResource IconSendDisabled}" />
                                                    <FontIcon x:Name="StopReplyIcon" Glyph="&#xE71A;" FontSize="14" Foreground="White" Visibility="Collapsed" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <controls:ResizeGrip x:Name="ComposerLeftGrip" Grid.RowSpan="2" HorizontalAlignment="Left" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerLeftGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerRightGrip" Grid.RowSpan="2" HorizontalAlignment="Right" Axis="Horizontal" CancelRequested="ComposerWidthGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerRightGrip_DragDelta" DragStarted="ComposerWidthGrip_DragStarted" ResetRequested="ComposerWidthGrip_ResetRequested" />
                                    <controls:ResizeGrip x:Name="ComposerTopGrip" Grid.RowSpan="2" VerticalAlignment="Top" Axis="Vertical" IndicatorBrush="Transparent" CancelRequested="ComposerHeightGrip_CancelRequested" DragCompleted="LayoutGrip_DragCompleted" DragDelta="ComposerTopGrip_DragDelta" DragStarted="ComposerHeightGrip_DragStarted" ResetRequested="ComposerHeightGrip_ResetRequested" />
                                </Grid>
                            </controls:ComposerSurface.Body>
                            <controls:ComposerSurface.Footer>
                                <Button x:Name="WorkspacePickerButton" IsEnabled="False" MaxWidth="240"
                                        Style="{StaticResource KynxaWorkspacePickerButtonStyle}"
                                        Click="WorkspacePickerButton_Click" AutomationProperties.Name="{services:UiText Key='选择工作区'}" services:UiLocalization.ToolTip="选择工作区">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /></Grid.ColumnDefinitions>
                                        <Image Width="16" Height="16" Source="{StaticResource IconWork}" />
                                        <TextBlock x:Name="WorkspacePickerLabel" Grid.Column="1" Text="{services:UiText Key='选择项目'}" FontSize="14"
                                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                                    </Grid>
                                </Button>
                            </controls:ComposerSurface.Footer>
                        </controls:ComposerSurface>
                        <TextBlock services:UiLocalization.Text="Enter 发送 · Shift+Enter 换行" FontSize="11"
                                   Foreground="{StaticResource KynxaSecondaryTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <controls:ResizeGrip x:Name="WorkPanelGrip" Grid.Column="1" Axis="Horizontal" Width="10" Visibility="Collapsed"
                                     HorizontalAlignment="Center" Canvas.ZIndex="5" AlwaysShowIndicator="True"
                                     IndicatorBrush="{StaticResource KynxaWorkPanelDividerBrush}"
                                     services:UiLocalization.AutomationName="调整右侧栏宽度" services:UiLocalization.ToolTip="拖动调整宽度，双击恢复默认"
                                     DragStarted="WorkPanelGrip_DragStarted" DragDelta="WorkPanelGrip_DragDelta"
                                     DragCompleted="LayoutGrip_DragCompleted" CancelRequested="WorkPanelGrip_CancelRequested"
                                     ResetRequested="WorkPanelGrip_ResetRequested" />
                <Border x:Name="WorkContextPanel" Grid.Column="2" Visibility="Collapsed"
                        Background="{StaticResource KynxaSurfaceBrush}" services:UiLocalization.AutomationName="工作右侧栏">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <controls:MountedWorkspaceHeader x:Name="MountedWorkspace" Margin="10,3,40,0" />
                        <Grid x:Name="WorkContextModulesHost" Grid.Row="1" Margin="14,10,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <controls:ConversationWorkTabs x:Name="WorkTabs" />
                            <Grid Grid.Row="1">
                                <controls:ConversationScreenshotsPanel x:Name="ScreenshotPanel" />
                                <TextBlock x:Name="WorkTabEmptyHint" Text="{services:UiText Key='暂无预览内容。工具返回截图后会在此显示。'}"
                                           Foreground="{StaticResource KynxaSecondaryTextBrush}" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <Button x:Name="CloseWorkPanelButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,7,7,0"
                                Style="{StaticResource KynxaCompactIconButtonStyle}" Click="CloseWorkPanelButton_Click"
                                services:UiLocalization.AutomationName="收起右侧栏" services:UiLocalization.ToolTip="收起右侧栏">
                            <Image Width="18" Height="18" Source="{StaticResource IconSidebarToggle}" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform><ScaleTransform ScaleX="-1" /></Image.RenderTransform>
                            </Image>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
