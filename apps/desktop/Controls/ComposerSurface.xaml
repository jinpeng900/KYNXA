<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="KYNXA_Desktop.Controls.ComposerSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SurfaceRoot"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <!-- The backing spans both rows, filling the editor's lower corners without a seam.
             背景跨越两行，填满编辑器下方圆角而不留下接缝。
        -->
        <Border x:Name="FooterBackground" Grid.RowSpan="2" Visibility="Collapsed"
                Background="{StaticResource KynxaSegmentIdleBrush}" CornerRadius="{StaticResource KynxaComposerRadius}" />
        <Border x:Name="EditorSurface" Height="{Binding EditorHeight, ElementName=SurfaceRoot}"
                Background="{StaticResource KynxaSurfaceBrush}" BorderBrush="{StaticResource KynxaComposerBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource KynxaComposerRadius}" Translation="0,0,24">
            <Border.Shadow><ThemeShadow /></Border.Shadow>
            <ContentPresenter Content="{Binding Body, ElementName=SurfaceRoot}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
        <Border x:Name="FooterSurface" Grid.Row="1" Visibility="Collapsed"
                Height="{StaticResource KynxaComposerFooterHeight}" Padding="8,6">
            <ContentPresenter Content="{Binding Footer, ElementName=SurfaceRoot}"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
