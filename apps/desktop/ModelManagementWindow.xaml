<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KYNXA_Desktop.ModelManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KYNXA 模型管理">
    <Grid Background="{StaticResource KynxaMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="ModelTitleBar" Grid.Row="0" Background="{StaticResource KynxaSidebarBrush}">
            <TextBlock Text="KYNXA   /   模型管理" VerticalAlignment="Center" Margin="22,0" FontSize="13" />
        </Grid>
        <Grid Grid.Row="1" Padding="28,20,28,24" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource KynxaSidebarBrush}" CornerRadius="14" Padding="15">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="模型连接" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="已保存的 OpenAI 兼容连接" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" Margin="0,20,0,10" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProviderList" Spacing="6" />
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="＋ 新建连接" HorizontalAlignment="Stretch" Click="NewConnectionButton_Click" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="680" Spacing="14">
                    <TextBlock Text="连接设置" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="通过 DeepSeek Harness 调用模型。首阶段支持 OpenAI 兼容 API，可连接云端或本机服务。" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Ollama 本机预设" Click="LocalPresetButton_Click" />
                        <Button Content="自定义 API" Click="CustomPresetButton_Click" />
                    </StackPanel>
                    <TextBlock Text="连接名称" />
                    <TextBox x:Name="NameBox" PlaceholderText="例如 Ollama / DeepSeek API" />
                    <TextBlock Text="Provider ID（小写字母、数字、连字符）" />
                    <TextBox x:Name="ProviderIdBox" PlaceholderText="例如 ollama 或 deepseek" />
                    <TextBlock Text="Base URL（包含 /v1）" />
                    <TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.example.com/v1" />
                    <TextBlock Text="API Key（留空可保留已保存的 Key）" />
                    <PasswordBox x:Name="ApiKeyBox" PlaceholderText="本机服务可留空" />
                    <TextBlock Text="Model ID（每行一个；不支持模型列表接口时可手动填写）" />
                    <TextBox x:Name="ModelsBox" AcceptsReturn="True" Height="100" TextWrapping="Wrap" PlaceholderText="例如 deepseek-chat" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ProbeButton" Content="测试并获取模型" Click="TestConnectionButton_Click" />
                        <Button x:Name="SaveButton" Content="保存连接" Click="SaveConnectionButton_Click" Background="{StaticResource KynxaSendBrush}" Foreground="White" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="先填写连接，再测试或保存。" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                    <TextBlock Text="API Key 保存在本机 KYNXA Harness 数据目录；模型请求由本机网关发送，不在浏览器中保存密钥。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
