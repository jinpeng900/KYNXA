<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KYNXA_Desktop.ModelManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:KYNXA_Desktop.Services"
    Title="KYNXA">
    <Grid x:Name="WindowRoot" Background="{StaticResource KynxaMainBrush}" Loaded="WindowRoot_Loaded">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource KynxaQuietButtonStyle}">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="TokenLimitRowStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource KynxaSidebarBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="ModelTitleBar" Background="{StaticResource KynxaSidebarBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="22,0" VerticalAlignment="Center">
                <TextBlock Text="KYNXA" FontWeight="SemiBold" />
                <TextBlock Text="/" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                <TextBlock services:UiLocalization.Text="模型管理" />
            </StackPanel>
        </Grid>
        <Grid x:Name="ManagementLayout" Grid.Row="1" SizeChanged="ManagementLayout_SizeChanged">
            <Grid.RowDefinitions><RowDefinition x:Name="CompactConnectionsRow" Height="0" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConnectionsColumn" Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="ProviderPanel" Grid.Row="1" Background="{StaticResource KynxaSidebarBrush}" Padding="16,20,12,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel x:Name="ConnectionsHeading" Grid.ColumnSpan="2" Spacing="7" Margin="8,0,0,0">
                    <TextBlock services:UiLocalization.Text="我的连接" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionCount" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                </StackPanel>
                <Grid x:Name="SavedConnectionsList" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,18,0,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ProviderList" Spacing="4" /></ScrollViewer>
                    <StackPanel x:Name="EmptyConnections" Margin="8,12" Spacing="8" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="#888888" HorizontalAlignment="Left" />
                        <TextBlock services:UiLocalization.Text="还没有模型连接" TextWrapping="Wrap" />
                        <TextBlock services:UiLocalization.Text="选择服务商，&#xA;添加你的第一个模型。" TextWrapping="Wrap" FontSize="12" LineHeight="20" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
                <ComboBox x:Name="CompactConnectionPicker" Grid.Row="1" Visibility="Collapsed" Margin="0,0,8,0"
                          MinHeight="38" HorizontalAlignment="Stretch" FontFamily="{StaticResource KynxaUIFont}" FontSize="13"
                          CornerRadius="8" services:UiLocalization.PlaceholderText="选择已保存连接"
                          SelectionChanged="CompactConnectionPicker_SelectionChanged" services:UiLocalization.AutomationName="已保存的模型连接">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="services:ModelProvider">
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}" ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneTime}"
                                       MaxWidth="320" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="NewConnectionButton" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Background="{StaticResource KynxaSurfaceBrush}" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1" Click="NewConnectionButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="12" /><TextBlock services:UiLocalization.Text="添加连接" /></StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="EditorPanel" Grid.Row="1" Grid.Column="1" Padding="28,22,28,18" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="7">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="EditorTitle" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border x:Name="DraftStateBadge" Grid.Column="1" Background="{StaticResource KynxaReplySurfaceBrush}"
                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock x:Name="DraftStateText" FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        </Border>
                    </Grid>
                    <TextBlock services:UiLocalization.Text="连接你常用的模型，让 KYNXA 帮你完成工作。" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer x:Name="EditorScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="EditorForm" Spacing="18" Margin="0,0,12,8">
                        <Border Background="{StaticResource KynxaSidebarBrush}" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock services:UiLocalization.Text="服务商" FontWeight="SemiBold" />
                                <ComboBox x:Name="PresetBox" HorizontalAlignment="Stretch" FontFamily="{StaticResource KynxaUIFont}" FontSize="13" CornerRadius="8" MinHeight="38" SelectionChanged="PresetBox_SelectionChanged" services:UiLocalization.AutomationName="选择服务商">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:ModelPreset">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="PresetHint" TextWrapping="Wrap" FontSize="12" LineHeight="19" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="NameBox" services:UiLocalization.Header="连接名称" services:UiLocalization.PlaceholderText="例如：DeepSeek、我的工作模型" LostFocus="NameBox_LostFocus" />
                        <TextBox x:Name="BaseUrlBox" services:UiLocalization.Header="服务地址" services:UiLocalization.PlaceholderText="例如 http://127.0.0.1:8080/v1" TextChanged="BaseUrlBox_TextChanged" />
                        <StackPanel Spacing="6">
                            <PasswordBox x:Name="ApiKeyBox" Header="API Key" />
                            <TextBlock x:Name="KeyHint" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        </StackPanel>
                        <Border Style="{StaticResource TokenLimitRowStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock services:UiLocalization.Text="上下文窗口（tokens）" FontWeight="SemiBold" />
                                <Grid x:Name="ContextWindowRow" ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ContextWindowBox" HorizontalAlignment="Stretch" FontFamily="{StaticResource KynxaUIFont}" FontSize="13" CornerRadius="8" MinHeight="38" SelectedIndex="0" SelectionChanged="ContextWindowBox_SelectionChanged" services:UiLocalization.AutomationName="上下文窗口">
                                        <ComboBoxItem Content="8K" Tag="8192" />
                                        <ComboBoxItem Content="32K" Tag="32768" />
                                        <ComboBoxItem Content="128K" Tag="131072" />
                                        <ComboBoxItem Content="256K" Tag="262144" />
                                        <ComboBoxItem services:UiLocalization.Content="1M（1,000,000）" Tag="1000000" />
                                        <ComboBoxItem services:UiLocalization.Content="自定义" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomContextWindowBox" Grid.Column="1" Width="154" Visibility="Collapsed" PlaceholderText="2048–2000000" InputScope="Number" services:UiLocalization.AutomationName="自定义上下文窗口（tokens）" />
                                </Grid>
                                <TextBlock services:UiLocalization.Text="新连接按所选模型设置；实际额度取决于模型服务。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TokenLimitRowStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock services:UiLocalization.Text="最大输出（tokens）" FontWeight="SemiBold" />
                                <Grid x:Name="MaxOutputTokensRow" ColumnSpacing="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MaxOutputTokensBox" HorizontalAlignment="Stretch" FontFamily="{StaticResource KynxaUIFont}" FontSize="13" CornerRadius="8" MinHeight="38" SelectedIndex="6" SelectionChanged="MaxOutputTokensBox_SelectionChanged" services:UiLocalization.AutomationName="最大输出">
                                        <ComboBoxItem Content="4K" Tag="4096" />
                                        <ComboBoxItem Content="8K" Tag="8192" />
                                        <ComboBoxItem Content="16K" Tag="16384" />
                                        <ComboBoxItem Content="32K" Tag="32768" />
                                        <ComboBoxItem Content="64K" Tag="65536" />
                                        <ComboBoxItem Content="128K" Tag="131072" />
                                        <ComboBoxItem services:UiLocalization.Content="256K · 默认" Tag="262144" />
                                        <ComboBoxItem services:UiLocalization.Content="自定义" Tag="custom" />
                                    </ComboBox>
                                    <TextBox x:Name="CustomMaxOutputTokensBox" Grid.Column="1" Width="154" Visibility="Collapsed" PlaceholderText="1024–262144" InputScope="Number" services:UiLocalization.AutomationName="自定义最大输出（tokens）" />
                                </Grid>
                                <TextBlock services:UiLocalization.Text="这是上限；实际输出受模型服务和剩余上下文限制。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock services:UiLocalization.Text="可用模型" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModelCount" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            </Grid>
                            <TextBox x:Name="ModelSearchBox" services:UiLocalization.PlaceholderText="搜索模型名称或 ID" TextChanged="ModelSearchBox_TextChanged" services:UiLocalization.AutomationName="搜索模型" />
                            <ScrollViewer MaxHeight="256" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModelOptions" Spacing="4" />
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyModelsHint" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            <Expander x:Name="ManualModelsSection" services:UiLocalization.Header="手动填写模型 ID" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontSize="12">
                                <TextBox x:Name="ModelsBox" AcceptsReturn="True" Height="88" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" services:UiLocalization.PlaceholderText="每行一个模型 ID" TextChanged="ModelsBox_TextChanged" services:UiLocalization.AutomationName="模型 ID 列表" />
                            </Expander>
                            <TextBlock x:Name="ModelsHint" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        </StackPanel>
                        <Expander x:Name="AdvancedSettings" services:UiLocalization.Header="高级设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" FontFamily="{StaticResource KynxaUIFont}" FontSize="13">
                            <StackPanel Spacing="14">
                                <ComboBox x:Name="ProtocolBox" services:UiLocalization.Header="接口协议" HorizontalAlignment="Stretch" SelectedIndex="0" FontSize="13">
                                    <ComboBoxItem services:UiLocalization.Content="OpenAI 兼容 · Chat Completions" Tag="openai-completions" />
                                    <ComboBoxItem Content="OpenAI · Responses" Tag="openai-responses" />
                                    <ComboBoxItem Content="Claude · Messages" Tag="anthropic-messages" />
                                </ComboBox>
                                <TextBox x:Name="ProviderIdBox" services:UiLocalization.Header="连接 ID" services:UiLocalization.PlaceholderText="自动生成，可修改" />
                                <TextBlock services:UiLocalization.Text="连接 ID 用于区分配置；已保存连接的 ID 固定不变。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ProgressRing x:Name="BusyIndicator" Width="18" Height="18" IsActive="False" HorizontalAlignment="Left" />
                            <Button x:Name="ProbeButton" Grid.Column="1" services:UiLocalization.Content="获取模型 / 测试" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1" Click="TestConnectionButton_Click" />
                            <Button x:Name="SaveButton" Grid.Column="2" services:UiLocalization.Content="保存连接" Background="{StaticResource KynxaSendBrush}" Foreground="White" Click="SaveConnectionButton_Click" />
                        </Grid>
                        <TextBlock x:Name="StatusText" FontSize="12" MaxHeight="52" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{StaticResource KynxaSecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
