<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KYNXA_Desktop.ModelManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="KYNXA 模型管理">

    <Grid Background="{StaticResource KynxaMainBrush}">
    <Grid.Resources>
        <!-- Keep typing visually quiet: no blue focus underline or highlighted border. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource KynxaComposerActionColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource KynxaComposerActionColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource KynxaComposerActionColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource KynxaComposerActionColor}" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource KynxaComposerActionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource KynxaComposerActionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource KynxaComposerActionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
        <Style x:Key="ModelPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{StaticResource KynxaSendBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ModelSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="{StaticResource KynxaComposerActionBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="ModelTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ModelCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="{StaticResource KynxaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KynxaComposerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ModelFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource KynxaSecondaryTextBrush}" />
        </Style>
    </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="ModelTitleBar" Background="{StaticResource KynxaTitleBarBrush}">
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image Width="22" Height="22" Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png" />
                <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="模型管理" />
            </StackPanel>
            <Border VerticalAlignment="Bottom" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="0,0,0,1" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="28,16,28,12">
                <Border Width="360" Height="40" Background="{StaticResource KynxaSegmentIdleBrush}" CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border x:Name="ModelCategoryPill" Grid.ColumnSpan="3" Width="120" HorizontalAlignment="Left" Background="White" CornerRadius="11" Translation="0,0,8">
                            <Border.Shadow><ThemeShadow /></Border.Shadow>
                            <Border.TranslationTransition><Vector3Transition Duration="0:0:0.19" /></Border.TranslationTransition>
                        </Border>
                        <Button Click="LocalModelsButton_Click" Content="本地模型" Style="{StaticResource ModelTabButtonStyle}" />
                        <Button Grid.Column="1" Click="OfficialModelsButton_Click" Content="官方模型" Style="{StaticResource ModelTabButtonStyle}" />
                        <Button Grid.Column="2" Click="CustomModelsButton_Click" Content="自定义模型" Style="{StaticResource ModelTabButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="28,0,28,24">
                <!-- Local models -->
                <Grid x:Name="LocalModelsHost">
                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Height="34" Background="{StaticResource KynxaComposerActionBrush}" CornerRadius="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image Width="15" Height="15" Source="{StaticResource IconSearch}" />
                            <TextBox Grid.Column="1" Margin="0,0,8,0" Padding="0" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" PlaceholderText="搜索模型" Translation="0,6,0" />
                        </Grid>
                        <Button Grid.Column="2" Content="＋  添加本地模型" Style="{StaticResource ModelPrimaryButtonStyle}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="从 KYNXA 模型库下载" />
                                    <MenuFlyoutItem Text="导入 GGUF" />
                                    <MenuFlyoutItem Text="选择已有模型文件" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource ModelCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Qwen3 8B" /><Border Padding="8,2" Background="#E7F5EC" CornerRadius="6"><TextBlock FontSize="11" Foreground="#287348" Text="已加载" /></Border></StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="Qwen · Q4_K_M   ·   5.1 GB   ·   Context 32K" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontSize="12" Text="RTX 4060" /><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="显存 5.8 / 8 GB" /></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="卸载" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="设为默认" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="配置" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="···" Style="{StaticResource ModelSecondaryButtonStyle}" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ModelCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5">
                                        <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock FontSize="16" FontWeight="SemiBold" Text="DeepSeek R1 7B" /><Border Padding="8,2" Background="{StaticResource KynxaComposerActionBrush}" CornerRadius="6"><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="未加载" /></Border></StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="DeepSeek · Q5_K_M   ·   5.4 GB   ·   Context 64K" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontSize="12" Text="自动选择设备" /><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="显存自动" /></StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="下载" Style="{StaticResource ModelPrimaryButtonStyle}" /><Button Content="设为默认" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="配置" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="···" Style="{StaticResource ModelSecondaryButtonStyle}" /></StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource ModelCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="155" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Llama 3.2 3B" /><TextBlock FontSize="11" Foreground="#8A651D" Text="下载中 62%" /></StackPanel><ProgressBar Width="260" Height="4" HorizontalAlignment="Left" Value="62" /><TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="Meta · Q4_K_M   ·   2.2 GB   ·   Context 16K" /></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock FontSize="12" Text="等待加载" /><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="显存 —" /></StackPanel>
                                    <Button Grid.Column="2" Content="取消" Style="{StaticResource ModelSecondaryButtonStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Official providers -->
                <Grid x:Name="OfficialModelsHost" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock VerticalAlignment="Top" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="已配置的官方模型服务商" /></Grid>
                    <ScrollViewer Grid.Row="1"><StackPanel>
                        <Border Style="{StaticResource ModelCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock FontSize="16" FontWeight="SemiBold" Text="OpenAI" /><TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="已连接 · 6 个模型 · 默认 GPT-5" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontSize="12" Text="网络配置" /><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="跟随系统" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="测试连接" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="添加模型" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="配置" Style="{StaticResource ModelPrimaryButtonStyle}" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource ModelCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Anthropic" /><TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="未配置" /></StackPanel><Button Grid.Column="2" Content="配置" Style="{StaticResource ModelPrimaryButtonStyle}" /></Grid></Border>
                        <Border Style="{StaticResource ModelCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock FontSize="16" FontWeight="SemiBold" Text="DeepSeek" /><TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="已连接 · 2 个模型 · 默认 DeepSeek Chat" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock FontSize="12" Text="网络配置" /><TextBlock FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="直连" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"><Button Content="测试连接" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="配置" Style="{StaticResource ModelPrimaryButtonStyle}" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource ModelCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock FontSize="16" FontWeight="SemiBold" Text="Google" /><TextBlock FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="未配置" /></StackPanel><Button Grid.Column="1" Content="配置" Style="{StaticResource ModelPrimaryButtonStyle}" /></Grid></Border>
                    </StackPanel></ScrollViewer>
                </Grid>

                <!-- Custom provider connections and model profiles stay separate. -->
                <Grid x:Name="CustomModelsHost" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="连接保存接口地址与凭证；模型只引用连接" /><Button Grid.Column="1" Click="AddCustomConnectionButton_Click" Content="＋  添加自定义连接" Style="{StaticResource ModelPrimaryButtonStyle}" /></Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <StackPanel x:Name="CustomConnectionList">
                                <Border Style="{StaticResource ModelCardStyle}">
                                    <Grid ColumnSpacing="18" RowSpacing="7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="My Relay" />
                                        <StackPanel Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6"><Button Content="测试连接" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Click="AddCustomConnectionButton_Click" Content="配置" Style="{StaticResource ModelPrimaryButtonStyle}" /></StackPanel>
                                        <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="https://api.example.com/v1 · OpenAI 兼容协议" TextWrapping="Wrap" />
                                        <TextBlock Grid.Row="2" FontSize="11" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="4 个模型：GPT-5 · Claude Sonnet · DeepSeek Chat · Qwen" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border x:Name="CustomConnectionEditor" Padding="22" Background="{StaticResource KynxaSurfaceBrush}" BorderBrush="{StaticResource KynxaComposerBorderBrush}" BorderThickness="1" CornerRadius="12" Visibility="Collapsed">
                                <StackPanel Spacing="16">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="18" FontWeight="SemiBold" Text="自定义连接" /><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="连接可以挂载多个独立模型配置" /></StackPanel><Button Grid.Column="1" Click="CloseCustomEditorButton_Click" Content="关闭" Style="{StaticResource ModelSecondaryButtonStyle}" /></Grid>
                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <StackPanel><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="连接名称" /><TextBox PlaceholderText="例如：公司模型服务" /></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="协议类型" /><ComboBox HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="OpenAI Compatible" /><ComboBoxItem Content="Anthropic Compatible" /><ComboBoxItem Content="Custom Adapter" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Row="1"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="Base URL" /><TextBox PlaceholderText="https://api.example.com/v1" /></StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="API Key" /><PasswordBox PlaceholderText="凭证将由 KYNXA 安全凭证管理保存" /></StackPanel>
                                        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="网络配置" /><ComboBox HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="直连" /><ComboBoxItem Content="代理配置" /></ComboBox></StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="模型" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="获取模型列表" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="手动添加 Model ID" Style="{StaticResource ModelSecondaryButtonStyle}" /></StackPanel></StackPanel>
                                    </Grid>

                                    <Expander Header="高级设置">
                                        <StackPanel Padding="0,12,0,0" Spacing="14">
                                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="身份验证" /><ComboBox HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="Bearer 令牌" /><ComboBoxItem Content="API Key 请求头" /><ComboBoxItem Content="无需验证" /><ComboBoxItem Content="自定义" /></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource ModelFieldLabelStyle}" Text="上下文长度" /><ComboBox HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="自动检测" /><ComboBoxItem Content="8192" /><ComboBoxItem Content="32768" /><ComboBoxItem Content="128000" /></ComboBox></StackPanel></Grid>
                                            <Expander Header="自定义请求头"><StackPanel Padding="0,8,0,0" Spacing="8"><TextBox PlaceholderText="请求头名称，例如 X-Organization" /><PasswordBox PlaceholderText="请求头值（敏感内容将安全保存）" /><CheckBox Content="标记为敏感信息" /><Button HorizontalAlignment="Left" Content="＋ 添加请求头" Style="{StaticResource ModelSecondaryButtonStyle}" /></StackPanel></Expander>
                                            <Expander Header="模型能力">
                                                <Grid Padding="0,8,0,0" ColumnSpacing="12" RowSpacing="4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <CheckBox Content="文本" IsChecked="True" /><CheckBox Grid.Column="1" Content="流式输出" IsChecked="True" /><CheckBox Grid.Column="2" Content="视觉" /><CheckBox Grid.Column="3" Content="工具调用" />
                                                    <CheckBox Grid.Row="1" Content="结构化输出" /><CheckBox Grid.Row="1" Grid.Column="1" Content="向量嵌入" /><CheckBox Grid.Row="1" Grid.Column="2" Content="音频" /><CheckBox Grid.Row="1" Grid.Column="3" Content="推理" />
                                                </Grid>
                                            </Expander>
                                            <Expander Header="超时、重试与接口覆盖"><StackPanel Padding="0,8,0,0" Spacing="8"><TextBox PlaceholderText="连接超时：自动" /><TextBox PlaceholderText="请求总超时：自动" /><CheckBox Content="自动重试" IsChecked="True" /><CheckBox Content="遵循服务器重试时间" IsChecked="True" /><TextBox PlaceholderText="对话接口：由协议自动推断" /></StackPanel></Expander>
                                            <Expander Header="TLS 安全、生成参数与成本"><TextBlock Padding="0,8,0,0" Foreground="{StaticResource KynxaSecondaryTextBrush}" Text="TLS 使用系统默认；温度、Top P、最大输出 Token、随机种子与成本信息均为自动。" TextWrapping="Wrap" /></Expander>
                                        </StackPanel>
                                    </Expander>

                                    <Border x:Name="ConnectionDiagnostics" Padding="16" Background="{StaticResource KynxaComposerActionBrush}" CornerRadius="9" Visibility="Collapsed">
                                        <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Spacing="5"><TextBlock FontWeight="SemiBold" Text="连接诊断" /><TextBlock Text="接口地址        ✓" /><TextBlock Text="域名解析        ✓" /><TextBlock Text="TLS 安全        ✓" /></StackPanel><StackPanel Grid.Column="1" Margin="0,24,0,0" Spacing="5"><TextBlock Text="身份验证        ✓" /><TextBlock Text="模型列表接口    ✓" /><TextBlock Text="流式输出        ✓" /></StackPanel><StackPanel Grid.Column="2" Margin="0,24,0,0" Spacing="5"><TextBlock Text="工具调用        ✓" /><TextBlock Text="视觉            —" /><TextBlock FontWeight="SemiBold" Text="延迟            824 ms" /></StackPanel></Grid>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Click="TestConnectionButton_Click" Content="测试连接" Style="{StaticResource ModelSecondaryButtonStyle}" /><Button Content="保存" Style="{StaticResource ModelPrimaryButtonStyle}" /></StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
