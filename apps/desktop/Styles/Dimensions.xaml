<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="KynxaBodyFontSize">14</x:Double>
    <x:Double x:Key="KynxaCaptionFontSize">12</x:Double>
    <x:Double x:Key="KynxaEditorFontSize">16</x:Double>
    <x:Double x:Key="KynxaBodyLineHeight">20</x:Double>
    <x:Double x:Key="KynxaSidebarRowHeight">40</x:Double>
    <x:Double x:Key="KynxaMenuRowHeight">36</x:Double>
    <x:Double x:Key="KynxaPickerHeight">32</x:Double>
    <x:Double x:Key="KynxaWorkspacePickerHeight">30</x:Double>
    <x:Double x:Key="KynxaComposerFooterHeight">44</x:Double>
    <x:Double x:Key="KynxaIconButtonSize">32</x:Double>
    <x:Double x:Key="KynxaSmallIconButtonSize">28</x:Double>
    <x:Double x:Key="KynxaRowActionSize">24</x:Double>
    <x:Double x:Key="KynxaPickerContentWidth">250</x:Double>
    <CornerRadius x:Key="KynxaControlRadius">8</CornerRadius>
    <Thickness x:Key="KynxaSidebarItemMargin">0,0,16,0</Thickness>
    <!-- Match the native ListViewItemPresenter backplate inset; row hit targets stay full height.
         对齐原生 ListViewItemPresenter 背景内缩，整行命中高度保持不变。
    -->
    <Thickness x:Key="KynxaSidebarSurfaceInset">4,2,4,2</Thickness>
    <CornerRadius x:Key="KynxaMenuRadius">16</CornerRadius>
    <CornerRadius x:Key="KynxaComposerRadius">24</CornerRadius>
</ResourceDictionary>
