<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:KYNXA_Desktop.Controls" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" xmlns:services="using:KYNXA_Desktop.Services">
    <!-- Prefer the Latin UI font; Chinese falls back to YaHei UI.
         优先拉丁界面字体，英文使用 Segoe，中文回退到微软雅黑 UI。
    -->
    <FontFamily x:Key="KynxaUIFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <!-- Enabled switches share the live palette; native off and disabled states retain their own meaning.
         开启的开关共用实时配色，关闭与禁用状态继续保留原生语义。
    -->
    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="KynxaAccentBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOn" ResourceKey="KynxaOnAccentBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOnPointerOver" ResourceKey="KynxaOnAccentBrush" />
    <StaticResource x:Key="ToggleSwitchKnobFillOnPressed" ResourceKey="KynxaOnAccentBrush" />
    <!-- Informational notices share the owner surface; severity icons and warning/error/success tints stay native.
         信息提示沿用所属界面底色；各级图标及警告、错误、成功色调保留原生语义。
    -->
    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="KynxaSurfaceBrush" />
    <StaticResource x:Key="InfoBarTitleForeground" ResourceKey="KynxaTextBrush" />
    <StaticResource x:Key="InfoBarMessageForeground" ResourceKey="KynxaTextBrush" />
    <Style x:Key="KynxaFormScrollViewerStyle" TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}">
        <Setter Property="Padding" Value="{StaticResource KynxaFormScrollPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalScrollMode" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollMode" Value="Enabled" />
        <Setter Property="ZoomMode" Value="Disabled" />
    </Style>
    <!-- Popups have their own visual roots; shared defaults also cover dynamically created controls.
         弹出层拥有独立可视根；共享默认样式同时覆盖动态创建的文字与控件。
         Explicit code, math and icon fonts keep their local values; sizes and weights retain their hierarchy.
         代码、公式和图标的显式字体保留，字号和字重继续沿用现有层级。
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="RichTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
    </Style>
    <Style x:Key="KynxaPopupSearchBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
    </Style>
    <Style TargetType="RichEditBox" BasedOn="{StaticResource DefaultRichEditBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
    </Style>
    <!-- Keep SDK templates for rounded backgrounds, selection and keyboard behavior.
         沿用 SDK 模板的圆角背景、选中指示和键盘行为。
    -->
    <Style x:Key="KynxaComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Margin" Value="{StaticResource KynxaComboBoxItemMargin}" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource KynxaComboBoxItemStyle}" />
    <Style x:Key="KynxaComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="primitives:ComboBoxHelper.KeepInteriorCornersSquare" Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource KynxaComboBoxItemStyle}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource KynxaComboBoxStyle}" />
    <Style x:Key="KynxaScrollSafeComboBoxStyle" TargetType="controls:ScrollSafeComboBox" BasedOn="{StaticResource KynxaComboBoxStyle}" />
    <Style TargetType="controls:ScrollSafeComboBox" BasedOn="{StaticResource KynxaScrollSafeComboBoxStyle}" />
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style TargetType="PivotHeaderItem">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
    </Style>
    <Style x:Key="KynxaMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="Background" Value="{StaticResource KynxaSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KynxaDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaMenuRadius}" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource KynxaMenuPresenterStyle}" />
    <Style x:Key="KynxaMenuItemStyle" TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Margin" Value="{StaticResource KynxaPopupItemMargin}" />
    </Style>
    <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource KynxaMenuItemStyle}" />
    <Style x:Key="KynxaSubMenuItemStyle" TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Margin" Value="{StaticResource KynxaPopupItemMargin}" />
    </Style>
    <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource KynxaSubMenuItemStyle}" />
    <Style x:Key="KynxaToggleMenuItemStyle" TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Margin" Value="{StaticResource KynxaPopupItemMargin}" />
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource KynxaToggleMenuItemStyle}" />
    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaMenuRadius}" />
    </Style>
    <!-- Set text tracking directly; inherited button tracking may be ignored.
         创建文字时直接设置字间距，避免 WinUI 快速排版忽略按钮继承值。
    -->
    <DataTemplate x:Key="KynxaDialogAcknowledgementTemplate">
        <TextBlock Text="{Binding}" CharacterSpacing="{StaticResource KynxaDialogAcknowledgementCharacterSpacing}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </DataTemplate>
    <Style x:Key="KynxaDialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ButtonBorderBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="KynxaDialogAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Background" Value="{ThemeResource AccentButtonBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource AccentButtonForeground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentButtonBorderBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="Background" Value="{StaticResource KynxaMainBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KynxaDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaMenuRadius}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource KynxaDialogButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource KynxaDialogButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource KynxaDialogButtonStyle}" />
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Background" Value="{StaticResource KynxaSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource KynxaDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="KynxaInfoBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource InfoBarCloseButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource KynxaFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="services:UiLocalization.TemplateButtonLabel" Value="关闭提示" />
        <!-- Avoid the SDK's local AppBar color aliases; keep the close glyph legible in the application's theme.
             避免 SDK 局部 AppBar 颜色覆盖，使关闭图标在应用深浅主题下始终清晰。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                      Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw" Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource KynxaControlHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Background" Value="{StaticResource KynxaControlPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{StaticResource KynxaDisabledTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <x:Double x:Key="KynxaNoticeIconSize">18</x:Double>
    <!-- Keep floating notices in one aligned row while retaining InfoBar's native parts, severity and close lifecycle.
         悬浮提示统一为居中对齐的单行布局，保留 InfoBar 原生部件、级别语义和关闭生命周期。 -->
    <ControlTemplate x:Key="KynxaCompactInfoBarTemplate" TargetType="InfoBar">
        <Border x:Name="ContentRoot" Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SeverityLevels">
                    <VisualState x:Name="Informational" />
                    <VisualState x:Name="Error">
                        <VisualState.Setters>
                            <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarErrorSeverityBackgroundBrush}" />
                            <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconBackground}" />
                            <Setter Target="StandardIcon.Text" Value="{StaticResource InfoBarErrorIconGlyph}" />
                            <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Warning">
                        <VisualState.Setters>
                            <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarWarningSeverityBackgroundBrush}" />
                            <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconBackground}" />
                            <Setter Target="StandardIcon.Text" Value="{StaticResource InfoBarWarningIconGlyph}" />
                            <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Success">
                        <VisualState.Setters>
                            <Setter Target="ContentRoot.Background" Value="{ThemeResource InfoBarSuccessSeverityBackgroundBrush}" />
                            <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter Target="StandardIcon.Text" Value="{StaticResource InfoBarSuccessIconGlyph}" />
                            <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconForeground}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="IconStates">
                    <VisualState x:Name="StandardIconVisible">
                        <VisualState.Setters><Setter Target="StandardIconArea.Visibility" Value="Visible" /><Setter Target="UserIconBox.Visibility" Value="Collapsed" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="UserIconVisible">
                        <VisualState.Setters><Setter Target="StandardIconArea.Visibility" Value="Collapsed" /><Setter Target="UserIconBox.Visibility" Value="Visible" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="NoIconVisible" />
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState x:Name="CloseButtonVisible" />
                    <VisualState x:Name="CloseButtonCollapsed"><VisualState.Setters><Setter Target="CloseButton.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="InfoBarVisibility">
                    <VisualState x:Name="InfoBarVisible" />
                    <VisualState x:Name="InfoBarCollapsed"><VisualState.Setters><Setter Target="ContentRoot.Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState x:Name="ForegroundNotSet" />
                    <VisualState x:Name="ForegroundSet">
                        <VisualState.Setters>
                            <Setter Target="Title.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                            <Setter Target="Message.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState x:Name="BannerContent" />
                    <VisualState x:Name="NoBannerContent"><VisualState.Setters><Setter Target="ContentArea.(Grid.Row)" Value="0" /></VisualState.Setters></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid MinHeight="52" Padding="12,10" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid x:Name="StandardIconArea" Visibility="Collapsed" Width="{StaticResource KynxaNoticeIconSize}"
                      Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="IconBackground" FontSize="{StaticResource KynxaNoticeIconSize}" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Text="{StaticResource InfoBarIconBackgroundGlyph}" Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"
                               FontFamily="{ThemeResource SymbolThemeFontFamily}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="StandardIcon" FontSize="{StaticResource KynxaNoticeIconSize}" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Text="{StaticResource InfoBarInformationalIconGlyph}" Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"
                               FontFamily="{ThemeResource SymbolThemeFontFamily}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Viewbox x:Name="UserIconBox" Visibility="Collapsed" Width="{StaticResource KynxaNoticeIconSize}" Height="20"
                         Margin="0,0,12,0" VerticalAlignment="Center" Child="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IconElement}" />
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="{StaticResource KynxaBodyFontSize}"
                               LineHeight="{StaticResource KynxaBodyLineHeight}" LineStackingStrategy="BlockLineHeight" Margin="0,0,8,0" MaxWidth="160"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InfoBarTitleForeground}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Message" Grid.Column="1" Text="{TemplateBinding Message}" FontSize="{StaticResource KynxaBodyFontSize}"
                               LineHeight="{StaticResource KynxaBodyLineHeight}" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource InfoBarMessageForeground}" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter x:Name="NoticeAction" Grid.Column="2" Content="{TemplateBinding ActionButton}" VerticalAlignment="Center" />
                <ContentPresenter x:Name="ContentArea" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                <Button x:Name="CloseButton" Grid.Column="3" Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="8,0,0,0"
                        VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Style="{TemplateBinding CloseButtonStyle}" Command="{TemplateBinding CloseButtonCommand}" CommandParameter="{TemplateBinding CloseButtonCommandParameter}">
                    <Viewbox Width="12" Height="12"><SymbolIcon Symbol="Cancel" /></Viewbox>
                </Button>
            </Grid>
        </Border>
    </ControlTemplate>
    <Style x:Key="KynxaInfoBarStyle" TargetType="InfoBar">
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaMenuRadius}" />
        <Setter Property="BorderBrush" Value="{StaticResource KynxaDividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource KynxaInfoBarCloseButtonStyle}" />
    </Style>
    <Style TargetType="InfoBar" BasedOn="{StaticResource KynxaInfoBarStyle}" />
    <Style x:Key="KynxaCompactInfoBarStyle" TargetType="InfoBar" BasedOn="{StaticResource KynxaInfoBarStyle}">
        <Setter Property="Template" Value="{StaticResource KynxaCompactInfoBarTemplate}" />
    </Style>
    <Style TargetType="controls:CompactInfoBar" BasedOn="{StaticResource KynxaCompactInfoBarStyle}" />
    <Style x:Key="KynxaQuietButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
        <Setter Property="FontSize" Value="{StaticResource KynxaBodyFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{StaticResource KynxaControlRadius}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource KynxaFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters><Setter Target="Feedback.Opacity" Value="0" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Feedback.Opacity" Value="1" />
                                        <Setter Target="Feedback.Background" Value="{StaticResource KynxaButtonHoverOverlayBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Feedback.Opacity" Value="1" />
                                        <Setter Target="Feedback.Background" Value="{StaticResource KynxaButtonPressedOverlayBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.45" /><Setter Target="Feedback.Opacity" Value="0" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Feedback" Background="{StaticResource KynxaButtonHoverOverlayBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KynxaInfoBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource KynxaQuietButtonStyle}">
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MinHeight" Value="{StaticResource KynxaPickerHeight}" />
        <Setter Property="FontSize" Value="{StaticResource KynxaBodyFontSize}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="{StaticResource KynxaBodyFontSize}" LineHeight="{StaticResource KynxaBodyLineHeight}"
                               LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Background" Value="{StaticResource KynxaControlHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource KynxaFocusBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="Transparent" />
        <!-- Notice actions stay neutral until interaction; shared brushes keep both themes and custom accents consistent.
             提示操作默认使用中性色，交互时才显示强调色；共享画刷统一适配深浅主题及自定义颜色。
        -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter x:Name="NoticeActionPresenter"
                                      Background="{TemplateBinding Background}" BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                      Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentTransitions="{TemplateBinding ContentTransitions}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      AutomationProperties.AccessibilityView="Raw" Control.IsTemplateFocusTarget="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="NoticeActionPresenter.Background" Value="{StaticResource KynxaSelectionBrush}" />
                                        <Setter Target="NoticeActionPresenter.Foreground" Value="{StaticResource KynxaAccentTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="NoticeActionPresenter.Background" Value="{StaticResource KynxaSelectionBrush}" />
                                        <Setter Target="NoticeActionPresenter.Foreground" Value="{StaticResource KynxaAccentTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="NoticeActionPresenter.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
