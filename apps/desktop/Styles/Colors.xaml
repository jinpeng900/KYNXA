<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="KynxaTitleBarColor">#FBFAF9</Color>
    <Color x:Key="KynxaSidebarColor">#FBFAF9</Color>
    <Color x:Key="KynxaMainColor">#FFFFFF</Color>
    <Color x:Key="KynxaSurfaceColor">#FFFFFF</Color>
    <Color x:Key="KynxaIconColor">#E6000000</Color>
    <Color x:Key="KynxaTextColor">#E6000000</Color>
    <Color x:Key="KynxaSecondaryTextColor">#99000000</Color>
    <Color x:Key="KynxaDividerColor">#14000000</Color>
    <Color x:Key="KynxaSegmentIdleColor">#F5F5F5</Color>
    <Color x:Key="KynxaReplySurfaceColor">#F7F7F7</Color>
    <Color x:Key="KynxaSendColor">#262626</Color>
    <Color x:Key="KynxaSendHoverColor">#404040</Color>
    <Color x:Key="KynxaSendPressedColor">#171717</Color>
    <Color x:Key="KynxaOnlineColor">#03C027</Color>
    <Color x:Key="KynxaComposerBorderColor">#14000000</Color>
    <Color x:Key="KynxaComposerActionColor">#F5F5F5</Color>
    <Color x:Key="KynxaAmbientWaveColor">#F2F1EF</Color>
    <Color x:Key="KynxaAmbientWaveSoftColor">#FAF9F8</Color>
    <Color x:Key="KynxaControlHoverColor">#08000000</Color>
    <Color x:Key="KynxaControlPressedColor">#0D000000</Color>

    <SolidColorBrush x:Key="KynxaTitleBarBrush" Color="{StaticResource KynxaTitleBarColor}" />
    <SolidColorBrush x:Key="KynxaSidebarBrush" Color="{StaticResource KynxaSidebarColor}" />
    <SolidColorBrush x:Key="KynxaMainBrush" Color="{StaticResource KynxaMainColor}" />
    <SolidColorBrush x:Key="KynxaSurfaceBrush" Color="{StaticResource KynxaSurfaceColor}" />
    <SolidColorBrush x:Key="KynxaIconBrush" Color="{StaticResource KynxaIconColor}" />
    <SolidColorBrush x:Key="KynxaTextBrush" Color="{StaticResource KynxaTextColor}" />
    <SolidColorBrush x:Key="KynxaSecondaryTextBrush" Color="{StaticResource KynxaSecondaryTextColor}" />
    <SolidColorBrush x:Key="KynxaDividerBrush" Color="{StaticResource KynxaDividerColor}" />
    <SolidColorBrush x:Key="KynxaWorkPanelDividerBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="KynxaPermissionFullBrush" Color="#946900" />
    <SolidColorBrush x:Key="KynxaSegmentIdleBrush" Color="{StaticResource KynxaSegmentIdleColor}" />
    <SolidColorBrush x:Key="KynxaReplySurfaceBrush" Color="{StaticResource KynxaReplySurfaceColor}" />
    <SolidColorBrush x:Key="KynxaSendBrush" Color="{StaticResource KynxaSendColor}" />
    <SolidColorBrush x:Key="KynxaSendHoverBrush" Color="{StaticResource KynxaSendHoverColor}" />
    <SolidColorBrush x:Key="KynxaSendPressedBrush" Color="{StaticResource KynxaSendPressedColor}" />
    <SolidColorBrush x:Key="KynxaOnlineBrush" Color="{StaticResource KynxaOnlineColor}" />
    <SolidColorBrush x:Key="KynxaComposerBorderBrush" Color="{StaticResource KynxaComposerBorderColor}" />
    <SolidColorBrush x:Key="KynxaComposerActionBrush" Color="{StaticResource KynxaComposerActionColor}" />
    <SolidColorBrush x:Key="KynxaAmbientWaveBrush" Color="{StaticResource KynxaAmbientWaveColor}" />
    <SolidColorBrush x:Key="KynxaAmbientWaveSoftBrush" Color="{StaticResource KynxaAmbientWaveSoftColor}" />
    <SolidColorBrush x:Key="KynxaControlHoverBrush" Color="{StaticResource KynxaControlHoverColor}" />
    <SolidColorBrush x:Key="KynxaControlPressedBrush" Color="{StaticResource KynxaControlPressedColor}" />
    <!-- Keep interaction feedback quiet and consistent across the shell.
         整个主界面的交互反馈保持克制且一致。
    -->
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource KynxaControlHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource KynxaControlPressedColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
</ResourceDictionary>
