<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="KYNXA_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KYNXA_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="KYNXA"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40" Background="{StaticResource KynxaTitleBarBrush}">
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource KynxaTextBrush}"
                Text="KYNXA" />
            <Border
                VerticalAlignment="Bottom"
                BorderBrush="{StaticResource KynxaDividerBrush}"
                BorderThickness="0,0,0,1" />
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
