<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="KYNXA_Desktop.MemoryManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:KYNXA_Desktop.Services">
    <Grid x:Name="MemoryRoot" Background="{StaticResource KynxaMainBrush}" Loaded="MemoryRoot_Loaded" SizeChanged="MemoryRoot_SizeChanged">
        <Grid.Resources>
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#888888" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#888888" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#888888" />
            <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#888888" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelected" Color="#C8C8C8" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPointerOver" Color="#C8C8C8" />
            <SolidColorBrush x:Key="ComboBoxItemBorderBrushSelectedPressed" Color="#C8C8C8" />
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource KynxaTextBrush}" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource KynxaQuietButtonStyle}">
                <Setter Property="FontFamily" Value="{StaticResource KynxaUIFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="MemoryListItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="MemoryTitleBar" Background="{StaticResource KynxaSidebarBrush}">
            <TextBlock services:UiLocalization.Text="KYNXA  /  记忆管理" Margin="20,0,140,0" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="6" Margin="24,20,24,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="MemoryScopeChatButton" AutomationProperties.AutomationId="MemoryScopeChatButton" Tag="chat" HorizontalAlignment="Stretch" MinWidth="0" services:UiLocalization.AutomationName="聊天记忆" Click="Scope_Click">
                <TextBlock services:UiLocalization.Text="聊天记忆" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button x:Name="MemoryScopeProjectButton" Grid.Column="1" AutomationProperties.AutomationId="MemoryScopeProjectButton" Tag="project" HorizontalAlignment="Stretch" MinWidth="0" services:UiLocalization.AutomationName="工作记忆" Click="Scope_Click">
                <TextBlock services:UiLocalization.Text="工作记忆" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button x:Name="MemoryScopeUserButton" Grid.Column="2" AutomationProperties.AutomationId="MemoryScopeUserButton" Tag="user" HorizontalAlignment="Stretch" MinWidth="0" services:UiLocalization.AutomationName="全局记忆" Click="Scope_Click">
                <TextBlock services:UiLocalization.Text="全局记忆" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
        </Grid>
        <InfoBar x:Name="MemoryStatusBar" Grid.Row="2" Margin="24,0,24,12" IsClosable="True" AutomationProperties.AutomationId="MemoryStatusBar" />
        <Grid x:Name="MemoryBody" Grid.Row="3" Margin="24,0,24,24" ColumnSpacing="24" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MemoryListColumn" Width="340" />
                <ColumnDefinition x:Name="MemoryEditorColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="MemoryListPanel" Grid.RowSpan="2" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <ComboBox x:Name="MemoryContextPicker" AutomationProperties.AutomationId="MemoryContextPicker" services:UiLocalization.AutomationName="记忆范围" DisplayMemberPath="DisplayName" SelectionChanged="Context_SelectionChanged" />
                <TextBox x:Name="MemorySearchBox" Grid.Row="1" AutomationProperties.AutomationId="MemorySearchBox" services:UiLocalization.PlaceholderText="搜索记忆" services:UiLocalization.AutomationName="搜索记忆" TextChanged="Search_TextChanged" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="MemoryCountLabel" VerticalAlignment="Center" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                    <Button x:Name="RefreshMemoryButton" Grid.Column="1" AutomationProperties.AutomationId="RefreshMemoryButton" services:UiLocalization.ToolTip="刷新" services:UiLocalization.AutomationName="刷新" Style="{StaticResource KynxaIconButtonStyle}" Click="Refresh_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button x:Name="NewMemoryButton" Grid.Column="2" Margin="6,0,0,0" AutomationProperties.AutomationId="NewMemoryButton" services:UiLocalization.Content="新增记忆" Click="New_Click" />
                </Grid>
                <Grid Grid.Row="3">
                    <ListView x:Name="MemoryEntryList" AutomationProperties.AutomationId="MemoryEntryList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Entry_Click" ItemContainerStyle="{StaticResource MemoryListItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Background}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource KynxaDividerBrush}" BorderThickness="1">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="{Binding Entry.Content}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource KynxaSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="MemoryEmptyPanel" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260" Margin="12">
                        <ProgressRing x:Name="MemoryLoadingRing" Width="24" Height="24" Foreground="{StaticResource KynxaSecondaryTextBrush}" />
                        <TextBlock x:Name="MemoryEmptyLabel" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid x:Name="MemoryEditorPanel" Grid.Column="1" Grid.RowSpan="2" RowSpacing="16">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="MemoryEditorHeading" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="MemoryScopeLabel" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBlock services:UiLocalization.Text="类型" />
                        <ComboBox x:Name="MemoryKindPicker" AutomationProperties.AutomationId="MemoryKindPicker" services:UiLocalization.AutomationName="记忆类型" SelectionChanged="Kind_SelectionChanged">
                            <ComboBoxItem Tag="fact" services:UiLocalization.Content="事实" />
                            <ComboBoxItem Tag="preference" services:UiLocalization.Content="偏好" />
                            <ComboBoxItem Tag="decision" services:UiLocalization.Content="决定" />
                        </ComboBox>
                        <TextBlock services:UiLocalization.Text="内容" />
                        <TextBox x:Name="MemoryContentBox" AutomationProperties.AutomationId="MemoryContentBox" services:UiLocalization.AutomationName="记忆内容" services:UiLocalization.PlaceholderText="输入需要保留的记忆" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="Content_TextChanged" />
                        <TextBlock x:Name="MemoryInputHint" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource KynxaReplySurfaceBrush}" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="MemorySourceLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="MemorySourceStatusLabel" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="MemoryUpdatedLabel" FontSize="12" Foreground="{StaticResource KynxaSecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="DeleteMemoryButton" AutomationProperties.AutomationId="DeleteMemoryButton" services:UiLocalization.Content="删除" Click="Delete_Click" />
                    <Button x:Name="SaveMemoryButton" AutomationProperties.AutomationId="SaveMemoryButton" services:UiLocalization.Content="保存" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
