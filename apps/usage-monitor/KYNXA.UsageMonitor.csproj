<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KYNXA.UsageMonitor</AssemblyName>
    <RootNamespace>Kynxa.UsageMonitor</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core\**\*.cs" />
    <ProjectReference Include="Core\KYNXA.UsageMonitor.Core.csproj" />
    <Content Include="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LICENSES\MeteorNOX-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
