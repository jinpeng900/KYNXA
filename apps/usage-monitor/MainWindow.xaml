<Window x:Class="Kynxa.UsageMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Kynxa.UsageMonitor.Controls"
    Title="KYNXA 用量统计" Width="270" Height="150" WindowStyle="None"
    ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" FontFamily="Segoe UI, Microsoft YaHei UI">
    <Border x:Name="Card" Margin="8" Padding="13,9,13,11" CornerRadius="12"
        BorderThickness="1" BorderBrush="{DynamicResource UsageBorderBrush}" Background="{DynamicResource UsageSurfaceBrush}">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.10" Color="#202A40" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="23" /></Grid.ColumnDefinitions>
                <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll"
                    MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd" LostMouseCapture="OnDragCaptureLost">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⠿" Foreground="{DynamicResource UsageSecondaryBrush}" FontSize="16" Margin="0,0,5,0" />
                        <TextBlock Text="KYNXA" Foreground="{DynamicResource UsageTextBrush}" FontWeight="Medium" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScopeText" Text="本次运行" Foreground="{DynamicResource UsageSecondaryBrush}" FontSize="10" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="92" />
                    </StackPanel>
                </Border>
                <Button x:Name="CollapseButton" Grid.Column="1" Content="⌄" FontSize="14" Width="23" Height="23" Click="OnCollapseClick"
                    AutomationProperties.AutomationId="UsageMonitorCollapseButton" AutomationProperties.Name="折叠" />
            </Grid>
            <Grid x:Name="ValuesPanel" Grid.Row="1" Margin="1,5,0,0">
                <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="32" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="TokenLabel" Text="Token 消耗" FontSize="11" Foreground="{DynamicResource UsageSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                    <controls:RollingNumber x:Name="TokenNumber" AutomationProperties.AutomationId="UsageMonitorTotal" />
                </Viewbox>
                <TextBlock x:Name="CacheLabel" Grid.Row="1" Text="缓存命中率" FontSize="11" Foreground="{DynamicResource UsageSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Right">
                    <controls:RollingNumber x:Name="CacheNumber" AutomationProperties.AutomationId="UsageMonitorCache" />
                </Viewbox>
            </Grid>
        </Grid>
    </Border>
</Window>
