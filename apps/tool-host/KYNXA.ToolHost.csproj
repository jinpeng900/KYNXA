<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>1.5.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Keep the SDK projection aligned with its bundled original license provenance.
         固定 SDK 投影包，使其与随包许可来源记录保持一致。 -->
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <AssemblyName>KYNXA.ToolHost</AssemblyName>
    <RootNamespace>KYNXA.ToolHost</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <PackageReference Include="SharpCompress" Version="[0.50.5]" />
  </ItemGroup>
</Project>
