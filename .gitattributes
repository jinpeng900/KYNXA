# Preserve the original whitespace in vendored upstream skill examples.
# 保留第三方技能示例的原始空白。
apps/official-tools/Skills/** -text whitespace=cr-at-eol
apps/official-tools/Skills/internal-comms/examples/** whitespace=-blank-at-eol,cr-at-eol
apps/official-tools/LICENSE.txt -text whitespace=-blank-at-eol,cr-at-eol

# Preserve the pinned benchmark dependency lock bytes across checkout and installation.
# 保留固定基准依赖锁的原始字节，检出和安装不能改变已登记的哈希。
tests/agent-performance-benchmark/pi-sdk-lock/*.json -text
apps/desktop/Build/native-assets/mcp/package*.json -text

# Keep the bundled Mermaid distribution and notices byte-for-byte across Git operations.
# 保留随包 Mermaid 发行文件与许可证的原始字节，避免 Git 转换换行。
apps/desktop/Resources/Diagrams/Mermaid/** -text whitespace=cr-at-eol

# Preserve whitespace embedded in the original third-party browser bundle.
# 保留第三方浏览器包原文内的空白，不为提交检查改写发行文件。
apps/desktop/Resources/Diagrams/Mermaid/mermaid.min.js whitespace=-blank-at-eol,cr-at-eol

# Preserve pinned upstream license bytes, including their original line endings and whitespace.
# 保留固定第三方许可的原始字节、换行与空白，避免检出后破坏随包哈希。
apps/desktop/Build/licenses/windows-sdk-license.md -text whitespace=-blank-at-eol,cr-at-eol
apps/desktop/Build/licenses/*LICENSE.txt -text whitespace=-blank-at-eol,cr-at-eol
apps/agent-core/licenses/** -text whitespace=-blank-at-eol,cr-at-eol
apps/desktop/Build/native-assets/licenses/*/* -text whitespace=-blank-at-eol,cr-at-eol

# Parser fixtures are byte-level evidence; line conversion would corrupt PDF offsets or reference hashes.
# 解析夹具是原始字节证据；转换换行会破坏 PDF 偏移或对照哈希，原件和许可不得规范化。
apps/agent-core/tests/fixtures/** -text whitespace=-blank-at-eol,cr-at-eol
apps/agent-core/tests/fixtures/**/*.pdf binary
tests/archive-worker-smoke/fixtures/** -text
