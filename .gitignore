# OS
Thumbs.db
.DS_Store

# Node.js dependencies are restored from the lockfile.
# Node.js 依赖按锁文件还原。
node_modules/

# Isolated development verification outputs; never ship them with the application.
# 隔离的开发验收产物，不随应用发布。
/artifacts/

# Rust resource-service build outputs; ship only the prepared runtime artifact.
# Rust 资源服务构建产物，仅由打包步骤收录准备好的运行文件。
/apps/resource-service/target/

# Benchmark inputs, indexes and results remain local.
# 评测输入、索引与结果保留本地。
/test/

# Keep standalone tests and fixtures local; production sources remain tracked.
# 独立测试和夹具只留本地，生产源码继续纳入版本管理。
/tests/
/apps/**/tests/
*_tests.rs
/apps/mock-backend/
/tools/development/fixtures/unified-agent/
/tools/development/evaluate-unified-retrieval.mjs

# Local design archives and generated design documents stay outside the source repository.
# 本机设计归档和生成的设计文档保留本地，不进入源码仓库。
/docs/design/
# Private documentation and retired automation instructions stay off the public repository.
# 本地详细说明与已撤下的自动化说明不进入公开仓库。
AGENTS.md
/.agents/
/docs/architecture/
/docs/team/
/docs/verification/
/docs/ui/
/*.zip
/*.7z
/*.rar
