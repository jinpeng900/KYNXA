    {
      "files": [
        "Directory.Build.props",
        "Directory.Build.targets"
      ],
      "role": "A",
      "inventory": "shared build configuration outside apps / apps 范围外的共享构建配置"
    },
    {
      "prefix": "tools/development/",
      "role": "A",
      "inventory": "outside apps production inventory / 不计入 apps 生产源码统计"
    }
