  "testAttribution": {
    "strategy": "Direct test source/Compile Include resolve to implementation owners; native unit tests remain with the owning Rust modules / 直接测试源码或 Compile Include 映射实现负责人；原生单元测试归所属 Rust 模块",
    "fallbackRole": "A",
    "fallbackMeaning": "Fixtures or integration checks without direct owned sources are coordinated by A, not automatically assigned to data / 无直接主责源码的夹具或集成检查由 A 协调，不统一归数据负责人",
    "limitation": "Indirect runtime calls and nested fixture ownership require suite README review / 间接运行调用及嵌套夹具归属仍需查阅套件 README",
    "roots": [
      "tests"
    ]
  },
