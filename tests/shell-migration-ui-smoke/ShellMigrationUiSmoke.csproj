<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KYNXA_Desktop</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>../../apps/desktop/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="Msix" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="ColorCode.Core" Version="2.0.15" />
    <PackageReference Include="CSharpMath.SkiaSharp" Version="0.5.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <Compile Include="../../apps/desktop/**/*.cs"
             Exclude="../../apps/desktop/App.xaml.cs;../../apps/desktop/bin/**/*.cs;../../apps/desktop/obj/**/*.cs"
             Link="Production/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../apps/shared/**/*.cs" Exclude="../../apps/shared/bin/**/*.cs;../../apps/shared/obj/**/*.cs"
             Link="Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Page Include="../../apps/desktop/**/*.xaml"
          Exclude="../../apps/desktop/App.xaml;../../apps/desktop/bin/**/*.xaml;../../apps/desktop/obj/**/*.xaml"
          Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../apps/desktop/Assets/**/*" Link="Assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../apps/desktop/Resources/**/*" Link="Resources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../memory-ui-smoke/NativeUi.cs" Link="NativeUi.cs" />
    <Compile Include="../memory-ui-smoke/NativeWindowCapture.cs" Link="NativeWindowCapture.cs" />
  </ItemGroup>
</Project>
