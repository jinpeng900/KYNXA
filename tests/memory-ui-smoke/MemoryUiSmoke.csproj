<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <Compile Include="../../apps/desktop/MemoryManagementWindow.xaml.cs" Link="MemoryManagementWindow.xaml.cs" />
    <Page Include="../../apps/desktop/MemoryManagementWindow.xaml" Link="MemoryManagementWindow.xaml" />
    <Page Include="../../apps/desktop/Styles/*.xaml" Link="Styles/%(Filename)%(Extension)" />
    <Compile Include="../../apps/desktop/ViewModels/Memory*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../../apps/desktop/Services/MemoryApiClient.cs" Link="Services/MemoryApiClient.cs" />
    <Compile Include="../../apps/desktop/Services/ModelGatewayService.cs" Link="Services/ModelGatewayService.cs" />
    <Compile Include="../../apps/desktop/Services/GatewayApiException.cs" Link="Services/GatewayApiException.cs" />
    <Compile Include="../../apps/desktop/Services/GatewayResponseReader.cs" Link="Services/GatewayResponseReader.cs" />
    <Compile Include="../../apps/desktop/Services/UiText*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../apps/desktop/Services/UiLocalization.cs" Link="Services/UiLocalization.cs" />
    <Compile Include="../../apps/shared/Memory*.cs" Link="Contracts/%(Filename)%(Extension)" />
    <Content Include="../../apps/desktop/Assets/AppIcon.ico" Link="Assets/AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
