<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../apps/desktop/Models/UI/AppearancePalette.cs" Link="AppearancePalette.cs" />
    <Compile Include="../../apps/desktop/Services/Presentation/AppearanceService.cs" Link="AppearanceService.cs" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <Compile Include="../../apps/desktop/Views/RetrievalSettingsWindow*.cs" Link="Views/%(Filename)%(Extension)" />
    <Compile Include="../../apps/desktop/Services/Data/RetrievalApiClient.cs" Link="Services/RetrievalApiClient.cs" />
    <Compile Include="../../apps/desktop/Services/Integration/GatewayResponseReader.cs" Link="Services/GatewayResponseReader.cs" />
    <Compile Include="../../apps/desktop/Services/Integration/GatewayApiException.cs" Link="Services/GatewayApiException.cs" />
    <Compile Include="../../apps/desktop/Services/Presentation/UiText*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../apps/desktop/Services/Presentation/UiLocalization.cs" Link="Services/UiLocalization.cs" />
    <Compile Include="../../apps/shared/Memory/*.cs" Link="Contracts/%(Filename)%(Extension)" />
    <Compile Include="../memory-ui-smoke/NativeUi.cs" Link="NativeUi.cs" />
    <Compile Include="../memory-ui-smoke/NativeWindowCapture.cs" Link="NativeWindowCapture.cs" />
    <Page Include="../../apps/desktop/Styles/*.xaml" Link="Styles/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
