<Page x:Class="KYNXA_Desktop.Views.ShellPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:KYNXA_Desktop.ViewModels">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
 <Grid x:Name="ProjectsHeader" Height="36"><Button x:Name="AddProjectButton" Content="+" HorizontalAlignment="Right" /></Grid>
 <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{x:Bind Entries}" SelectionMode="None"
           CanDragItems="False" CanReorderItems="False" Collapsed="ProjectTree_Collapsed" Expanding="ProjectTree_Expanding">
  <TreeView.ItemTemplate><DataTemplate x:DataType="vm:ProjectTreeEntry">
   <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                 AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
    <Grid Height="40" Tag="{x:Bind}" PointerEntered="ProjectRow_PointerEntered" PointerExited="ProjectRow_PointerExited"
          GotFocus="ProjectRow_GotFocus" LostFocus="ProjectRow_LostFocus" Loaded="ProjectRow_OrderLoaded" Unloaded="ProjectRow_OrderUnloaded">
     <Border x:Name="ActiveBackground" Background="#FFE9E9E9" CornerRadius="8"
             Visibility="{x:Bind ActiveVisibility, Mode=OneWay}" />
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
      <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Visibility="{x:Bind ProjectOnlyVisibility}" />
      <TextBlock x:Name="RowTitle" Text="{x:Bind Title, Mode=OneWay}" FontSize="14" />
      <FontIcon x:Name="ReplyingIndicator" Glyph="&#xE9F3;" FontSize="10"
                Visibility="{x:Bind ReplyingVisibility, Mode=OneWay}" />
     </StackPanel>
    </Grid>
   </TreeViewItem>
  </DataTemplate></TreeView.ItemTemplate>
 </TreeView></Grid>
</Page>
