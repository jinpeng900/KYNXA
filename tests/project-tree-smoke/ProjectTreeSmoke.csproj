    <Compile Include="../../apps/desktop/Models/UI/ChatMessageState.cs" Link="ChatMessageState.cs" />
    <Compile Include="../../apps/desktop/ViewModels/ProjectTreeEntry.cs" Link="ProjectTreeEntry.cs" />
    <Compile Include="../../apps/desktop/ViewModels/ProjectTreeReconciler.cs" Link="ProjectTreeReconciler.cs" />
    <Compile Include="../../apps/desktop/Views/ShellPage.ProjectRendering.cs" Link="ShellPage.ProjectRendering.cs" />
    <Compile Include="../../apps/desktop/Views/ShellPage.ProjectHover.cs" Link="ShellPage.ProjectHover.cs" />
    <Compile Include="../../apps/desktop/Views/ShellPage.ProjectOrdering.cs" Link="ShellPage.ProjectOrdering.cs" />
    <Compile Include="../../apps/desktop/Services/ProjectOrdering.cs" Link="ProjectOrdering.cs" />
  </ItemGroup>
</Project>
